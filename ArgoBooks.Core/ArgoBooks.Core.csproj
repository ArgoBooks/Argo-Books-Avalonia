<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Windows-specific settings for Windows Hello WinRT APIs -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <UseWindowsForms>false</UseWindowsForms>
        <UseWPF>false</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ArgoBooks.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- CRA payroll rate tables, one file per edition. Embedded so a fresh install can
             calculate offline; PayrollRateService prefers a newer copy from the cache
             directory, so a rate change can be delivered without a release. -->
        <EmbeddedResource Include="Resources\Payroll\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- Note: System.Text.Json and System.Formats.Tar are built into .NET 7+ -->

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" />

        <!-- Graphics (for report rendering) -->
        <PackageReference Include="SkiaSharp" />

        <!-- Charts (headless SKGeoMap rendering for reports) -->
        <PackageReference Include="LiveChartsCore.SkiaSharpView" />

        <!-- PDF -->
        <PackageReference Include="QuestPDF" />
        <!-- Excel -->
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="EPPlus" />
        <!-- Pin EPPlus's transitive ImageSharp to a patched version (CVE-2025-54575 GIF DoS) -->
        <PackageReference Include="SixLabors.ImageSharp" />
        <!-- Legacy .xls (BIFF) reading; converted to .xlsx at the import entry point -->
        <PackageReference Include="NPOI" />

        <!-- Machine Learning (for local forecasting) -->
        <PackageReference Include="Microsoft.ML" />
        <PackageReference Include="Microsoft.ML.TimeSeries" />

        <!-- CSV parsing (RFC 4180) -->
        <PackageReference Include="CsvHelper" />

        <!-- Not referenced by our code. EPPlus and NPOI both depend on
             System.Security.Cryptography.Xml at a version carrying known high-severity
             advisories, so this pins the resolved version forward to a patched one.
             Must stay outside any TargetFramework condition, or the non-Windows target
             silently falls back to the vulnerable version. Drop it once both packages
             depend on a patched version themselves. -->
        <PackageReference Include="System.Security.Cryptography.Xml" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ArgoBooks.Shared\ArgoBooks.Shared.csproj" />
    </ItemGroup>

    <!-- Windows-specific packages -->
</Project>

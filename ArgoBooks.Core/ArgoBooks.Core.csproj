<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- NPOI 2.8 asks for a maintenance fee from users earning US$10,000 a year or more, and warns on every build until the agreement is accepted. -->
        <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    </PropertyGroup>

    <!-- Windows-specific settings for Windows Hello WinRT APIs -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <UseWindowsForms>false</UseWindowsForms>
        <UseWPF>false</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ArgoBooks.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The CRA rate files are built in so a fresh install works offline, and the app uses a newer downloaded copy when it has one. -->
        <EmbeddedResource Include="Resources\Payroll\*.json" />
        <EmbeddedResource Include="Resources\Assets\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" />

        <!-- Graphics (for report rendering) -->
        <PackageReference Include="SkiaSharp" />

        <!-- Charts (headless SKGeoMap rendering for reports) -->
        <PackageReference Include="LiveChartsCore.SkiaSharpView" />

        <!-- PDF -->
        <PackageReference Include="QuestPDF" />
        <!-- TIFF receipts from office scanners, converted to JPEG or PDF when added -->
        <PackageReference Include="BitMiracle.LibTiff.NET" />
        <!-- Excel -->
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="EPPlus" />
        <!-- Legacy .xls (BIFF) reading; converted to .xlsx at the import entry point -->
        <PackageReference Include="NPOI" />

        <!-- Machine Learning (for local forecasting) -->
        <PackageReference Include="Microsoft.ML" />
        <PackageReference Include="Microsoft.ML.TimeSeries" />

        <!-- CSV parsing (RFC 4180) -->
        <PackageReference Include="CsvHelper" />

        <!-- Ed25519, to check the signature on every update before it is installed -->
        <PackageReference Include="BouncyCastle.Cryptography" />

        <!-- EPPlus and NPOI ask for a version with known high-severity advisories, so this pulls in a patched one for every target framework. -->
        <PackageReference Include="System.Security.Cryptography.Xml" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ArgoBooks.Shared\ArgoBooks.Shared.csproj" />
    </ItemGroup>

    <!-- Windows-specific packages -->
</Project>

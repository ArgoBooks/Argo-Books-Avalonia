<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <SelfContained>true</SelfContained>

        <!-- Precompile IL to native at publish time. Without it the runtime JIT-compiles the
             whole dependency graph (Avalonia, Skia, LiveCharts, ML, EPPlus, NPOI, QuestPDF)
             on every cold start. Measured on an 11th-gen i7: 6.5s to first window without,
             ~3.7s with. Costs roughly 100MB of output.

             This only applies to `dotnet publish`, NOT to a plain build, so the Windows
             installer has to be produced from a publish output. See docs/Publishing.md. -->
        <PublishReadyToRun>true</PublishReadyToRun>

        <!-- Without this the exe carries no icon, so Explorer and a pinned but unlaunched
             taskbar entry fall back to the generic one. -->
        <ApplicationIcon>..\ArgoBooks\Assets\argo-logo.ico</ApplicationIcon>

        <AssemblyName>Argo Books</AssemblyName>
        <Title>Argo Books</Title>
        <Product>Argo Books</Product>
        <Description>Argo Books Desktop App</Description>
    </PropertyGroup>

    <!-- Windows-specific settings for WinRT APIs -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />

        <!-- Auto-Update -->
        <PackageReference Include="NetSparkleUpdater.UI.Avalonia" />

        <!-- Pin transitive dep to patched version (GHSA-xrw6-gwf8-vvr9) -->
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ArgoBooks\ArgoBooks.csproj" />
    </ItemGroup>

    <!-- SkiaSharp and HarfBuzzSharp ship native debug symbols as package content, and they
         are copied into the publish output: 80MB and 20MB of a 512MB folder. They are
         native PDBs, readable only by a native debugger, so nothing in the app can use
         them. The managed ones are kept: ErrorLogger reads GetFileLineNumber() off a live
         stack trace, which needs them present at runtime. -->
    <Target Name="RemoveNativeSymbols" AfterTargets="Publish">
        <ItemGroup>
            <NativeSymbolsToRemove Include="$(PublishDir)libSkiaSharp.pdb" />
            <NativeSymbolsToRemove Include="$(PublishDir)libHarfBuzzSharp.pdb" />
        </ItemGroup>
        <Delete Files="@(NativeSymbolsToRemove)" />
    </Target>
</Project>

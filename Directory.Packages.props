<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />

    <!-- Android head -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- Moves in lockstep with Xamarin.AndroidX.Core, or both .aar's ship the same generated Kotlin class and D8/R8 fails at dex time with a duplicate class. -->
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    <!-- SecureStorage and Preferences for the Android head. -->
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.80" />
    <PackageVersion Include="Net.Google.MLKit.DocumentScanner" Version="16.1.0" />
    <!-- Plain Android bindings, so they coexist with Avalonia: a binding that needs Microsoft.Maui.dll cannot. -->
    <PackageVersion Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.8" />
    <PackageVersion Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.16" />
    <PackageVersion Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
    <!-- Forced onto the newer line because the doc scanner holds Common.Jvm below 2.10.1 while Xamarin.AndroidX.Core needs 2.11.0.1, which is an NU1107 conflict. -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Jvm" Version="2.11.0.1" />

    <!-- Must match what Avalonia.FreeDesktop was compiled against or the connection fails to bind at runtime. Recheck on every upgrade. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />

    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DPAPI, for credential storage on Windows. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />

    <!-- The Avalonia 12 preview, because the stable line is built against Avalonia 11 and crashes when a chart control is constructed. -->
    <PackageVersion Include="LiveChartsCore.SkiaSharpView" Version="2.0.1-av12.1" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.1-av12.1" />
    <!-- The first-party picker, because PixiEditor's is built against Avalonia 11 and throws MissingMethodException on 12. -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- HEIC decoding, which Skia does not do on Windows or Linux and which every photo off an iPhone needs. The Runtime package bundles one library where the per-rid ones ship untrimmable aom and x265 beside it, costing 15 MB. -->
    <PackageVersion Include="LibHeifSharp" Version="3.2.0" />
    <PackageVersion Include="LibHeif.Native.Runtime" Version="1.20.2" />
    <!-- TIFF decoding for receipts from office scanners, which Skia does not read. Fully managed, so it needs no native library on any platform. -->
    <PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />

    <PackageVersion Include="QuestPDF" Version="2026.2.4" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="EPPlus" Version="8.5.4" />
    <!-- Legacy .xls (BIFF) reading, converted to .xlsx at the import entry point. -->
    <PackageVersion Include="NPOI" Version="2.8.1" />

    <!-- Installs and updates the desktop app on Windows, macOS and Linux. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Ed25519, to check the signature on every update before it is installed. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Forecasting, which runs on the machine rather than a service. -->
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.TimeSeries" Version="5.0.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
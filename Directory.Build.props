<Project>
    <PropertyGroup>
        <!-- Application Version, for all projects -->
        <Version>2.0.15</Version>
        <AssemblyVersion>2.0.15</AssemblyVersion>
        <FileVersion>2.0.15</FileVersion>
        <!-- Strip the +commit-hash suffix that .NET 8+ otherwise appends to
             AssemblyInformationalVersionAttribute. NetSparkle reads the informational
             version when comparing against the appcast and would otherwise log a
             spurious "update needed from 2.0.6+hash to 2.0.6" on every check. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- Allow restoring/evaluating the net10.0-windows target framework on
             Linux/macOS (e.g. the GitHub Actions AppImage build). Only the
             net10.0 flavor is actually built there; this just lets restore
             resolve the Windows reference packs instead of failing NETSDK1100. -->
        <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    </PropertyGroup>
</Project>

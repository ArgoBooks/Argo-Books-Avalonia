<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArgoBooks.Controls.ModalOverlay"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Panel>
        <!-- An open modal holds focus here so its keys reach it, and it is no tab stop itself so Tab never outlines the whole modal. -->
        <Panel x:Name="OverlayPanel"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               IsVisible="False"
               Focusable="True"
               KeyboardNavigation.IsTabStop="False">

            <!-- Semi-transparent backdrop -->
            <Border Background="{DynamicResource OverlayBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="OnBackdropPointerPressed" />

            <!-- Modal content container - stretches to fill, content controls its own alignment.
                 The margin is the one gap every modal keeps from the window edges. -->
            <ContentPresenter x:Name="ModalContentPresenter"
                              Margin="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
        </Panel>
    </Panel>
</UserControl>

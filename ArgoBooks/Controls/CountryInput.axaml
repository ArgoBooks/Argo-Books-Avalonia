<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:icons="using:ArgoBooks"
             xmlns:converters="using:ArgoBooks.Converters"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="ArgoBooks.Controls.CountryInput"
             x:DataType="controls:CountryInput"
             x:Name="Root"
             Focusable="True">

    <UserControl.Resources>
        <converters:HighlightBrushMultiConverter x:Key="HighlightBrushMultiConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Country Dropdown -->
        <Border x:Name="CountryDropdownBorder"
                CornerRadius="6"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Classes.focused="{Binding #Root.IsDropdownOpen}">
            <Border.Styles>
                <Style Selector="Border.focused">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Style>
                <Style Selector="Border:pointerover:not(.focused)">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Flag Image -->
                <Image Grid.Column="0"
                       Source="{Binding #Root.SelectedCountryFlag}"
                       Width="20" Height="14"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       IsVisible="{Binding #Root.SelectedCountryFlag, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Search/Display TextBox -->
                <TextBox x:Name="CountrySearchBox"
                         Grid.Column="1"
                         Text="{Binding #Root.SearchText, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc 'Select country'}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,10"
                         FontSize="14"
                         VerticalAlignment="Center"
                         MaxLength="100" />

                <!-- Dropdown Arrow -->
                <Button Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        Margin="0,0,8,0"
                        Padding="0"
                        CornerRadius="4"
                        Cursor="Hand"
                        Command="{Binding #Root.ToggleDropdownCommand}">
                    <PathIcon Data="{x:Static icons:Icons.ChevronDownSmall}"
                              Width="12" Height="12"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Country Dropdown Popup -->
        <Popup x:Name="CountryDropdownPopup"
               IsOpen="{Binding #Root.IsDropdownOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #CountryDropdownBorder}"
               Placement="Bottom"
               PlacementGravity="BottomLeft"
               IsLightDismissEnabled="True"
               WindowManagerAddShadowHint="False">

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="280"
                    MaxHeight="300"
                    Margin="0,4,0,0"
                    BoxShadow="0 4 12 0 #20000000">

                <Grid RowDefinitions="Auto,*">
                    <!-- No Results Message -->
                    <TextBlock Grid.Row="0"
                               Text="{loc:Loc 'No countries found'}"
                               FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Padding="12,16"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !#Root.HasFilteredCountries}" />

                    <!-- Filtered Items -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding #Root.HasFilteredCountries}">
                        <ItemsControl x:Name="CountryListBox"
                                      ItemsSource="{Binding #Root.FilteredCountries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="controls:CountryDialCode">
                                    <Button BorderThickness="0"
                                            Padding="10,8"
                                            Cursor="Hand"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding #Root.SelectCountryCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Background>
                                            <MultiBinding Converter="{StaticResource HighlightBrushMultiConverter}">
                                                <Binding Path="." />
                                                <Binding Path="#Root.HighlightedCountry" />
                                            </MultiBinding>
                                        </Button.Background>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel>
                                            <Grid ColumnDefinitions="30,*">
                                                <!-- Flag Image -->
                                                <Image Grid.Column="0"
                                                       Source="{Binding FlagImage}"
                                                       Width="20" Height="14"
                                                       Stretch="UniformToFill"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                                <!-- Country Name -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <!-- Separator after priority countries -->
                                            <Border Height="1"
                                                    Background="{DynamicResource BorderBrush}"
                                                    Margin="-10,8,-10,0"
                                                    IsVisible="{Binding ShowSeparatorAfter}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>

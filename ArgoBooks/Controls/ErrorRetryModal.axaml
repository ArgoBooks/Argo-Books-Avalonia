<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="ArgoBooks.Controls.ErrorRetryModal"
             x:DataType="controls:ErrorRetryModal"
             x:Name="Root">

    <controls:ModalOverlay x:Name="Overlay"
                           IsOpen="{Binding #Root.IsOpen}"
                           ClosingCommand="{Binding #Root.DismissCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel Margin="24" Spacing="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="16"
                                IsVisible="{Binding #Root.ShowBusyPanel, Converter={x:Static BoolConverters.Not}}">
                        <Border Background="{DynamicResource ErrorLightBrush}"
                                CornerRadius="50"
                                Width="64" Height="64"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{x:Static icons:Icons.WarningCircle}"
                                      Width="32" Height="32"
                                      Foreground="{DynamicResource ErrorBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding #Root.Title}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding #Root.Message}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Spacing="16"
                                IsVisible="{Binding #Root.ShowBusyPanel}">
                        <controls:LoadingSpinner IsSpinning="{Binding #Root.ShowBusyPanel}"
                                                 SizePreset="Large"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding #Root.BusyTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding #Root.BusyMessage}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button Classes="secondary-button"
                                Content="{loc:Loc 'Cancel'}"
                                Command="{Binding #Root.DismissCommand}"
                                IsEnabled="{Binding #Root.IsBusy, Converter={x:Static BoolConverters.Not}}" />
                        <Button Classes="primary-button"
                                Command="{Binding #Root.RetryCommand}"
                                IsEnabled="{Binding #Root.IsBusy, Converter={x:Static BoolConverters.Not}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{x:Static icons:Icons.RefreshAlt}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding #Root.IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                <PathIcon Data="{x:Static icons:Icons.Spinner}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding #Root.ShowButtonSpinner}" />
                                <TextBlock Text="{loc:Loc 'Retry'}"
                                           IsVisible="{Binding #Root.IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                <TextBlock Text="{loc:Loc 'Retrying...'}"
                                           IsVisible="{Binding #Root.IsBusy}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
</UserControl>

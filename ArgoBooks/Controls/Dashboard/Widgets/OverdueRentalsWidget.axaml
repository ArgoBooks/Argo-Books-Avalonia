<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArgoBooks.ViewModels.Dashboard"
             xmlns:icons="using:ArgoBooks"
             xmlns:loc="using:ArgoBooks.Localization"
             x:Class="ArgoBooks.Controls.Dashboard.Widgets.OverdueRentalsWidget"
             x:DataType="vm:OverdueRentalsWidgetViewModel">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="20,16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{loc:Loc 'Overdue Rentals'}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <!-- Table Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="400"
                          IsVisible="{Binding HasRentals}">
                <ItemsControl ItemsSource="{Binding Rentals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OverdueRentalItem">
                            <Border Classes="table-row">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <!-- Danger Icon -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="8"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource DangerIconBgBrush}">
                                        <PathIcon Data="{x:Static icons:Icons.Warning}"
                                                  Width="18" Height="18"
                                                  Foreground="{DynamicResource DangerBrush}" />
                                    </Border>

                                    <!-- Item & Customer -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding ItemName}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CustomerName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Due Date -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DueDate}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0" />

                                    <!-- Days Overdue -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DaysOverdue}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{loc:Loc 'days'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <Border Grid.Row="1"
                    Padding="40"
                    IsVisible="{Binding HasNoRentals}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <PathIcon Data="{x:Static icons:Icons.CircleCheck}"
                              Width="48" Height="48"
                              Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="{loc:Loc 'No overdue rentals'}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArgoBooks.ViewModels.Dashboard"
             xmlns:icons="using:ArgoBooks"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:loc="using:ArgoBooks.Localization"
             x:Class="ArgoBooks.Controls.Dashboard.WidgetCatalogPanel"
             x:DataType="vm:WidgetCatalogViewModel"
             IsVisible="{Binding IsOpen, FallbackValue=False}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Styles>
        <Style Selector="Button.catalog-item-btn">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.catalog-item-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.catalog-item-btn.already-added">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.catalog-item-btn.cannot-fit">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- TabControl styling (matches SettingsModal) -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl /template/ Border#PART_InnerBorder">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="4,12,4,10" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Height" Value="2" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Semi-transparent backdrop -->
        <Border Background="{DynamicResource OverlayBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered modal panel -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}"
                Width="640"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 0 #40000000">

            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        Padding="24,20"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc 'Add Widget'}"
                                   FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="icon"
                                Width="32" Height="32"
                                VerticalAlignment="Top"
                                Command="{Binding CloseCommand}"
                                ToolTip.Tip="{loc:Loc Close}">
                            <PathIcon Data="{x:Static icons:Icons.Close}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Row is full banner -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource WarningLightBrush}"
                        Padding="24,10"
                        IsVisible="{Binding IsRowFull}">
                    <TextBlock Text="{loc:Loc 'This row is full. Remove a widget or add a new row.'}"
                               FontSize="12"
                               Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </Border>

                <!-- Tabbed content -->
                <TabControl Margin="0,0,0,8" MinHeight="400">
                    <TabItem Header="{loc:Loc 'Stat Cards'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding StatCards}" Margin="20,8,20,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogItem">
                                        <Button Classes="catalog-item-btn"
                                                Classes.already-added="{Binding IsAlreadyAdded}"
                                                Classes.cannot-fit="{Binding CannotFitInRow}"
                                                Command="{Binding $parent[UserControl].((vm:WidgetCatalogViewModel)DataContext).AddWidgetCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="{Binding Definition.Icon}"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Definition.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Definition.Description}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Added'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding IsAlreadyAdded}" />
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Won','t fit'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding ShowWontFit}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc 'Charts'}">
                      <Grid RowDefinitions="Auto,Auto,*">
                        <!-- The search box the tables use: an icon, the input, and a clear button once there is text. -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Margin="20,8,20,0"
                                MinHeight="34"
                                behaviors:FocusOnClickBehavior.FocusTextBoxOnClick="True">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0"
                                          Data="{x:Static icons:Icons.Search}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Margin="10,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Classes="search-input"
                                         Text="{Binding ChartSearch, Mode=TwoWay}"
                                         PlaceholderText="{loc:Loc 'Search charts...'}"
                                         VerticalAlignment="Center"
                                         MaxLength="100" />
                                <Button Grid.Column="2"
                                        Classes="icon"
                                        Width="24" Height="24"
                                        Margin="0,0,8,0"
                                        IsVisible="{Binding ChartSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding ClearChartSearchCommand}"
                                        ToolTip.Tip="{loc:Loc Clear}">
                                    <PathIcon Data="{x:Static icons:Icons.Close}"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Loc 'No charts match that search.'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="20,16,20,0"
                                   IsVisible="{Binding NoChartMatches}" />

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="360">
                            <ItemsControl ItemsSource="{Binding Charts}" Margin="20,8,20,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogItem">
                                        <Button Classes="catalog-item-btn"
                                                Classes.already-added="{Binding IsAlreadyAdded}"
                                                Classes.cannot-fit="{Binding CannotFitInRow}"
                                                Command="{Binding $parent[UserControl].((vm:WidgetCatalogViewModel)DataContext).AddWidgetCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="{Binding Definition.Icon}"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Definition.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Definition.Description}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Added'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding IsAlreadyAdded}" />
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Won','t fit'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding ShowWontFit}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                      </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Loc 'Tables'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding Tables}" Margin="20,8,20,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogItem">
                                        <Button Classes="catalog-item-btn"
                                                Classes.already-added="{Binding IsAlreadyAdded}"
                                                Classes.cannot-fit="{Binding CannotFitInRow}"
                                                Command="{Binding $parent[UserControl].((vm:WidgetCatalogViewModel)DataContext).AddWidgetCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="{Binding Definition.Icon}"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Definition.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Definition.Description}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Added'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding IsAlreadyAdded}" />
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Won','t fit'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding ShowWontFit}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc 'Other'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="400">
                            <ItemsControl ItemsSource="{Binding Other}" Margin="20,8,20,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogItem">
                                        <Button Classes="catalog-item-btn"
                                                Classes.already-added="{Binding IsAlreadyAdded}"
                                                Classes.cannot-fit="{Binding CannotFitInRow}"
                                                Command="{Binding $parent[UserControl].((vm:WidgetCatalogViewModel)DataContext).AddWidgetCommand}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                          Data="{Binding Definition.Icon}"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Definition.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Definition.Description}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Added'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding IsAlreadyAdded}" />
                                                <TextBlock Grid.Column="2" Text="{loc:Loc 'Won','t fit'}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           IsVisible="{Binding ShowWontFit}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="ArgoBooks.Controls.CategoryInput"
             x:DataType="controls:CategoryInput"
             x:Name="Root">

    <controls:SearchableDropdown ItemsSource="{Binding #Root.Categories}"
                                 SelectedItem="{Binding #Root.SelectedCategory, Mode=TwoWay}"
                                 SearchText="{Binding #Root.SearchText, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 EnterSelectsBestMatch="True"
                                 Placeholder="{loc:Loc 'Search categories...'}"
                                 ShowAddNew="{Binding #Root.OpenCategoriesPageCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 AddNewText="{loc:Loc 'Create new category'}"
                                 AddNewCommand="{Binding #Root.OpenCategoriesPageCommand}"
                                 EmptyMessage="{loc:Loc 'No categories.'}"
                                 EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                 EmptyCreateCommand="{Binding #Root.OpenCategoriesPageCommand}" />

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="60"
             x:Class="ArgoBooks.Controls.PhoneInput"
             x:DataType="controls:PhoneInput"
             x:Name="Root"
             Focusable="True">

    <Grid ColumnDefinitions="Auto,8,*">
        <!-- Fixed width so typing a search doesn't push the number box around -->
        <controls:SearchableDropdown x:Name="CountryDropdown"
                                     Grid.Column="0"
                                     Width="130"
                                     VerticalAlignment="Center"
                                     ItemsSource="{Binding #Root.OtherCountries}"
                                     PriorityItems="{Binding #Root.PriorityCountries}"
                                     DisplayMemberPath="DisplayName"
                                     SelectedDisplayMemberPath="DialCode"
                                     SearchMemberPath="Code"
                                     ImageMemberPath="FlagImage"
                                     EnterSelectsBestMatch="True"
                                     SelectedItem="{Binding #Root.SelectedCountry, Mode=TwoWay}"
                                     Placeholder="+1"
                                     ShowAddNew="False" />

        <!-- Phone Number TextBox with auto-formatting -->
        <TextBox Grid.Column="2"
                 x:Name="PhoneNumberBox"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 CornerRadius="6"
                 Padding="12,10"
                 FontSize="14"
                 MaxLength="20" />
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:local="using:ArgoBooks"
             xmlns:conv="using:ArgoBooks.Converters"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:Class="ArgoBooks.Controls.SetupChecklist"
             x:DataType="vm:SetupChecklistViewModel"
             IsVisible="{Binding IsVisible}">

    <Design.DataContext>
        <vm:SetupChecklistViewModel />
    </Design.DataContext>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="2"
            CornerRadius="12"
            Margin="0,0,0,24"
            BoxShadow="0 0 20 0 #4040A0FF">

        <Grid RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="20,16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Title and Progress -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Getting Started"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Dismiss Button -->
                    <Button Grid.Column="1"
                            Classes="icon-button-small"
                            Command="{Binding DismissChecklistCommand}"
                            ToolTip.Tip="Dismiss checklist">
                        <PathIcon Data="{x:Static local:Icons.Close}"
                                  Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Border Grid.Row="1">
                <StackPanel>
                    <!-- Checklist Items -->
                    <ItemsControl ItemsSource="{Binding Items}"
                                  IsVisible="{Binding !IsAllCompleted}"
                                  Padding="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                <Button Classes="checklist-item"
                                        Command="{Binding $parent[ItemsControl].((vm:SetupChecklistViewModel)DataContext).NavigateToItemCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsCurrentItem}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Checkbox/Check Icon -->
                                        <Border Grid.Column="0"
                                                Classes="checklist-circle"
                                                Width="24" Height="24"
                                                CornerRadius="12"
                                                Margin="0,0,12,0"
                                                BorderThickness="{Binding IsCompleted, Converter={x:Static conv:BoolConverters.ToCircleBorderThickness}}"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <Border.Background>
                                                <Binding Path="IsCompleted">
                                                    <Binding.Converter>
                                                        <conv:BoolToBrushConverter TrueValue="{DynamicResource PrimaryBrush}"
                                                                                    FalseValue="Transparent" />
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Background>
                                            <Panel>
                                                <!-- Checked: checkmark -->
                                                <PathIcon Data="{x:Static local:Icons.Check}"
                                                          Width="14" Height="14"
                                                          Foreground="White"
                                                          IsVisible="{Binding IsCompleted}" />
                                            </Panel>
                                        </Border>

                                        <!-- Title (with inline "Click here" pill on the active item) and Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <TextBlock.TextDecorations>
                                                        <Binding Path="IsCompleted">
                                                            <Binding.Converter>
                                                                <conv:BoolToTextDecorationConverter />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </TextBlock.TextDecorations>
                                                </TextBlock>

                                                <!-- Active item: accent-color "Click here" pill, inline with the title -->
                                                <Border IsVisible="{Binding IsCurrentItem}"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="12"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <PathIcon Data="{x:Static local:Icons.ArrowBack}"
                                                                  Width="12" Height="12"
                                                                  Foreground="White"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc 'Click here'}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       IsVisible="{Binding !IsCompleted}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- All Complete Message -->
                    <Border Padding="20"
                            IsVisible="{Binding IsAllCompleted}">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <!-- Success Icon and Message -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="48" Height="48"
                                        CornerRadius="24"
                                        Background="#E6F4EA"
                                        HorizontalAlignment="Center">
                                    <PathIcon Data="{x:Static local:Icons.Check}"
                                              Width="24" Height="24"
                                              Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <TextBlock Text="{loc:Loc 'Tutorial Complete!'}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'You’re ready to start tracking your business finances.'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </StackPanel>

                            <!-- Free Tier Info -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center"
                                        IsVisible="{Binding !HasPremium}">
                                <TextBlock Text="{Binding FreeTierSummary}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Upgrade for unlimited invoices, more AI receipt scans, and predictive analytics.'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <Button Classes="text-link"
                                        Command="{Binding OpenUpgradeUrlCommand}"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        Padding="0"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc 'View upgrade options →'}"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Classes="secondary"
                                    Command="{Binding DismissChecklistCommand}"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Padding="24,8">
                                <TextBlock Text="{loc:Loc 'Close'}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <UserControl.Styles>
        <Style Selector="Button.checklist-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.checklist-item /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.checklist-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.checklist-item:disabled">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.checklist-item:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Circle styling on hover -->
        <Style Selector="Button.checklist-item:pointerover Border.checklist-circle">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:table="using:ArgoBooks.Controls.ArgoTable"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:icons="using:ArgoBooks"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ArgoBooks.Controls.ArgoTable.ArgoTable"
             x:DataType="table:ArgoTable"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Filter button while filters are applied: tinted and outlined in the primary colour -->
        <Style Selector="Button.secondary-button.filtered">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary-button.filtered /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryIconBgBrush}" />
        </Style>
        <Style Selector="Button.secondary-button.filtered:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryIconBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
        </Style>
        <Style Selector="Border.filter-count">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.filter-count TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SizeChanged="OnBorderSizeChanged">

        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header with Title, Search and Buttons -->
            <Border Grid.Row="0"
                    Padding="{Binding #Root.HeaderPadding}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{Binding #Root.ShowHeaderBorder, Converter={x:Static local:BoolConverters.ToHeaderBorderThickness}}"
                    IsVisible="{Binding #Root.ShowHeader}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Title -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding #Root.Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding #Root.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Page-supplied status, sitting just left of the search box. The middle
                         column was already here and empty. -->
                    <ContentPresenter Grid.Column="1"
                                      Content="{Binding #Root.HeaderInfoContent}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="16,0" />

                    <!-- Search + Filter + Add Button (Right aligned) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="{Binding #Root.HeaderSpacing}">
                        <!-- Search Box -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="6"
                                Width="{Binding #Root.SearchBoxWidth}"
                                MinHeight="{Binding #Root.SearchBoxMinHeight}"
                                IsVisible="{Binding #Root.ShowSearch}"
                                behaviors:FocusOnClickBehavior.FocusTextBoxOnClick="True">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0"
                                          Data="{x:Static icons:Icons.Search}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Margin="{Binding #Root.SearchIconMargin}" />
                                <TextBox Grid.Column="1"
                                         x:Name="SearchInput"
                                         Text="{Binding #Root.SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="{Binding #Root.SearchPlaceholder}"
                                         Classes="search-input"
                                         VerticalAlignment="Center"
                                         MaxLength="100" />
                                <Button Grid.Column="2"
                                        Classes="icon-button"
                                        Width="24" Height="24"
                                        Margin="0,0,8,0"
                                        IsVisible="{Binding #Root.SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding #Root.ClearSearchCommand}"
                                        ToolTip.Tip="{loc:Loc Clear}">
                                    <PathIcon Data="{x:Static icons:Icons.Close}"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Filter Button: highlighted, with the number of filters, while any are applied -->
                        <Button Classes="secondary-button"
                                Classes.compact="{Binding #Root.IsCompactMode}"
                                Classes.medium="{Binding #Root.IsMediumMode}"
                                Classes.filtered="{Binding #Root.FilterCount, Converter={x:Static local:IntConverters.IsPositive}}"
                                IsVisible="{Binding #Root.ShowFilterButton}"
                                Command="{Binding #Root.FilterCommand}"
                                ToolTip.Tip="{loc:Loc 'Filter'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Filter}"
                                          Width="16" Height="16" />
                                <TextBlock Text="{loc:Loc Filter}" IsVisible="{Binding #Root.ShowButtonText}" />
                                <Border Classes="filter-count"
                                        IsVisible="{Binding #Root.FilterCount, Converter={x:Static local:IntConverters.IsPositive}}">
                                    <TextBlock Text="{Binding #Root.FilterCount}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Clear the applied filters without opening the modal -->
                        <Button Classes="icon-button"
                                Width="28" Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding #Root.ClearFiltersCommand}"
                                ToolTip.Tip="{loc:Loc 'Clear filters'}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="#Root.ShowFilterButton" />
                                    <Binding Path="#Root.FilterCount" Converter="{x:Static local:IntConverters.IsPositive}" />
                                    <Binding Path="#Root.ClearFiltersCommand" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <PathIcon Data="{x:Static icons:Icons.Close}"
                                      Width="12" Height="12"
                                      Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Button>

                        <!-- Extra Buttons Content (slot for additional buttons) -->
                        <ContentPresenter Content="{Binding #Root.ExtraButtonsContent}">
                            <ContentPresenter.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="#Root.ExtraButtonsContent" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    <Binding Path="#Root.ShowExtraButtons" />
                                </MultiBinding>
                            </ContentPresenter.IsVisible>
                        </ContentPresenter>

                        <!-- Add Button -->
                        <Button Classes="primary-button"
                                Classes.compact="{Binding #Root.IsCompactMode}"
                                Classes.medium="{Binding #Root.IsMediumMode}"
                                IsVisible="{Binding #Root.ShowAddButton}"
                                IsEnabled="{Binding #Root.IsAddButtonEnabled}"
                                Command="{Binding #Root.AddCommand}"
                                ToolTip.Tip="{Binding #Root.AddButtonTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Add}"
                                          Width="16" Height="16"
                                          Foreground="White" />
                                <TextBlock Text="{Binding #Root.AddButtonText}" IsVisible="{Binding #Root.ShowButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Optional Info Banner -->
            <ContentPresenter Grid.Row="1"
                              Content="{Binding #Root.InfoBannerContent}"
                              IsVisible="{Binding #Root.InfoBannerContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- Table Content -->
            <ScrollViewer Grid.Row="2"
                          x:Name="HorizontalTableScroll"
                          HorizontalScrollBarVisibility="{Binding #Root.NeedsHorizontalScroll, Converter={x:Static local:BoolConverters.ToScrollBarVisibility}}"
                          VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,*" x:Name="TableGrid"
                      MinWidth="{Binding #Root.MinimumTotalWidth}"
                      SizeChanged="OnTableGridSizeChanged">
                    <!-- Table Header (content slot - provided by page) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Padding="24,0"
                            MinHeight="40"
                            IsVisible="{Binding #Root.ShowColumnHeaders}"
                            PointerPressed="OnTableHeaderPointerPressed">
                        <ContentPresenter Content="{Binding #Root.HeaderContent}" />
                    </Border>

                    <!-- Table Content - rows handle own vertical scrolling via VirtualizingStackPanel -->
                    <Panel Grid.Row="1">
                        <!-- Rows (content slot - provided by page) -->
                        <ContentPresenter Content="{Binding #Root.RowsContent}" />

                        <!-- Empty State -->
                        <Border Padding="40"
                                IsVisible="{Binding #Root.IsEmpty}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="16">
                                <Border Width="64" Height="64"
                                        CornerRadius="32"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        HorizontalAlignment="Center">
                                    <PathIcon Data="{Binding #Root.EmptyIcon}"
                                              Width="28" Height="28"
                                              Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Border>
                                <!-- With filters applied the rows may exist but be hidden, so say so -->
                                <StackPanel Spacing="16"
                                            IsVisible="{Binding #Root.FilterCount, Converter={x:Static local:IntConverters.IsPositive}}">
                                    <TextBlock Text="{loc:Loc 'No results match your filters'}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc 'Clear the filters to see everything.'}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="300" />
                                    <Button Classes="secondary-button"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0"
                                            Command="{Binding #Root.ClearFiltersCommand}"
                                            IsVisible="{Binding #Root.ClearFiltersCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{loc:Loc 'Clear filters'}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding #Root.EmptyTitle}"
                                           FontSize="16"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding #Root.FilterCount, Converter={x:Static local:IntConverters.IsZero}}" />
                                <TextBlock Text="{Binding #Root.EmptyMessage}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="300"
                                           IsVisible="{Binding #Root.FilterCount, Converter={x:Static local:IntConverters.IsZero}}" />
                                <Button Classes="primary-button"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        Command="{Binding #Root.AddCommand}"
                                        IsEnabled="{Binding #Root.IsAddButtonEnabled}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="#Root.ShowAddButton" />
                                            <Binding Path="#Root.ShowEmptyAddButton" />
                                            <Binding Path="#Root.FilterCount" Converter="{x:Static local:IntConverters.IsZero}" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{x:Static icons:Icons.Add}"
                                                  Width="16" Height="16"
                                                  Foreground="White" />
                                        <TextBlock Text="{Binding #Root.AddButtonText}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Panel>
                </Grid>
            </ScrollViewer>

            <!-- Pagination Footer -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Padding="24,12"
                    CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    IsVisible="{Binding #Root.ShowPagination}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Rows per page selector -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding #Root.PaginationText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="|"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0" />
                        <TextBlock Text="{loc:Loc 'Rows per page:'}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding #Root.PageSizeOptions}"
                                  SelectedItem="{Binding #Root.PageSize, Mode=TwoWay}"
                                  Classes="page-size-combobox"
                                  Width="70" />
                    </StackPanel>

                    <!-- Page Numbers -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding #Root.ShowPageNumbers}">
                        <!-- Previous Button -->
                        <Button Classes="pagination-button"
                                Command="{Binding #Root.GoToPreviousPageCommand}"
                                IsEnabled="{Binding #Root.CanGoToPreviousPage}">
                            <PathIcon Data="{x:Static icons:Icons.ChevronLeft}"
                                      Width="16" Height="16" />
                        </Button>

                        <!-- Page Number Buttons -->
                        <ItemsControl ItemsSource="{Binding #Root.PageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="pagination-button"
                                            Content="{Binding}"
                                            Command="{Binding #Root.GoToPageCommand}"
                                            CommandParameter="{Binding}">
                                        <controls:PaginationHelper.IsActivePage>
                                            <MultiBinding Converter="{x:Static local:PageEqualsConverter.Instance}">
                                                <Binding />
                                                <Binding Path="#Root.CurrentPage" />
                                            </MultiBinding>
                                        </controls:PaginationHelper.IsActivePage>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Next Button -->
                        <Button Classes="pagination-button"
                                Command="{Binding #Root.GoToNextPageCommand}"
                                IsEnabled="{Binding #Root.CanGoToNextPage}">
                            <PathIcon Data="{x:Static icons:Icons.ChevronRightNav}"
                                      Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

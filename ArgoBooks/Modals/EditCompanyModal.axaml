<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ArgoBooks.ViewModels"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:modals="using:ArgoBooks.Modals"
             xmlns:local="using:ArgoBooks"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="500"
             x:Class="ArgoBooks.Modals.EditCompanyModal"
             x:DataType="vm:EditCompanyModalViewModel">

    <Panel>
    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding CloseCommand}">
        <controls:ModalOverlay.ModalContent>
            <!-- Modal -->
            <Border Classes="modal-card"
                Width="620"
                MaxHeight="750"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <controls:ModalHeader Grid.Row="0"
                                      Title="{loc:Loc 'Edit Company'}"
                                      Subtitle="{loc:Loc 'Update your company information'}"
                                      CloseCommand="{Binding CloseCommand}" />

                <!-- Body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Margin="24,16">
                        <!-- Company Name and Default Currency (side by side) -->
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Company Name'}" />
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding CompanyName, Mode=TwoWay}"
                                         PlaceholderText="{loc:Loc 'Enter company name'}"
                                         MaxLength="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Default Currency'}" />
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Currencies}"
                                         SelectedItem="{Binding SelectedCurrency}"
                                         Classes="form-combobox"
                                         PlaceholderText="{loc:Loc 'Select currency'}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Two column layout for fields -->
                        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto,16,Auto,16,Auto">
                            <!-- Business Type -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Loc 'Business Type'}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding BusinessTypes}"
                                          SelectedItem="{Binding BusinessType}"
                                          Classes="form-combobox"
                                          PlaceholderText="{loc:Loc 'Select business type'}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Industry -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                <TextBlock Text="{loc:Loc Industry}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding Industries}"
                                          SelectedItem="{Binding Industry}"
                                          Classes="form-combobox"
                                          PlaceholderText="{loc:Loc 'Select industry'}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Phone Number -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Loc 'Phone Number'}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:PhoneInput SelectedCountry="{Binding SelectedPhoneCountry, Mode=TwoWay}"
                                                     PhoneNumber="{Binding PhoneNumber, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding PhoneNumberError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding PhoneNumberError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                                <TextBlock Text="{loc:Loc Email}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Email, Mode=TwoWay}"
                                         PlaceholderText="{loc:Loc 'Enter email address'}"
                                         MaxLength="200" />
                            </StackPanel>

                            <!-- Country -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc Country}" />
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                </StackPanel>
                                <controls:CountryInput x:Name="CountryInput" SelectedCountryName="{Binding Country, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Province / State -->
                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="6">
                                <TextBlock Text="{Binding Country, Converter={x:Static controls:RegionInput.LabelConverter}}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:RegionInput Country="{Binding Country}" Value="{Binding ProvinceState, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- City -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Loc City}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding City, Mode=TwoWay}"
                                         PlaceholderText="{loc:Loc 'Enter city'}"
                                         MaxLength="100" />
                            </StackPanel>

                            <!-- Address -->
                            <StackPanel Grid.Row="6" Grid.Column="2" Spacing="6">
                                <TextBlock Text="{loc:Loc Address}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Address, Mode=TwoWay}"
                                         PlaceholderText="{loc:Loc 'Enter address'}"
                                         MaxLength="200" />
                            </StackPanel>

                            <!-- Company Logo -->
                            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                                <TextBlock Text="{loc:Loc 'Company Logo'}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Logo Preview -->
                                    <Border Grid.Column="0"
                                            Width="80" Height="80"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            Margin="0,0,12,0">
                                        <Panel>
                                            <PathIcon Data="{x:Static icons:Icons.GridDetailed}"
                                                      Width="32" Height="32"
                                                      Foreground="{DynamicResource TextTertiaryBrush}"
                                                      IsVisible="{Binding !HasLogo}" />
                                            <Image Source="{Binding LogoSource}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding HasLogo}" />
                                        </Panel>
                                    </Border>

                                    <!-- Upload Buttons -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <Button Classes="secondary-button"
                                                Command="{Binding BrowseLogoCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{x:Static local:Icons.ImportData}"
                                                          Width="16" Height="16" />
                                                <TextBlock Text="{loc:Loc 'Upload Logo'}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="text-button"
                                                Command="{Binding RemoveLogoCommand}"
                                                IsVisible="{Binding HasLogo}">
                                            <TextBlock Text="{loc:Loc Remove}" Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                        <TextBlock Text="{loc:Loc 'PNG, JPG up to 5MB'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Classes="modal-footer" Grid.Row="2">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="secondary-button"
                                Command="{Binding CloseCommand}"
                                Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc Cancel}" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="primary-button"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}">
                            <TextBlock Text="{loc:Loc 'Save Changes'}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>

    <!-- Currency Loading Modal (progress bar + cancel) -->
    <modals:CurrencyLoadingModal />

    <!-- Currency Error Modal -->
    <controls:ErrorRetryModal IsOpen="{Binding HasCurrencyError}"
                              Title="{loc:Loc 'Unable to Change Currency'}"
                              Message="{Binding CurrencyErrorMessage}"
                              IsBusy="{Binding IsSavingCurrency}"
                              BusyTitle="{loc:Loc 'Fetching Exchange Rates...'}"
                              BusyMessage="{loc:Loc 'Please wait while we connect to the exchange rate service.'}"
                              DismissCommand="{Binding DismissCurrencyErrorCommand}"
                              RetryCommand="{Binding RetryCurrencySaveCommand}"
                              AllowLightDismiss="False" />
    </Panel>
</UserControl>

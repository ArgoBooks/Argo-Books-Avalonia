<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:icons="using:ArgoBooks"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:entities="using:ArgoBooks.Core.Models.Entities"
             xmlns:tracking="using:ArgoBooks.Core.Models.Tracking"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
             x:Class="ArgoBooks.Modals.SettingsModal"
             x:DataType="vm:SettingsModalViewModel">

    <Design.DataContext>
        <vm:SettingsModalViewModel />
    </Design.DataContext>

    <Panel>
        <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                               ClosingCommand="{Binding CloseCommand}">
            <controls:ModalOverlay.ModalContent>
                <!-- Modal Container -->
                <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Width="840"
                MinHeight="750"
                MaxHeight="750"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="24,20"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Loc Settings}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Grid.Column="1"
                                Classes="icon-button"
                                Command="{Binding CloseCommand}">
                            <PathIcon Data="{x:Static icons:Icons.Close}"
                                      Width="20" Height="20" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Body with left navigation rail -->
                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            TabStripPlacement="Left"
                            Margin="0">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="12,16" />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <!-- General Tab -->
                    <TabItem Header="{loc:Loc General}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="20">
                                <!-- Language -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc Language}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:SearchableDropdown ItemsSource="{Binding Languages}"
                                                                  SelectedItem="{Binding SelectedLanguage}"
                                                                  PriorityItems="{Binding PriorityLanguages}"
                                                                  Placeholder="{loc:Loc 'Search languages...'}" />
                                </StackPanel>

                                <!-- Date Format -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Date Format'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding DateFormats}"
                                              SelectedItem="{Binding SelectedDateFormat}"
                                              Classes="form-combobox" />
                                </StackPanel>

                                <!-- Time Zone -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Time Zone'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:SearchableDropdown ItemsSource="{Binding AllTimeZones}"
                                                                  SelectedItem="{Binding SelectedTimeZone}"
                                                                  PriorityItems="{Binding PriorityTimeZones}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Placeholder="{loc:Loc 'Search timezones...'}" />
                                </StackPanel>

                                <!-- Time Format -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Time Format'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="6"
                                            Padding="4"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="12h"
                                                    Command="{Binding SelectTimeFormatCommand}"
                                                    CommandParameter="12h"
                                                    Classes="time-format-toggle"
                                                    Classes.selected="{Binding Is12HourFormat}" />
                                            <Button Content="24h"
                                                    Command="{Binding SelectTimeFormatCommand}"
                                                    CommandParameter="24h"
                                                    Classes="time-format-toggle"
                                                    Classes.selected="{Binding Is24HourFormat}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Chart Settings -->
                                <StackPanel Spacing="6" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc 'Max Pie Chart Slices'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ComboBox ItemsSource="{Binding MaxPieSlicesOptions}"
                                                  SelectedItem="{Binding MaxPieSlices}"
                                                  Classes="form-combobox"
                                                  Width="100" />
                                        <TextBlock Text="{loc:Loc 'Additional items will be grouped into ''Other'''}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Privacy Section. No group heading: it holds a single setting,
                                     and a heading over one row reads as a section that lost its rest. -->
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <Border Classes="settings-row last">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{loc:Loc 'Usage Data'}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc 'Argo Books collects usage data to help improve the app, including your company name, industry, country, currency and language.'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{loc:Loc 'Your transactions, customers, suppliers and documents are never sent.'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="secondary-button"
                                                        Content="{loc:Loc 'View Data'}"
                                                        Command="{Binding OpenTelemetryFolderCommand}"
                                                        Padding="12,6"
                                                        MinHeight="0" />
                                                <Button Classes="danger-outline-button"
                                                        Content="{loc:Loc 'Delete All Data'}"
                                                        Command="{Binding DeleteTelemetryDataCommand}"
                                                        IsEnabled="{Binding !IsDeletingTelemetry}"
                                                        Padding="12,6"
                                                        MinHeight="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Notifications Tab -->
                    <TabItem Header="{loc:Loc Notifications}">
                        <!-- Horizontal scrolling disabled so the viewport width is finite. Left on
                             the default, cards get infinite width during measure and TextWrapping
                             never kicks in, so longer descriptions run past the toggle. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="0">
                                <!-- Extra bottom margin: this StackPanel uses Spacing="4". -->
                                <controls:SampleCompanyNotice Margin="0,0,0,12"
                                                              IsVisible="{Binding IsSampleCompany}" />
                                <TextBlock Text="{loc:Loc 'Configure notification preferences'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,0,0,16" />

                                <!-- One container, hairline-separated. Seven cards made
                                     seven switches look like seven separate objects. -->
                                <Border Classes="settings-group">
                                  <StackPanel>

                                <!-- Low Stock Alert -->
                                    <Border Classes="settings-row"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'Low Stock Alert'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Get notified when inventory is running low'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding LowStockAlert}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Out of Stock Alert -->
                                    <Border Classes="settings-row"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'Out of Stock Alert'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Get notified when inventory runs out'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding OutOfStockAlert}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Invoice Overdue -->
                                    <Border Classes="settings-row"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'Invoice Overdue'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Get notified when invoices become overdue'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding InvoiceOverdue}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Rental Overdue -->
                                    <Border Classes="settings-row"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'Rental Overdue'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Get notified when rentals become overdue'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding RentalOverdue}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Payment Notifications -->
                                    <Border Classes="settings-row"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'Payment Received'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Get notified when an online payment is received'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding PortalNotifyOnPayment}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Unsaved Changes Reminder -->
                                    <Border Classes="settings-row last"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc 'Unsaved Changes Reminder'}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc 'Show a reminder when changes are unsaved'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding UnsavedChangesReminder}"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding UnsavedChangesReminder}">
                                            <TextBlock Text="{loc:Loc 'Show after'}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox SelectedItem="{Binding UnsavedChangesReminderMinutes}"
                                                      ItemsSource="{Binding ReminderMinuteOptions}"
                                                      Width="70"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc 'minutes'}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                  </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Appearance Tab -->
                    <TabItem Header="{loc:Loc Appearance}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="24" HorizontalAlignment="Center">
                                <!-- Theme -->
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{loc:Loc Theme}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <!-- Light Theme -->
                                        <Button Classes="theme-selector"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Light">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Border Grid.Row="0"
                                                        Width="100" Height="60"
                                                        Background="#FFFFFF"
                                                        CornerRadius="6"
                                                        ClipToBounds="True">
                                                    <Border.BorderThickness>
                                                        <Binding Path="SelectedTheme">
                                                            <Binding.Converter>
                                                                <local:StringEqualsConverter CompareValue="Light" TrueValue="2" FalseValue="1" />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Border.BorderThickness>
                                                    <Border.BorderBrush>
                                                        <MultiBinding Converter="{x:Static local:Converters.ThemeBorderBrushMulti}" ConverterParameter="Light">
                                                            <Binding Path="SelectedTheme" />
                                                            <Binding Path="SelectedAccentColor" />
                                                        </MultiBinding>
                                                    </Border.BorderBrush>
                                                    <StackPanel Margin="10" Spacing="6">
                                                        <Border Height="10" Background="#E5E7EB" CornerRadius="2" />
                                                        <Border Height="8" Width="50" Background="#E5E7EB" CornerRadius="2" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{loc:Loc Light}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- Dark Theme -->
                                        <Button Classes="theme-selector"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="Dark">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Border Grid.Row="0"
                                                        Width="100" Height="60"
                                                        Background="#1F2937"
                                                        CornerRadius="6"
                                                        ClipToBounds="True">
                                                    <Border.BorderThickness>
                                                        <Binding Path="SelectedTheme">
                                                            <Binding.Converter>
                                                                <local:StringEqualsConverter CompareValue="Dark" TrueValue="2" FalseValue="1" />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Border.BorderThickness>
                                                    <Border.BorderBrush>
                                                        <MultiBinding Converter="{x:Static local:Converters.ThemeBorderBrushMulti}" ConverterParameter="Dark">
                                                            <Binding Path="SelectedTheme" />
                                                            <Binding Path="SelectedAccentColor" />
                                                        </MultiBinding>
                                                    </Border.BorderBrush>
                                                    <StackPanel Margin="10" Spacing="6">
                                                        <Border Height="10" Background="#374151" CornerRadius="2" />
                                                        <Border Height="8" Width="50" Background="#374151" CornerRadius="2" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{loc:Loc Dark}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- System Theme -->
                                        <Button Classes="theme-selector"
                                                Command="{Binding SelectThemeCommand}"
                                                CommandParameter="System">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Border Grid.Row="0"
                                                        Width="100" Height="60"
                                                        CornerRadius="6"
                                                        ClipToBounds="True">
                                                    <Border.BorderThickness>
                                                        <Binding Path="SelectedTheme">
                                                            <Binding.Converter>
                                                                <local:StringEqualsConverter CompareValue="System" TrueValue="2" FalseValue="1" />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Border.BorderThickness>
                                                    <Border.BorderBrush>
                                                        <MultiBinding Converter="{x:Static local:Converters.ThemeBorderBrushMulti}" ConverterParameter="System">
                                                            <Binding Path="SelectedTheme" />
                                                            <Binding Path="SelectedAccentColor" />
                                                        </MultiBinding>
                                                    </Border.BorderBrush>
                                                    <Grid>
                                                        <Border Background="#FFFFFF" CornerRadius="6,0,0,6" HorizontalAlignment="Left" Width="50" />
                                                        <Border Background="#1F2937" CornerRadius="0,6,6,0" HorizontalAlignment="Right" Width="50" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{loc:Loc System}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Accent Color -->
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{loc:Loc 'Accent Color'}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <!-- Blue -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Blue">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#3B82F6">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Blue" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- Green -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Green">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#10B981">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Green" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- Purple -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Purple">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource VioletBrush}">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Purple" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- Pink -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Pink">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#EC4899">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Pink" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- Orange -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Orange">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#F97316">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Orange" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- Teal -->
                                        <Button Classes="color-button"
                                                Command="{Binding SelectAccentColorCommand}"
                                                CommandParameter="Teal">
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#14B8A6">
                                                    <PathIcon Data="{x:Static icons:Icons.Check}"
                                                              Width="20" Height="20" Foreground="White">
                                                        <PathIcon.IsVisible>
                                                            <Binding Path="SelectedAccentColor">
                                                                <Binding.Converter>
                                                                    <local:StringEqualsConverter CompareValue="Teal" />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </PathIcon.IsVisible>
                                                    </PathIcon>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Security Tab -->
                    <TabItem Header="{loc:Loc Security}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="16">
                                <controls:SampleCompanyNotice IsVisible="{Binding IsSampleCompany}" />

                                <!-- Password - No password set. Plain row, not a status-panel: it sits
                                     above Biometric Login and Auto-Lock, which are plain, and the one
                                     boxed setting in the tab read as the odd one out. -->
                                <Border Classes="settings-row last"
                                        IsVisible="{Binding !HasPassword}"
                                        IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{loc:Loc Password}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Add a password to protect your company file'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="primary-button"
                                                Content="{loc:Loc 'Add Password'}"
                                                Command="{Binding OpenAddPasswordCommand}"
                                                IsEnabled="{Binding !IsSampleCompany}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Password - Has password set -->
                                <Border Classes="settings-row last"
                                        IsVisible="{Binding HasPassword}"
                                        IsEnabled="{Binding !IsSampleCompany}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{loc:Loc Password}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Your company file is password protected'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="secondary-button"
                                                    Content="{loc:Loc Change}"
                                                    Command="{Binding OpenChangePasswordCommand}"
                                                    VerticalAlignment="Center" />
                                            <Button Classes="danger-button"
                                                    Content="{loc:Loc Remove}"
                                                    Command="{Binding OpenRemovePasswordCommand}"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Biometric Login -->
                                <Border Classes="settings-row last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{loc:Loc 'Biometric Login'}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- Show description when enabled (has both Standard and password) -->
                                            <TextBlock Text="{loc:Loc 'Use fingerprint or face recognition to unlock'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       IsVisible="{Binding CanEnableBiometricLogin}" />
                                            <!-- Show "requires password" message when has Premium but no password -->
                                            <TextBlock Text="{loc:Loc 'Requires a password to be set first'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding NeedsPasswordForBiometricLogin}" />
                                            <!-- Show "requires Premium" message when doesn't have Premium plan -->
                                            <TextBlock Text="{loc:Loc 'Requires Premium plan'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding !HasPremium}" />
                                        </StackPanel>
                                        <!-- Toggle when user has Premium AND password -->
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding BiometricLoginEnabled}"
                                                      IsVisible="{Binding CanEnableBiometricLogin}"
                                                      VerticalAlignment="Center" />
                                        <!-- Upgrade button when user doesn't have Premium -->
                                        <Button Grid.Column="1"
                                                Classes="primary-button"
                                                Content="{loc:Loc 'Upgrade Now'}"
                                                Command="{Binding UpgradeNowCommand}"
                                                IsVisible="{Binding !HasPremium}"
                                                VerticalAlignment="Center"
                                                Padding="12,6" />
                                    </Grid>
                                </Border>

                                <!-- Auto-Lock -->
                                <StackPanel Spacing="6" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock Text="{loc:Loc Auto-Lock}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding AutoLockOptions}"
                                              SelectedItem="{Binding SelectedAutoLock}"
                                              IsEnabled="{Binding !NeedsPasswordForAutoLock}"
                                              Classes="form-combobox">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- Show description when password is set -->
                                    <TextBlock Text="{loc:Loc 'Automatically lock the application after inactivity'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsVisible="{Binding !NeedsPasswordForAutoLock}" />
                                    <!-- Show "requires password" message when no password is set -->
                                    <TextBlock Text="{loc:Loc 'Requires a password to be set first'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               IsVisible="{Binding NeedsPasswordForAutoLock}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Payment Portal Tab -->
                    <TabItem Header="{loc:Loc 'Payment Portal'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="16">
                                <controls:SampleCompanyNotice IsVisible="{Binding IsSampleCompany}" />
                                <!-- Portal Company Name -->
                                <StackPanel Spacing="8" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Company Name'}" />
                                    <TextBlock Text="{loc:Loc 'The name displayed on your customer-facing payment portal.'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBox Text="{Binding PortalCompanyName, Mode=TwoWay}"
                                             PlaceholderText="{loc:Loc 'Enter company name'}"
                                             Classes="form-input"
                                             MaxLength="255" />
                                </StackPanel>

                                <!-- Portal Owner Email -->
                                <StackPanel Spacing="8" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Owner Email'}" />
                                    <!-- Empty state copy: points at the Set button below. -->
                                    <TextBlock Text="{loc:Loc 'Used for refund verification and recovery. Click Set to confirm it with an emailed code.'}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsVisible="{Binding CompanyEmail, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                    <!-- Set state copy: points at the Change button below. -->
                                    <TextBlock Text="{loc:Loc 'Used for refund verification and recovery. Click Change to update it with an emailed code.'}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsVisible="{Binding CompanyEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- Empty state: editable input + Set button (initial setup). Full-width to
                                         match the Company Name box, with the Set action tucked to the right. -->
                                    <Grid ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding CompanyEmail, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding PendingOwnerEmail, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="you@example.com"
                                                 HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc 'Set'}"
                                                Classes="primary-button"
                                                Command="{Binding SetInitialOwnerEmailCommand}"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                VerticalAlignment="Stretch" />
                                    </Grid>

                                    <!-- Set state: plain label + Change button. Not boxed like the
                                         editable inputs, because it cannot be typed into: changing it
                                         goes through the verified Change flow. Looking like a text box
                                         invited people to try. -->
                                    <Grid ColumnDefinitions="*,Auto"
                                          MinHeight="{StaticResource FormControlHeight}"
                                          IsVisible="{Binding CompanyEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CompanyEmail}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc 'Change'}"
                                                Classes="secondary-button"
                                                Command="{Binding OpenEmailChangeModalCommand}"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <!-- Portal Logo -->
                                <StackPanel Spacing="8" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock Text="{loc:Loc 'Portal Logo'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'This logo is shown on your customer-facing payment portal.'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="8"
                                            Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">
                                            <!-- Logo preview -->
                                            <Border Grid.Column="0"
                                                    Width="48" Height="48"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    IsVisible="{Binding HasPortalLogo}">
                                                <Image Source="{Binding PortalLogoSource}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <!-- No logo placeholder -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Loc 'No logo uploaded'}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasPortalLogo}" />
                                            <!-- Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="primary-button"
                                                        Content="{Binding PortalLogoButtonText}"
                                                        Command="{Binding BrowsePortalLogoCommand}"
                                                        IsEnabled="{Binding !IsUploadingPortalLogo}"
                                                        Padding="12,6"
                                                        MinHeight="0" />
                                                <Button Classes="danger-outline-button"
                                                        Content="{loc:Loc Remove}"
                                                        Command="{Binding RemovePortalLogoCommand}"
                                                        IsVisible="{Binding HasPortalLogo}"
                                                        IsEnabled="{Binding !IsUploadingPortalLogo}"
                                                        Padding="12,6"
                                                        MinHeight="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Connected Payment Providers -->
                                <StackPanel Spacing="8" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock Text="{loc:Loc 'Connected Payment Providers'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <!-- Gate: a provider can't be connected until both the company name and owner
                                         email are set. Amber pill, not red text: nothing has gone wrong, there is
                                         a step still to do. Matches the verify-email prompt in Notifications. -->
                                    <Border Background="{DynamicResource WarningNoticeBgBrush}"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding ShowConnectRequirementsHint}">
                                        <TextBlock Text="{loc:Loc 'Set your company name and owner email above before connecting a payment provider.'}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningNoticeTextBrush}" />
                                    </Border>

                                    <!-- Stripe -->
                                    <Border Classes="status-panel" Classes.on="{Binding StripeConnected}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Stripe"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc 'Connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding StripeConnected}" />
                                                <TextBlock Text="{loc:Loc 'Not connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           IsVisible="{Binding !StripeConnected}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="primary-button"
                                                    Content="{loc:Loc Connect}"
                                                    Command="{Binding ConnectStripeCommand}"
                                                    IsVisible="{Binding !StripeConnected}"
                                                    IsEnabled="{Binding CanConnectProvider}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                            <Button Grid.Column="1"
                                                    Classes="danger-outline-button"
                                                    Content="{loc:Loc Disconnect}"
                                                    Command="{Binding DisconnectStripeCommand}"
                                                    IsVisible="{Binding StripeConnected}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                        </Grid>
                                    </Border>

                                    <!--
                                        PayPal portal Connect is currently disabled. PayPal's "Log in with PayPal"
                                        OAuth endpoint refuses to return identity for Business-account tokens, so
                                        the Connect flow can't onboard real merchants. Re-enabling requires
                                        migrating to PayPal Partner Referrals API after approval into PayPal
                                        Platforms & Marketplaces. The view model still exposes PaypalConnected /
                                        ConnectPaypalCommand / DisconnectPaypalCommand for parity with the server
                                        response shape, but they're not bound to any UI.

                                    <Border Classes="status-panel" Classes.on="{Binding PaypalConnected}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="PayPal"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc 'Connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding PaypalConnected}" />
                                                <TextBlock Text="{loc:Loc 'Not connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           IsVisible="{Binding !PaypalConnected}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="primary-button"
                                                    Content="{loc:Loc Connect}"
                                                    Command="{Binding ConnectPaypalCommand}"
                                                    IsVisible="{Binding !PaypalConnected}"
                                                    IsEnabled="{Binding !IsConnectingProvider}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                            <Button Grid.Column="1"
                                                    Classes="danger-outline-button"
                                                    Content="{loc:Loc Disconnect}"
                                                    Command="{Binding DisconnectPaypalCommand}"
                                                    IsVisible="{Binding PaypalConnected}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                        </Grid>
                                    </Border>
                                    -->

                                    <!-- Square -->
                                    <Border Classes="status-panel" Classes.on="{Binding SquareConnected}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Square"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc 'Connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           IsVisible="{Binding SquareConnected}" />
                                                <TextBlock Text="{loc:Loc 'Not connected'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           IsVisible="{Binding !SquareConnected}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="primary-button"
                                                    Content="{loc:Loc Connect}"
                                                    Command="{Binding ConnectSquareCommand}"
                                                    IsVisible="{Binding !SquareConnected}"
                                                    IsEnabled="{Binding CanConnectProvider}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                            <Button Grid.Column="1"
                                                    Classes="danger-outline-button"
                                                    Content="{loc:Loc Disconnect}"
                                                    Command="{Binding DisconnectSquareCommand}"
                                                    IsVisible="{Binding SquareConnected}"
                                                    VerticalAlignment="Center"
                                                    Padding="12,6"
                                                    MinHeight="0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Both switch rows live in ONE grid so the switches share a single column.
                                     Two Borders each with their own "*,Auto" grid meant two independently
                                     computed columns, and any difference between them put the switches at
                                     different x. Sharing the column makes that impossible rather than merely
                                     unlikely. Row 0 and row 3 carry a label and its switch; the conditional
                                     sentences sit in rows of their own underneath, in column 0, so showing one
                                     cannot change the height the switch is centred in. Row 2 is the hairline
                                     that Border.settings-row used to draw as its bottom edge. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      Margin="0,16,0,16">

                                    <!-- Sent by the server, so it arrives with the app closed. Here rather than
                                         under Notifications because it depends on the owner email verified at
                                         the top of this tab. -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2"
                                                MinHeight="40" VerticalAlignment="Center"
                                                IsEnabled="{Binding !IsSampleCompany}">
                                        <TextBlock Text="{loc:Loc 'Email me when a customer pays'}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:Loc 'Sends an email to your business email address each time an online payment comes in, even when Argo Books is closed'}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                                  Classes="settings-switch"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding PortalEmailOwnerOnPayment}"
                                                  IsEnabled="{Binding PortalOwnerEmailVerified}" />

                                    <!-- Amber-on-amber pill rather than amber text: the plain WarningBrush
                                         (#F59E0B) has poor contrast against the light-theme SurfaceAlt
                                         (#E9ECEF). -->
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="{DynamicResource WarningNoticeBgBrush}"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding !PortalOwnerEmailVerified}">
                                        <TextBlock Text="{loc:Loc 'Verify your business email above to turn this on.'}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningNoticeTextBrush}" />
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Height="1" Margin="0,16,0,16"
                                            Background="{DynamicResource BorderBrush}" />

                                    <!-- Automatic overdue reminders, sent by the server. -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2"
                                                MinHeight="40" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc 'Automatic payment reminders'}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{loc:Loc 'Email customers 3, 7 and 14 days after an invoice becomes overdue. Reminders stop as soon as the invoice is paid or cancelled.'}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                    <!-- Switch only, not the whole row: dimming the row would dim the sentence
                                         explaining why it is off. -->
                                    <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                                  Classes="settings-switch"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding PortalSendPaymentReminders}"
                                                  IsEnabled="{Binding CanEditPaymentReminders}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc 'Only invoices that fall due from now on are chased, so turning this on will not email anyone about invoices that are already overdue. Record payments you take in cash or by cheque so those customers are not chased.'}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsVisible="{Binding PortalSendPaymentReminders}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc 'Connect a payment provider first, so customers have a way to pay from the reminder.'}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsVisible="{Binding !IsAnyPaymentProviderConnected}" />
                                </Grid>

                                <!-- Sync Interval -->
                                <StackPanel Spacing="6" Margin="0,8,0,0" IsEnabled="{Binding !IsSampleCompany}">
                                    <TextBlock Text="{loc:Loc 'Auto-Sync Interval'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox ItemsSource="{Binding SyncIntervalOptions}"
                                                  SelectedItem="{Binding PortalSyncInterval}"
                                                  Classes="form-combobox"
                                                  Width="110" />
                                        <TextBlock Text="{loc:Loc minutes}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSyncIntervalNumeric}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Bank Import Rules Tab -->
                    <TabItem Header="{loc:Loc 'Bank import rules'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="16">

                                <!-- Header row: description + Add rule button -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc 'Automatically assign categories to imported bank transactions based on matching patterns.'}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="primary-button"
                                            Content="{loc:Loc 'Add rule'}"
                                            Command="{Binding AddBankRuleCommand}"
                                            Padding="12,6"
                                            MinHeight="0"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <!-- Column headers (columns mirror the rule rows below). Hidden
                                     with the list: headings over nothing read as a broken table. -->
                                <Grid ColumnDefinitions="1.6*,12,*,8,40" Margin="0,0,0,-8"
                                      IsVisible="{Binding BankCategoryRules.Count, Converter={x:Static local:IntConverters.IsPositive}}">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc Pattern}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{loc:Loc Category}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>

                                <!-- Rules list -->
                                <ItemsControl ItemsSource="{Binding BankCategoryRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BankCategoryRuleRow">
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="1.6*,12,*,8,40" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                                    <!-- Pattern TextBox -->
                                                    <TextBox x:Name="PatternBox"
                                                             Grid.Row="0" Grid.Column="0"
                                                             Text="{Binding Pattern, Mode=TwoWay}"
                                                             PlaceholderText="{loc:Loc 'e.g. AMAZON, UBER, NETFLIX'}"
                                                             Classes="form-input"
                                                             VerticalAlignment="Center" />

                                                    <!-- Category picker with inline create -->
                                                    <controls:SearchableDropdown Grid.Row="0" Grid.Column="2"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).AvailableBankCategories}"
                                                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                        SearchText="{Binding CategorySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        Placeholder="{loc:Loc 'Select category...'}"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).OpenCreateCategoryCommand}"
                                                        Classes="compact"
                                                        VerticalAlignment="Center" />

                                                    <!-- Delete button: top-aligned at the pattern box's own height, so the icon
                                                         lines up with the inputs whatever else makes the row taller. -->
                                                    <Button Grid.Row="0" Grid.Column="4"
                                                            Classes="icon-button"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).DeleteBankRuleCommand}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Top"
                                                            Height="{Binding #PatternBox.Bounds.Height}">
                                                        <PathIcon Data="{x:Static icons:Icons.Delete}"
                                                                  Width="16" Height="16"
                                                                  Foreground="{DynamicResource ErrorBrush}" />
                                                    </Button>

                                                    <!-- Pattern validation error -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                               Text="{Binding PatternError}"
                                                               IsVisible="{Binding HasPatternError}"
                                                               Foreground="{DynamicResource ErrorBrush}"
                                                               FontSize="11"
                                                               Margin="2,4,0,0"
                                                               TextWrapping="Wrap" />

                                                    <!-- Category validation error -->
                                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                                               Text="{Binding CategoryError}"
                                                               IsVisible="{Binding HasCategoryError}"
                                                               Foreground="{DynamicResource ErrorBrush}"
                                                               FontSize="11"
                                                               Margin="2,4,0,0"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <Border Classes="empty-state"
                                        IsVisible="{Binding BankCategoryRules.Count, Converter={x:Static local:IntConverters.IsZero}}">
                                    <TextBlock Text="{loc:Loc 'No rules yet. Click ''Add rule'' to create one.'}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Mobile App Tab -->
                    <!-- This is tab index 6 (0-based, count TabItems above: General, Notifications,
                         Appearance, Security, Payment Portal, Bank import rules, Mobile app).
                         Integrations is kept last. Must match SettingsModalViewModel.MobileAppTabIndex,
                         which gates the pairing poll loop's visibility check - if this tab is ever
                         reordered, update that constant too. -->
                    <TabItem Header="{loc:Loc 'Mobile app'}"
                             IsVisible="{Binding IsMobileAppTabVisible}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="24,20,16,20" Padding="0,0,8,0">
                            <StackPanel Spacing="16">

                                <TextBlock Text="{loc:Loc 'Capture receipts and rentals from your phone, then bring them into Argo Books here.'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap" />

                                <!-- Pairing -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Loc 'Pair a phone'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Classes="status-panel">
                                        <Panel>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"
                                                  IsVisible="{Binding !IsPhoneJustPaired}">
                                                <!-- QR code preview -->
                                                <Border Grid.Column="0"
                                                        Width="180" Height="180"
                                                        CornerRadius="6"
                                                        ClipToBounds="True"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Image Source="{Binding QrImage}"
                                                           Stretch="Uniform"
                                                           Margin="8" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc 'Open the Argo Books mobile app and scan this code to link this computer.'}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                    <!-- Secondary reveal: enter the code by hand instead of scanning -->
                                                    <StackPanel Spacing="8"
                                                                IsVisible="{Binding ShortCodeDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <!-- Link hides once the code is revealed -->
                                                        <Button Classes="link-button"
                                                                Content="{loc:Loc 'Enter a code instead'}"
                                                                Command="{Binding ToggleShortCodeRevealCommand}"
                                                                IsVisible="{Binding !IsShortCodeRevealed}"
                                                                HorizontalAlignment="Left" />

                                                        <!-- Revealed code, shown as a prominent code box -->
                                                        <StackPanel Spacing="6" IsVisible="{Binding IsShortCodeRevealed}">
                                                            <TextBlock Text="{loc:Loc 'Enter this code on your phone'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="14,8"
                                                                    HorizontalAlignment="Left">
                                                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ShortCodeDisplay}"
                                                                               FontSize="16"
                                                                               FontWeight="SemiBold"
                                                                               FontFamily="Consolas,Menlo,monospace"
                                                                               LetterSpacing="2"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Classes="copy-icon"
                                                                            Click="OnCopyPairingCode"
                                                                            ToolTip.Tip="{loc:Loc 'Copy code'}">
                                                                        <PathIcon Data="{x:Static icons:Icons.Copy}"
                                                                                  Width="15" Height="15" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Connect button, with an in-progress state so retries show feedback -->
                                                    <Panel HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"
                                                           IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNull}}">
                                                        <Button Classes="primary-button"
                                                                Content="{loc:Loc 'Connect a phone'}"
                                                                Command="{Binding ConnectPhoneCommand}"
                                                                IsVisible="{Binding !IsConnecting}"
                                                                Padding="12,6"
                                                                MinHeight="0" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsConnecting}">
                                                            <controls:LoadingSpinner IsSpinning="{Binding IsConnecting}"
                                                                                     SizePreset="Small" />
                                                            <TextBlock Text="{loc:Loc 'Connecting...'}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Panel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Phone connected confirmation, shown once the encrypted sync key has been delivered -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsPhoneJustPaired}">
                                                <PathIcon Data="{x:Static icons:Icons.CircleCheck}"
                                                          Width="20" Height="20"
                                                          Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="{loc:Loc 'Phone connected'}"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                </StackPanel>

                                <!-- Paired devices -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Grid.Column="0"
                                                   Text="{loc:Loc 'Paired devices'}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Classes="secondary-button"
                                                Content="{loc:Loc Refresh}"
                                                Command="{Binding RefreshDevicesCommand}"
                                                IsEnabled="{Binding !IsRefreshingDevices}"
                                                Padding="12,6"
                                                MinHeight="0" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PairedDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tracking:PairedDevice">
                                                <Border Classes="item-card" Padding="16" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="14"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding LastSeenAt, StringFormat='Last seen {0}'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Classes="danger-outline-button"
                                                                Content="{loc:Loc Revoke}"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).RevokeDeviceCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Padding="12,6"
                                                                MinHeight="0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <Border Classes="empty-state"
                                            IsVisible="{Binding PairedDevices.Count, Converter={x:Static local:IntConverters.IsZero}}">
                                        <TextBlock Text="{loc:Loc 'No phones paired yet.'}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Integrations Tab (kept last so it's the bottom-most tab) -->
                    <TabItem Header="{loc:Loc 'Integrations'}">
                        <Grid RowDefinitions="Auto,*" Margin="24,20,16,20">

                            <controls:SampleCompanyNotice Grid.Row="0"
                                                          IsVisible="{Binding IsSampleCompany}"
                                                          Margin="0,0,0,14" />

                            <!-- One tab per integration. They share no state, and each is long
                                 enough that stacking them meant scrolling past the whole of one
                                 to reach the other. -->
                            <TabControl Grid.Row="1" Classes="sub-tabs">

                                <TabItem Header="Stripe">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Padding="0,14,8,0">
                                <!-- IsEnabled sits on the inputs below, not here, so the sample
                                     company keeps a clickable "Full guide" link. -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Stripe" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'Import your Stripe payouts, charges, fees and refunds into your books.'}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />

                                    <!-- Not-connected state: key input + guidance -->
                                    <StackPanel Spacing="8" IsVisible="{Binding !StripeIntegrationConnected}">
                                        <TextBlock Text="{loc:Loc 'Paste a restricted, read-only Stripe secret key. Argo uses it only to read your payouts and charges. It cannot move money or change anything.'}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                                        <!-- Not behind a disclosure: this block only renders while
                                             Stripe is unconnected, so anyone seeing it needs it. -->
                                        <Border Background="{DynamicResource InfoLightBrush}"
                                                BorderBrush="{DynamicResource InfoBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{x:Static icons:Icons.Help}"
                                                              Width="16" Height="16"
                                                              Foreground="{DynamicResource InfoTextBrush}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc 'How to get this key'}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InfoTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource InfoTextBrush}"
                                                               Text="{loc:Loc '1. In your Stripe dashboard, open Developers, then API keys.'}" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource InfoTextBrush}"
                                                               Text="{loc:Loc '2. Click Create restricted key.'}" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource InfoTextBrush}"
                                                               Text="{loc:Loc '3. Grant Read access to Balance transactions, Charges, and Payouts. Leave everything else at None.'}" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource InfoTextBrush}"
                                                               Text="{loc:Loc '4. Create the key, copy it, and paste it below.'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{loc:Loc 'Full guide: '}" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource InfoTextBrush}" />
                                                    <Button Classes="link" Content="{loc:Loc 'Open the Stripe guide'}"
                                                            FontSize="12" Padding="0" MinHeight="0"
                                                            Command="{Binding OpenStripeGuideCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBox Text="{Binding StripeKeyInput, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="rk_live_..."
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 MinHeight="64" Height="64"
                                                 VerticalContentAlignment="Top"
                                                 IsEnabled="{Binding !IsSampleCompany}" />

                                        <TextBlock Text="{Binding StripeIntegrationError}" Foreground="#dc2626" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding StripeIntegrationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                        <!-- No IsSampleCompany check needed: CanConnectStripeIntegration
                                             requires a key, and the box above is disabled. -->
                                        <Button Content="{loc:Loc Connect}"
                                                Classes="primary-button"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{Binding CanConnectStripeIntegration}"
                                                Command="{Binding ConnectStripeIntegrationCommand}"
                                                Padding="12,6" MinHeight="0" />
                                    </StackPanel>

                                    <!-- Connected state -->
                                    <Border Classes="status-panel on"
                                            IsVisible="{Binding StripeIntegrationConnected}"
                                            IsEnabled="{Binding !IsSampleCompany}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc 'Connected'}" FontSize="12"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="{Binding StripeIntegrationAccountLabel}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding StripeIntegrationAccountLabel}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding StripeLastSyncedDisplay}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           IsVisible="{Binding StripeLastSyncedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsSyncingStripe}">
                                                        <controls:LoadingSpinner SizePreset="Small"
                                                                                 IsSpinning="{Binding IsSyncingStripe}"
                                                                                 SpinnerBrush="{DynamicResource PrimaryBrush}"
                                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StripeSyncStatus}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                <Button Classes="primary-button" Content="{loc:Loc 'Sync now'}"
                                                        Command="{Binding SyncStripeIntegrationCommand}"
                                                        IsEnabled="{Binding !IsSyncingStripe}"
                                                        Padding="12,6" MinHeight="0" />
                                                <Button Classes="danger-outline-button" Content="{loc:Loc Disconnect}"
                                                        Command="{Binding DisconnectStripeIntegrationCommand}"
                                                        Padding="12,6" MinHeight="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="{loc:Loc 'Argo Books API'}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" Padding="0,14,8,0">
                                <!-- Argo Books API: data pushed in by apps the user has connected -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Loc 'Argo Books API'}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'Let other apps send sales, expenses, customers and suppliers straight into this company. Nothing they send reaches your books until you review and import it.'}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />

                                    <!-- Off state -->
                                    <StackPanel Spacing="8" IsVisible="{Binding !ArgoApiEnabled}">
                                        <Button Content="{loc:Loc Connect}"
                                                Classes="primary-button"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{Binding !IsSampleCompany}"
                                                Command="{Binding EnableArgoApiCommand}"
                                                Padding="12,6" MinHeight="0" />
                                    </StackPanel>

                                    <!-- On state -->
                                    <StackPanel Spacing="12" IsVisible="{Binding ArgoApiEnabled}"
                                                IsEnabled="{Binding !IsSampleCompany}">

                                        <Border Classes="status-panel on">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="40">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc 'On'}" FontSize="12"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                    <!-- Trimmed, not clipped: the base URL is the widest
                                                         thing here and the buttons take their width first. -->
                                                    <TextBlock Text="{Binding ArgoApiBaseUrl}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding ArgoApiBaseUrl}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <!-- Under the URL rather than beside the buttons, where it
                                                         was stealing the width the URL needed. -->
                                                    <TextBlock Text="{Binding ArgoApiLastSyncedDisplay}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               IsVisible="{Binding ArgoApiLastSyncedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding ArgoApiPendingSummary}" FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               IsVisible="{Binding ArgoApiPendingSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsSyncingArgoApi}">
                                                        <controls:LoadingSpinner SizePreset="Small"
                                                                                 IsSpinning="{Binding IsSyncingArgoApi}"
                                                                                 SpinnerBrush="{DynamicResource PrimaryBrush}"
                                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ArgoApiSyncStatus}" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button Classes="primary-button" Content="{loc:Loc 'Sync now'}"
                                                            Command="{Binding SyncArgoApiCommand}"
                                                            IsEnabled="{Binding !IsSyncingArgoApi}"
                                                            Padding="12,6" MinHeight="0" />
                                                    <Button Classes="danger-outline-button" Content="{loc:Loc Disconnect}"
                                                            Command="{Binding DisableArgoApiCommand}"
                                                            Padding="12,6" MinHeight="0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Key list -->
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Loc 'Keys'}" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Loc 'Give each app its own key so you can switch one off without affecting the others. Argo Books keeps a separate key of its own, which is not listed here and does not need managing.'}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />

                                            <!-- Above the list, not below it. Creating a key is what someone
                                                 opens this panel to do, and once there are several keys the
                                                 controls were scrolled off the bottom. -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding NewArgoApiKeyLabel, Mode=TwoWay}"
                                                         Classes="form-input"
                                                         PlaceholderText="{loc:Loc 'Name this key, for example: Shopify store'}" />
                                                <Button Grid.Column="1"
                                                        Content="{loc:Loc 'Create key'}"
                                                        Classes="secondary-button"
                                                        Command="{Binding CreateArgoApiKeyCommand}"
                                                        Padding="12,6" MinHeight="0" />
                                            </Grid>

                                            <!-- Without this the list is simply empty on first open, which
                                                 reads as something having gone wrong rather than as nothing
                                                 having been created yet. -->
                                            <Border Classes="empty-state"
                                                    IsVisible="{Binding HasNoArgoApiKeys}">
                                                <TextBlock Text="{loc:Loc 'No keys yet. Name one above and create it, then give it to the app or developer that needs to send data in.'}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding ArgoApiKeys}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ArgoApiKeyRow">
                                                        <Border Classes="item-card" Margin="0,0,0,6">
                                                            <Grid>
                                                                <!-- Display state -->
                                                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsNotEditing}">
                                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding Hint}" FontSize="11"
                                                                                   FontFamily="Consolas,monospace"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                        <TextBlock Text="{Binding LastUsedDisplay}" FontSize="11"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                                Spacing="8" VerticalAlignment="Center">
                                                                        <Button Classes="secondary-button"
                                                                                Content="{loc:Loc 'Rename'}"
                                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).BeginRenameArgoApiKeyCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Padding="10,5" MinHeight="0" />
                                                                        <Button Classes="danger-outline-button"
                                                                                Content="{loc:Loc 'Delete'}"
                                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).DeleteArgoApiKeyCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Padding="10,5" MinHeight="0" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Rename state. Only the name is editable: the
                                                                     secret cannot be shown again and the scopes
                                                                     decide what the key may do. -->
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                                                                      IsVisible="{Binding IsEditing}">
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding EditLabel, Mode=TwoWay}"
                                                                             Classes="form-input"
                                                                             VerticalAlignment="Center"
                                                                             PlaceholderText="{loc:Loc 'Name this key'}">
                                                                        <TextBox.KeyBindings>
                                                                            <KeyBinding Gesture="Enter"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).SaveArgoApiKeyNameCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            <KeyBinding Gesture="Escape"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).CancelRenameArgoApiKeyCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                        </TextBox.KeyBindings>
                                                                    </TextBox>
                                                                    <Button Grid.Column="1" Classes="primary-button"
                                                                            Content="{loc:Loc Save}"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).SaveArgoApiKeyNameCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="10,5" MinHeight="0" />
                                                                    <Button Grid.Column="2" Classes="secondary-button"
                                                                            Content="{loc:Loc Cancel}"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsModalViewModel)DataContext).CancelRenameArgoApiKeyCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="10,5" MinHeight="0" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{loc:Loc 'Developer documentation: '}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <Button Classes="link" Content="{loc:Loc 'Open the API docs'}"
                                                    FontSize="12" Padding="0" MinHeight="0"
                                                    Command="{Binding OpenArgoApiDocsCommand}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ArgoApiError}" Foreground="#dc2626" FontSize="12"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding ArgoApiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                            </TabControl>
                        </Grid>
                    </TabItem>

                </TabControl>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Padding="24,16"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">
                        <Button Classes="secondary-button"
                                Content="{loc:Loc Cancel}"
                                Command="{Binding CloseCommand}" />
                        <Button Classes="primary-button"
                                Content="{loc:Loc 'Save Changes'}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Add Password Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsAddPasswordModalOpen}" ClosingCommand="{Binding ClosePasswordModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{loc:Loc 'Add Password'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <StackPanel Margin="20" Spacing="16">
                        <TextBlock Text="{loc:Loc 'Create a password to protect your company file. You''ll need this password to open the file.'}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'New Password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewPassword}"
                                             PasswordChar="{Binding NewPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleNewPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding NewPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Password Strength Indicator -->
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPasswordStrength}">
                                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}">
                                    <Border CornerRadius="2" HorizontalAlignment="Left"
                                            Width="{Binding PasswordStrengthBarWidth}"
                                            Classes.strength-weak="{Binding IsStrengthWeak}"
                                            Classes.strength-fair="{Binding IsStrengthFair}"
                                            Classes.strength-strong="{Binding IsStrengthStrong}">
                                        <Border.Styles>
                                            <Style Selector="Border.strength-weak">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                            </Style>
                                            <Style Selector="Border.strength-fair">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            </Style>
                                            <Style Selector="Border.strength-strong">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </Style>
                                        </Border.Styles>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthText}" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Classes.strength-weak="{Binding IsStrengthWeak}"
                                           Classes.strength-fair="{Binding IsStrengthFair}"
                                           Classes.strength-strong="{Binding IsStrengthStrong}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.strength-weak">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.strength-fair">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.strength-strong">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'Confirm password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConfirmPassword}"
                                             PasswordChar="{Binding ConfirmPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleConfirmPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding ConfirmPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PasswordError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding ClosePasswordModalCommand}" />
                            <Button Classes="primary-button" Content="{loc:Loc 'Add Password'}" Command="{Binding ConfirmAddPasswordCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Change Password Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsChangePasswordModalOpen}" ClosingCommand="{Binding ClosePasswordModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{loc:Loc 'Change Password'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <StackPanel Margin="20" Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'Current Password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             x:Name="ChangeCurrentPasswordTextBox"
                                             Text="{Binding CurrentPassword}"
                                             PasswordChar="{Binding CurrentPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleCurrentPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding CurrentPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'New Password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewPassword}"
                                             PasswordChar="{Binding NewPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleNewPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding NewPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Password Strength Indicator -->
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPasswordStrength}">
                                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}">
                                    <Border CornerRadius="2" HorizontalAlignment="Left"
                                            Width="{Binding PasswordStrengthBarWidth}"
                                            Classes.strength-weak="{Binding IsStrengthWeak}"
                                            Classes.strength-fair="{Binding IsStrengthFair}"
                                            Classes.strength-strong="{Binding IsStrengthStrong}">
                                        <Border.Styles>
                                            <Style Selector="Border.strength-weak">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                                            </Style>
                                            <Style Selector="Border.strength-fair">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            </Style>
                                            <Style Selector="Border.strength-strong">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </Style>
                                        </Border.Styles>
                                    </Border>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthText}" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Classes.strength-weak="{Binding IsStrengthWeak}"
                                           Classes.strength-fair="{Binding IsStrengthFair}"
                                           Classes.strength-strong="{Binding IsStrengthStrong}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.strength-weak">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.strength-fair">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </Style>
                                        <Style Selector="TextBlock.strength-strong">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'Confirm New Password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ConfirmPassword}"
                                             PasswordChar="{Binding ConfirmPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleConfirmPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding ConfirmPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PasswordError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding ClosePasswordModalCommand}" />
                            <Button Classes="primary-button" Content="{loc:Loc 'Change Password'}" Command="{Binding ConfirmChangePasswordCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Remove Password Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsRemovePasswordModalOpen}" ClosingCommand="{Binding ClosePasswordModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{loc:Loc 'Remove Password'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <StackPanel Margin="20" Spacing="16">
                        <TextBlock Text="{loc:Loc 'Are you sure you want to remove password protection? Your company file will no longer be protected.'}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'Current Password'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             x:Name="RemoveCurrentPasswordTextBox"
                                             Text="{Binding CurrentPassword}"
                                             PasswordChar="{Binding CurrentPasswordMaskChar}"
                                             Classes="password-field"
                                             MaxLength="64" />
                                    <Button Grid.Column="1"
                                            Classes="eye-toggle"
                                            Command="{Binding ToggleCurrentPasswordVisibilityCommand}">
                                        <PathIcon Data="{Binding CurrentPasswordVisibilityIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PasswordError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding ClosePasswordModalCommand}" />
                            <Button Classes="danger-button" Content="{loc:Loc 'Remove Password'}" Command="{Binding ConfirmRemovePasswordCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

    </Panel>

    <UserControl.Styles>
        <!-- Password Field (borderless, for use inside bordered container) -->
        <Style Selector="TextBox.password-field">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <!-- PasswordChar is bound per field, not set here, so revealing can clear it. -->
        </Style>
        <Style Selector="TextBox.password-field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Eye Toggle Button (for password visibility) -->
        <Style Selector="Button.eye-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.eye-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.eye-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.eye-toggle PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Color Button -->
        <Style Selector="Button.color-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style Selector="Button.color-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.color-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Theme Selector Button -->
        <Style Selector="Button.theme-selector">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.theme-selector /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.theme-selector:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- TabControl - left navigation rail -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TabControl /template/ Border#PART_InnerBorder">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Divider between the rail and the page content -->
        <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <!-- Tab Item Styling - nav rail rows.
             Fully retemplated so there is no selection pipe and every row keeps
             the same height in all states (no jump when a tab is selected). -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RailRow"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryIconBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TabItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryIconBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Sub-tabs inside a settings panel (Integrations).
             The rules above are all built for the left-hand rail: a fixed 190px
             strip, full-width pill rows, and a divider down the left edge of the
             content. A nested strip inherits every one of them and comes out as
             stretched pills in a narrow column, so each has to be undone here
             rather than simply added to. -->
        <Style Selector="TabControl.sub-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <!-- NaN is how a fixed Width is released back to auto. -->
            <Setter Property="Width" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TabControl.sub-tabs /template/ ContentPresenter#PART_SelectedContentHost">
            <!-- Rule under the strip instead of down the side of the content. -->
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="TabControl.sub-tabs > TabItem">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,4,6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <!-- Animated Checkbox -->
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="CheckBox /template/ Path#CheckGlyph">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.5)" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>

        <!-- Time Format Toggle Buttons -->
        <Style Selector="Button.time-format-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.time-format-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.time-format-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.time-format-toggle.selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.time-format-toggle.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Button.time-format-toggle.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Small inline copy icon button (sits beside the pairing code) -->
        <Style Selector="Button.copy-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.copy-icon /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.copy-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.copy-icon PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.copy-icon:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>

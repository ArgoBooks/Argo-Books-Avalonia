<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArgoBooks.Modals.StockAdjustmentsModals"
             x:DataType="vm:StockAdjustmentsModalsViewModel">

    <Panel>
        <!-- Add Adjustment Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsAddModalOpen}"
                               ClosingCommand="{Binding RequestCloseAddModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="550">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Modal Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'New Stock Adjustment'}"
                                          Subtitle="{loc:Loc 'Adjust inventory stock levels'}"
                                          CloseCommand="{Binding RequestCloseAddModalCommand}" />

                    <!-- Modal Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="16">
                            <!-- Inventory Item Selection -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{loc:Loc 'Inventory Item'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <controls:SearchableDropdown ItemsSource="{Binding AvailableInventoryItems}"
                                                            SelectedItem="{Binding SelectedInventoryOption}"
                                                            DisplayMemberPath="DisplayText"
                                                            Placeholder="{loc:Loc 'Search inventory items...'}"
                                                            ShowAddNew="False"
                                                            EmptyMessage="{loc:Loc 'No inventory items available.'}"
                                                            EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                            EmptyCreateCommand="{Binding OpenCreateInventoryItemCommand}" />
                                <TextBlock Text="{loc:Loc 'Please select an inventory item'}"
                                           FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding HasInventoryError}" />
                            </StackPanel>

                            <!-- Adjustment Type -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{loc:Loc 'Adjustment Type'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding AdjustmentTypes}"
                                          SelectedItem="{Binding AdjustmentType}"
                                          Classes="form-combobox"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Stock Values Row -->
                            <Grid ColumnDefinitions="*,16,*,16,*">
                                <!-- Current Stock -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Current Stock'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            MinHeight="{StaticResource FormControlHeight}">
                                        <TextBlock Text="{Binding CurrentStock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <!-- Adjustment Quantity -->
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{loc:Loc Quantity}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                    </TextBlock>
                                    <TextBox Text="{Binding AdjustmentQuantity, Mode=TwoWay}"
                                             Classes="form-input"
                                             PlaceholderText="{loc:Loc 'Enter quantity'}"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                             MaxLength="7" />
                                    <TextBlock Text="{loc:Loc 'Please enter a valid quantity.'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               IsVisible="{Binding HasQuantityError}" />
                                </StackPanel>

                                <!-- New Stock Level -->
                                <StackPanel Grid.Column="4" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'New Stock'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            MinHeight="{StaticResource FormControlHeight}">
                                        <TextBlock Text="{Binding CalculatedNewStock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Reference Number -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Reference Number'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ReferenceNumber, Mode=TwoWay}"
                                         Classes="form-input"
                                         PlaceholderText="{loc:Loc 'e.g., PO-12345 or RMA-67890'}"
                                         MaxLength="50" />
                            </StackPanel>

                            <!-- Reason/Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Reason/Notes'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding AdjustmentReason, Mode=TwoWay}"
                                         Classes="form-input"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"
                                         MaxHeight="120"
                                         PlaceholderText="{loc:Loc 'Enter reason for adjustment...'}"
                                         MaxLength="500" />
                            </StackPanel>

                            <!-- Error Message -->
                            <TextBlock TextWrapping="Wrap" Text="{Binding AddModalError}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding AddModalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding CloseAddModalCommand}" />
                            <Button Classes="primary-button" Content="{loc:Loc 'Save Adjustment'}" Command="{Binding SaveAdjustmentCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- View Details Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsViewModalOpen}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="500"
                    DataContext="{Binding ViewingAdjustment}" x:CompileBindings="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Modal Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'Adjustment Details'}"
                                          CloseCommand="{Binding $parent[UserControl].DataContext.CloseViewModalCommand}">
                        <TextBlock Text="{Binding Id}"
                                   FontSize="13"
                                   FontFamily="Consolas, monospace"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </controls:ModalHeader>

                    <!-- Modal Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="20">
                            <!-- Type Badge -->
                            <Border Background="{Binding TypeBackground}"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding TypeDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding TypeColor}" />
                                    <TextBlock Text="{Binding QuantityDisplay}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{Binding QuantityColor}" />
                                </StackPanel>
                            </Border>

                            <!-- Product Info -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc Product}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="16" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ProductSku}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Location -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc Location}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding LocationName}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Stock Changes -->
                            <Grid ColumnDefinitions="*,Auto,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{loc:Loc 'Previous Stock'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding PreviousStock}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <PathIcon Grid.Column="1"
                                          Data="{x:Static local:Icons.ChevronRight}"
                                          Width="24" Height="24"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Margin="16,0" />
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{loc:Loc 'New Stock'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding NewStock}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Date and Time -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc 'Date &amp; Time'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DateDisplay}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding TimeDisplay}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Reason -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc Reason}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding Reason}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Button Classes="secondary-button" Content="{loc:Loc Close}" Command="{Binding $parent[UserControl].DataContext.CloseViewModalCommand}" HorizontalAlignment="Right" />
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Filter Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsFilterModalOpen}"
                               ClosingCommand="{Binding RequestCloseFilterModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="480">
                <StackPanel>
                    <!-- Modal Header -->
                    <controls:ModalHeader Title="{loc:Loc 'Filter Adjustments'}" CloseCommand="{Binding RequestCloseFilterModalCommand}" />

                    <!-- Modal Content -->
                    <StackPanel Spacing="16" Margin="24">
                        <!-- Date Range -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc 'Date Range'}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{loc:Loc From}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <DatePicker SelectedDate="{Binding FilterStartDate}" Classes="form-datepicker" MinWidth="0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{loc:Loc To}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <DatePicker SelectedDate="{Binding FilterEndDate}" Classes="form-datepicker" MinWidth="0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Product -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc Product}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <controls:SearchableDropdown ItemsSource="{Binding FilterProducts}"
                                                         SelectedItem="{Binding FilterProduct}"
                                                         Placeholder="{loc:Loc 'Search products...'}" />
                        </StackPanel>

                        <!-- Adjustment Type -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc 'Adjustment Type'}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding FilterTypeOptions}"
                                      SelectedItem="{Binding FilterType}"
                                      Classes="form-combobox"
                                      HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Modal Footer -->
                    <Border Classes="modal-footer">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0"
                                    Content="{loc:Loc 'Clear filters'}"
                                    Classes="secondary-button"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ClearFiltersCommand}" />
                            <Button Grid.Column="2"
                                    Content="{loc:Loc Cancel}"
                                    Classes="secondary-button"
                                    Margin="0,0,12,0"
                                    Command="{Binding RequestCloseFilterModalCommand}" />
                            <Button Grid.Column="3"
                                    Content="{loc:Loc 'Apply Filters'}"
                                    Classes="primary-button"
                                    Command="{Binding ApplyFiltersCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>
</UserControl>

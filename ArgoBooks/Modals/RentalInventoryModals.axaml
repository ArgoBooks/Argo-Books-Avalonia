<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
             x:Class="ArgoBooks.Modals.RentalInventoryModals"
             x:DataType="vm:RentalInventoryModalsViewModel">

    <Design.DataContext>
        <vm:RentalInventoryModalsViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Add / Edit Rental Item Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsFormOpen, Mode=OneWay}"
                               ClosingCommand="{Binding RequestCloseFormCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="550"
                    MaxHeight="700">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0" Title="{Binding FormTitle}" CloseCommand="{Binding RequestCloseFormCommand}" />

                    <!-- Form Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="16">
                            <!-- Inventory Item -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{loc:Loc 'Inventory Item'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <controls:SearchableDropdown ItemsSource="{Binding AvailableInventoryItems}"
                                                            SelectedItem="{Binding ModalInventoryItem}"
                                                            DisplayMemberPath="DisplayText"
                                                            Placeholder="{loc:Loc 'Search inventory items...'}"
                                                            ShowAddNew="False"
                                                            EmptyMessage="{loc:Loc 'No inventory items available.'}"
                                                            EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                            EmptyCreateCommand="{Binding OpenCreateInventoryItemCommand}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding ModalInventoryItemError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding ModalInventoryItemError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Status, set only once the item exists -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsEditMode}">
                                <TextBlock Text="{loc:Loc Status}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding ModalStatus}" Classes="form-combobox">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Rates Section -->
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0">
                                <Run Text="{loc:Loc 'Rental Rates'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                            </TextBlock>

                            <!-- Daily and Weekly Rate Row -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Daily Rate'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding ModalDailyRate, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding ModalDailyRateError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                               IsVisible="{Binding ModalDailyRateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Weekly Rate'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding ModalWeeklyRate, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                </StackPanel>
                            </Grid>

                            <!-- Monthly Rate and Deposit Row -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Monthly Rate'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding ModalMonthlyRate, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Security Deposit'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding ModalSecurityDeposit, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                </StackPanel>
                            </Grid>

                            <!-- Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Notes}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ModalNotes, Mode=TwoWay}" Classes="form-input" PlaceholderText="{loc:Loc 'Enter notes'}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="120" MaxLength="500" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding RequestCloseFormCommand}" />
                            <Button Classes="primary-button" Content="{Binding FormSaveText}" Command="{Binding SaveFormCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Filter Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsFilterModalOpen}"
                               ClosingCommand="{Binding RequestCloseFilterModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="450">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'Filter Rental Items'}"
                                          CloseCommand="{Binding RequestCloseFilterModalCommand}" />

                    <!-- Form Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="20">
                            <!-- Status -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Status}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding FilterStatusOptions}" SelectedItem="{Binding FilterStatus}" Classes="form-combobox">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Availability -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Availability}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding FilterAvailability}" Classes="form-combobox">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Daily Rate Range -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Daily Rate'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Min'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterDailyRateMin, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00" behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Max'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterDailyRateMax, Mode=TwoWay}" Classes="form-input" PlaceholderText="0.00" behaviors:NumericInputBehavior.IsDecimalOnly="True" MaxLength="13" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Classes="secondary-button" Content="{loc:Loc 'Clear filters'}" Command="{Binding ClearFiltersCommand}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding RequestCloseFilterModalCommand}" />
                                <Button Classes="primary-button" Content="{loc:Loc Apply}" Command="{Binding ApplyFiltersCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Rent Out Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsRentOutModalOpen}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="550"
                    MaxHeight="700">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'Rent Out Item'}"
                                          CloseCommand="{Binding CloseRentOutModalCommand}">
                        <TextBlock Text="{Binding RentOutItemName}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </controls:ModalHeader>

                    <!-- Form Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="16">
                            <!-- Customer -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{loc:Loc Customer}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <controls:SearchableDropdown ItemsSource="{Binding AvailableCustomers}"
                                                            SelectedItem="{Binding RentOutCustomer}"
                                                            SearchText="{Binding RentOutCustomerText, Mode=TwoWay}"
                                                            DisplayMemberPath="Name"
                                                            SearchMemberPath="Id"
                                                            Placeholder="{loc:Loc 'Search customers...'}"
                                                            ShowAddNew="True"
                                                            AddNewText="{loc:Loc 'Create new customer'}"
                                                            AddNewCommand="{Binding OpenCreateCustomerCommand}"
                                                            EmptyMessage="{loc:Loc 'No customers available.'}"
                                                            EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                            EmptyCreateCommand="{Binding OpenCreateCustomerCommand}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding RentOutCustomerError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding RentOutCustomerError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Quantity and Available -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{loc:Loc Quantity}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                    </TextBlock>
                                    <TextBox Text="{Binding RentOutQuantity, Mode=TwoWay}" Classes="form-input"
                                             behaviors:NumericInputBehavior.IsIntegerOnly="True" MaxLength="7" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding RentOutQuantityError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                               IsVisible="{Binding RentOutQuantityError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'In Stock'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RentOutAvailableQuantity}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Padding="12,10" />
                                </StackPanel>
                            </Grid>

                            <!-- Rate Type and Amount -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Rate Type'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding RateTypeOptions}" SelectedItem="{Binding RentOutRateType}" Classes="form-combobox">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Rate Amount'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RentOutRateFormatted}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Padding="12,10" />
                                </StackPanel>
                            </Grid>

                            <!-- Start Date -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Start Date'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DatePicker SelectedDate="{Binding RentOutStartDate}" Classes="form-datepicker" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Due Date -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Due Date'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <DatePicker SelectedDate="{Binding RentOutDueDate}" Classes="form-datepicker" HorizontalAlignment="Stretch" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding RentOutDueDateError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           IsVisible="{Binding RentOutDueDateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding RentOutStartsLater}"
                                       Text="{loc:Loc 'This starts after today, so it is saved as a reservation. Its stock stays on the shelf until you check it out.'}" />

                            <!-- Security Deposit and Estimated Total -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Security Deposit'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RentOutDepositFormatted}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Padding="12,10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Estimated Total'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RentOutEstimatedTotal}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Padding="12,10" />
                                </StackPanel>
                            </Grid>

                            <!-- Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Notes}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding RentOutNotes, Mode=TwoWay}" Classes="form-input" PlaceholderText="{loc:Loc 'Enter notes'}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="100" MaxLength="500" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding CloseRentOutModalCommand}" />
                            <Button Classes="primary-button" Content="{loc:Loc 'Create Rental'}" Command="{Binding ConfirmRentOutCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>
</UserControl>

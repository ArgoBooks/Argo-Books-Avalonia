<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="ArgoBooks.Modals.ImportModal"
             x:DataType="vm:ImportModalViewModel">

    <Design.DataContext>
        <vm:ImportModalViewModel />
    </Design.DataContext>

    <controls:ModalOverlay IsOpen="{Binding IsOpen}">
        <controls:ModalOverlay.ModalContent>
            <Border Classes="modal-card"
                Width="500"
                MaxHeight="600">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <controls:ModalHeader Grid.Row="0"
                                      Title="{loc:Loc 'Import Data'}"
                                      Subtitle="{loc:Loc 'Import data from external files into Argo Books'}"
                                      CloseCommand="{Binding CloseCommand}" />

                <!-- Content -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20" Spacing="12">
                        <!-- Backup File -->
                        <Button Classes="import-option"
                                Command="{Binding SelectFormatCommand}"
                                CommandParameter="Backup">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{DynamicResource PrimaryIconBgBrush}"
                                        Margin="0,0,16,0">
                                    <PathIcon Data="{x:Static icons:Icons.Security}"
                                              Width="20" Height="20"
                                              Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{loc:Loc 'Backup File (.argobk)'}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'Open a previously exported backup as a new company'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <PathIcon Grid.Column="2"
                                          Data="{x:Static local:Icons.ChevronRightNav}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Spreadsheet (Excel / CSV) -->
                        <Button Classes="import-option"
                                Command="{Binding SelectFormatCommand}"
                                CommandParameter="Excel">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{DynamicResource PrimaryIconBgBrush}"
                                        Margin="0,0,16,0">
                                    <PathIcon Data="{x:Static icons:Icons.BarChartSquare}"
                                              Width="20" Height="20"
                                              Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{loc:Loc 'Spreadsheet'}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'Import data from Excel workbooks or CSV files'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <PathIcon Grid.Column="2"
                                          Data="{x:Static local:Icons.ChevronRightNav}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Bank Statement -->
                        <Button Classes="import-option"
                                Command="{Binding SelectFormatCommand}"
                                CommandParameter="BankStatement">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{DynamicResource PrimaryIconBgBrush}"
                                        Margin="0,0,16,0">
                                    <PathIcon Data="{x:Static icons:Icons.Bank}"
                                              Width="20" Height="20"
                                              Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{loc:Loc 'Bank Statement'}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc 'Match a bank statement against recorded transactions'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <PathIcon Grid.Column="2"
                                          Data="{x:Static local:Icons.ChevronRightNav}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Classes="modal-footer" Grid.Row="2">
                    <StackPanel Classes="modal-actions">
                        <Button Classes="secondary-button"
                                Content="{loc:Loc Cancel}"
                                Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>

    <UserControl.Styles>
        <!-- Import Option Button -->
        <Style Selector="Button.import-option">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.import-option /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.import-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.import-option:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.import-option:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>

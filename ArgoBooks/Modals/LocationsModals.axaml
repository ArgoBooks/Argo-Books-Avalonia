<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:local="using:ArgoBooks"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArgoBooks.Modals.LocationsModals"
             x:DataType="vm:LocationsModalsViewModel">

    <Panel>
        <!-- Add / Edit Location Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsFormOpen, Mode=OneWay}"
                               ClosingCommand="{Binding RequestCloseFormCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="600"
                    MaxHeight="750">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Modal Header -->
                    <controls:ModalHeader Grid.Row="0" Title="{Binding FormTitle}" CloseCommand="{Binding RequestCloseFormCommand}" />

                    <!-- Modal Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="16">
                            <!-- Location Name and Code -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{loc:Loc 'Location Name'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                    </TextBlock>
                                    <TextBox Text="{Binding ModalName, Mode=TwoWay}"
                                             Classes="form-input"
                                             PlaceholderText="{loc:Loc 'Enter location name'}"
                                             MaxLength="100" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding ModalNameError}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               IsVisible="{Binding ModalNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc Code}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding ModalCode, Mode=TwoWay}"
                                             Classes="form-input"
                                             PlaceholderText="{loc:Loc 'Auto-generated if empty'}"
                                             MaxLength="20"
                                             IsVisible="{Binding !IsEditMode}" />
                                    <!-- The code is the location's ID, so it can't change once saved -->
                                    <TextBox Text="{Binding ModalCode}"
                                             Classes="form-input"
                                             IsReadOnly="True"
                                             Background="{DynamicResource SurfaceAltBrush}"
                                             MaxLength="20"
                                             IsVisible="{Binding IsEditMode}" />
                                </StackPanel>
                            </Grid>

                            <!-- Type -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Type}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding TypeOptions}"
                                          SelectedItem="{Binding ModalType}"
                                          Classes="form-combobox"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <controls:AddressFields Heading="{loc:Loc Address}"
                                                    Street="{Binding ModalStreetAddress, Mode=TwoWay}"
                                                    Country="{Binding ModalCountry, Mode=TwoWay}"
                                                    Region="{Binding ModalStateProvince, Mode=TwoWay}"
                                                    City="{Binding ModalCity, Mode=TwoWay}"
                                                    PostalCode="{Binding ModalPostalCode, Mode=TwoWay}" />

                            <!-- Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Notes}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ModalNotes, Mode=TwoWay}"
                                         Classes="form-input"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"
                                         MaxHeight="120"
                                         PlaceholderText="{loc:Loc 'Enter notes'}"
                                         MaxLength="500" />
                            </StackPanel>

                            <!-- Error Message -->
                            <TextBlock TextWrapping="Wrap" Text="{Binding ModalError}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       IsVisible="{Binding ModalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding RequestCloseFormCommand}" />
                            <Button Classes="primary-button" Content="{Binding FormSaveText}" Command="{Binding SaveFormCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Filter Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsFilterModalOpen}"
                               ClosingCommand="{Binding RequestCloseFilterModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="400">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Modal Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'Filter Locations'}"
                                          CloseCommand="{Binding RequestCloseFilterModalCommand}" />

                    <!-- Modal Content -->
                    <StackPanel Grid.Row="1" Margin="24" Spacing="16">
                        <!-- Type Filter -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Type}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding FilterTypeOptions}"
                                      SelectedItem="{Binding FilterType}"
                                      Classes="form-combobox"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Loc Status}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding FilterStatusOptions}"
                                      SelectedItem="{Binding FilterStatus}"
                                      Classes="form-combobox"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Modal Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Classes="secondary-button" Content="{loc:Loc 'Clear filters'}" Command="{Binding ClearFiltersCommand}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                <Button Classes="secondary-button" Content="{loc:Loc Cancel}" Command="{Binding RequestCloseFilterModalCommand}" />
                                <Button Classes="primary-button" Content="{loc:Loc Apply}" Command="{Binding ApplyFiltersCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>
</UserControl>

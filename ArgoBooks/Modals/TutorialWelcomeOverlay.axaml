<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:local="using:ArgoBooks"
             xmlns:controls="using:ArgoBooks.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ArgoBooks.Modals.TutorialWelcomeOverlay"
             x:DataType="vm:TutorialWelcomeViewModel">

    <Design.DataContext>
        <vm:TutorialWelcomeViewModel />
    </Design.DataContext>

    <!-- The card closes only through its own buttons. -->
    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           CloseOnBackdropClick="False"
                           CloseOnEscape="False">
        <controls:ModalOverlay.ModalContent>
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0"
                CornerRadius="16"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 16 48 0 #50000000"
                ClipToBounds="True">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header with gradient -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="32,40">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <!-- Logo Icon -->
                        <Border Width="72" Height="72"
                                CornerRadius="36"
                                Background="#33FFFFFF"
                                HorizontalAlignment="Center">
                            <PathIcon Data="{x:Static local:Icons.Dashboard}"
                                      Width="36" Height="36"
                                      Foreground="White" />
                        </Border>

                        <!-- Welcome Text -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Welcome to Argo Books'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc 'How would you like to add your first transactions?'}"
                                       FontSize="14"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The ways to add a first transaction, the quickest first -->
                <StackPanel Grid.Row="1"
                            Spacing="10"
                            Margin="24,24">
                    <StackPanel.Styles>
                        <Style Selector="Button.first-step">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,12" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style Selector="Button.first-step:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Style>
                    </StackPanel.Styles>

                    <Button Classes="first-step" Command="{Binding ChooseScanReceiptCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,14,0">
                                <PathIcon Data="{x:Static local:Icons.ScanReceipt}" Width="20" Height="20"
                                          Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc 'Scan a receipt'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Pick a photo or PDF of a receipt and the expense is filled in for you'}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="first-step" Command="{Binding ChooseBankStatementCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource SuccessLightBrush}" Margin="0,0,14,0">
                                <PathIcon Data="{x:Static local:Icons.Bank}" Width="20" Height="20"
                                          Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc 'Import a bank statement'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Bring in a month of transactions at once from your bank'}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="first-step" Command="{Binding ChooseImportCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource WarningLightBrush}" Margin="0,0,14,0">
                                <PathIcon Data="{x:Static local:Icons.ImportData}" Width="20" Height="20"
                                          Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc 'Import from QuickBooks or a spreadsheet'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Move over the records you already keep'}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="first-step" Command="{Binding ChooseManualCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,14,0">
                                <PathIcon Data="{x:Static local:Icons.Edit}" Width="20" Height="20"
                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc 'Add one by hand'}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Type in an expense yourself'}"
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer: leave without picking -->
                <Border Grid.Row="2"
                        Padding="24,16"
                        CornerRadius="0,0,16,16"
                        Background="{DynamicResource BackgroundSecondaryBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="text-button lg"
                                Content="{loc:Loc 'I','ll look around first'}"
                                Command="{Binding SkipTutorialCommand}"
                                HorizontalAlignment="Left" />

                        <Button Grid.Column="1"
                                Classes="text-button lg"
                                Content="{loc:Loc 'Take a tour'}"
                                Command="{Binding StartTourCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:local="using:ArgoBooks"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="ArgoBooks.Modals.UpgradeModal"
             x:DataType="vm:UpgradeModalViewModel">

    <Design.DataContext>
        <vm:UpgradeModalViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Upgrade Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsOpen}" ClosingCommand="{Binding CloseCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="780"
                    MaxHeight="860"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0"
                            Padding="24,20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc 'Upgrade Your Plan'}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Grid.Column="1"
                                    Classes="icon-button"
                                    Command="{Binding CloseCommand}">
                                <PathIcon Data="{x:Static local:Icons.Close}"
                                          Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <Panel>
                            <!-- Loading Spinner -->
                            <controls:LoadingState IsVisible="{Binding IsLoadingPlans}"
                                                   Message="{loc:Loc 'Loading plans...'}"
                                                   ShowProgress="True"
                                                   IsIndeterminate="True"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="48" />

                            <!-- Offline Message -->
                            <StackPanel IsVisible="{Binding IsOffline}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12"
                                        Margin="48">
                                <PathIcon Data="{x:Static local:Icons.WifiOff}"
                                          Width="48" Height="48"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'No Connection'}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Unable to load plan details. Please check your internet connection and try again.'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="360" />
                            </StackPanel>

                            <!-- Load Error Message -->
                            <StackPanel IsVisible="{Binding HasLoadError}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12"
                                        Margin="48">
                                <PathIcon Data="{x:Static local:Icons.LostDamaged}"
                                          Width="48" Height="48"
                                          Foreground="{DynamicResource ErrorBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Unable to Load Plans'}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Could not load plan details from the server. Please try again later.'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="360" />
                            </StackPanel>

                            <!-- Plan Cards (only shown when loaded successfully).
                                 Layout mirrors the website's pricing cards (partials/pricing-cards.php):
                                 chip + "Plan", pitch, price block, CTA, list lead-in, features. -->
                            <StackPanel Margin="24,16,24,24" Spacing="20" IsVisible="{Binding ShowPlans}">

                                <!-- Billing cycle toggle (above both cards, centered) -->
                                <Border Classes="cycle-toggle" HorizontalAlignment="Center">
                                    <!-- UniformGrid, not a star Grid: the toggle is centered so it sizes to
                                         its content, and star columns only share out space that is given. -->
                                    <UniformGrid Columns="2">
                                        <Button Classes="cycle-option"
                                                Classes.active="{Binding IsMonthlyBilling}"
                                                Command="{Binding SelectMonthlyBillingCommand}"
                                                Content="{loc:Loc Monthly}" />
                                        <Button Classes="cycle-option"
                                                Classes.active="{Binding IsYearlyBilling}"
                                                Command="{Binding SelectYearlyBillingCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Annual}" VerticalAlignment="Center" />
                                                <Border Classes="save-pill"
                                                        IsVisible="{Binding YearlySavingsDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding YearlySavingsDisplay}" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Border>

                                <!-- Cards row. Top margin leaves room for the Premium card's
                                     "Recommended" flag, which rides above its top edge. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,10,0,0">
                                <!-- Free Plan -->
                                <Border Classes="plan-card" Width="340" IsVisible="{Binding !HasPremium}">
                                    <StackPanel>
                                        <!-- Plan name: chip + "Plan" -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="plan-chip">
                                                <TextBlock Text="{Binding FreeChip}" />
                                            </Border>
                                            <TextBlock Classes="plan-name" Text="{loc:Loc Plan}" />
                                        </StackPanel>

                                        <!-- Pitch -->
                                        <TextBlock Classes="plan-pitch" Text="{Binding FreePlanPitch}" />

                                        <!-- Price -->
                                        <StackPanel Classes="price-block">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Classes="price-currency" Text="$" />
                                                <TextBlock Classes="price-amount" Text="0" />
                                            </StackPanel>
                                            <!-- Invisible copy of the Premium card's struck-out line, so
                                                 both price blocks are the same height. -->
                                            <TextBlock Classes="price-strike"
                                                       Text="{Binding PremiumStrikeText}"
                                                       Opacity="0"
                                                       IsHitTestVisible="False" />
                                            <TextBlock Classes="price-billed" Text="{loc:Loc 'Free forever'}" />
                                        </StackPanel>

                                        <!-- CTA row. The free plan is what the user is already on, so this
                                             states that rather than offering a download link like the website. -->
                                        <Border Classes="plan-cta-static">
                                            <TextBlock Text="{loc:Loc 'Current Plan'}" />
                                        </Border>

                                        <!-- Counterpart to the Premium card's lead-in: no text, but it carries
                                             the divider and keeps both feature lists starting level. -->
                                        <Border Classes="plan-plus">
                                            <TextBlock Classes="plan-plus-text" Text=" " />
                                        </Border>

                                        <!-- Features (from API) -->
                                        <ItemsControl ItemsSource="{Binding FreePlanFeatures}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="feature-item">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <PathIcon Grid.Column="0"
                                                                      Data="{x:Static local:Icons.Check}"
                                                                      Width="14" Height="14"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                                      Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Premium Plan -->
                                <Panel Width="340">
                                    <Border Classes="plan-card plan-card-premium">
                                    <StackPanel>
                                        <!-- Plan name: chip + "Plan" -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Border Classes="plan-chip plan-chip-premium">
                                                    <TextBlock Text="{Binding PremiumChip}" />
                                                </Border>
                                                <TextBlock Classes="plan-name" Text="{loc:Loc Plan}" />
                                            </StackPanel>

                                            <!-- Active Badge (when has Premium) -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowPremiumActive}">
                                                <TextBlock Text="{loc:Loc Active}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>

                                        <!-- Pitch -->
                                        <TextBlock Classes="plan-pitch" Text="{Binding PremiumPlanPitch}" />

                                        <!-- Price. One block for both cycles rather than two swapped blocks:
                                             only the number and the line below it change, and the struck-out
                                             line always occupies its row (hidden on monthly), so switching
                                             cycle never shifts the CTA underneath. -->
                                        <StackPanel Classes="price-block">
                                            <!-- Only the figures slide on a cycle switch. The billing note
                                                 below sits outside this panel so it stays put. -->
                                            <StackPanel x:Name="PremiumPriceBlock" Spacing="2">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform X="0" />
                                                </StackPanel.RenderTransform>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Classes="price-currency price-premium" Text="$" />
                                                    <TextBlock Classes="price-amount price-premium"
                                                               Text="{Binding PremiumAmountDisplay}" />
                                                    <TextBlock Classes="price-period price-premium"
                                                               Text="{Binding PremiumBillingPeriod}" />
                                                </StackPanel>
                                                <TextBlock Classes="price-strike"
                                                           Text="{Binding PremiumStrikeText}"
                                                           IsVisible="{Binding IsYearlyBilling}" />
                                                <!-- Holds the strike line's row without showing it, so the
                                                     monthly view is exactly as tall as the annual one. -->
                                                <TextBlock Classes="price-strike"
                                                           Text="{Binding PremiumStrikeText}"
                                                           IsVisible="{Binding IsMonthlyBilling}"
                                                           Opacity="0"
                                                           IsHitTestVisible="False" />
                                            </StackPanel>
                                            <TextBlock Classes="price-billed" Text="{Binding PremiumBilledText}" />
                                        </StackPanel>

                                        <!-- CTA -->
                                        <Button Classes="primary-button plan-cta"
                                                Command="{Binding SelectPremiumCommand}"
                                                Content="{loc:Loc 'Buy now'}"
                                                IsVisible="{Binding ShowSelectPremium}" />
                                        <Button Classes="secondary-button plan-cta"
                                                Command="{Binding CancelSubscriptionCommand}"
                                                Content="{loc:Loc 'Manage Subscription'}"
                                                IsVisible="{Binding ShowCancelPremium}" />

                                        <!-- Feature list lead-in -->
                                        <Border Classes="plan-plus plan-plus-premium">
                                            <TextBlock Classes="plan-plus-text"
                                                       Text="{loc:Loc 'Everything in Free, plus...'}" />
                                        </Border>

                                        <!-- Features (from API) -->
                                        <ItemsControl ItemsSource="{Binding PremiumPlanFeatures}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="feature-item">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <PathIcon Grid.Column="0"
                                                                      Data="{x:Static local:Icons.Check}"
                                                                      Width="14" Height="14"
                                                                      Foreground="{DynamicResource PrimaryBrush}"
                                                                      Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Border>

                                    <!-- "Recommended" flag riding the card's top edge -->
                                    <Border Classes="plan-badge">
                                        <TextBlock Text="{loc:Loc Recommended}" />
                                    </Border>
                                </Panel>
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                            Padding="24,20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            IsVisible="{Binding ShowPlans}">
                        <Button Classes="primary-button"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                Command="{Binding OpenEnterKeyCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Key}"
                                          Width="16" Height="16" />
                                <TextBlock Text="{loc:Loc 'Enter a Key'}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- Enter Key Modal -->
        <controls:ModalOverlay IsOpen="{Binding IsEnterKeyModalOpen}" ClosingCommand="{Binding RequestCloseEnterKeyCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="420"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">

                <Panel>
                    <!-- Normal Entry View -->
                    <Grid RowDefinitions="Auto,*,Auto"
                          IsVisible="{Binding ShowKeyEntryForm}">
                        <!-- Header -->
                        <Border Grid.Row="0"
                                Padding="24,20"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc 'Enter License Key'}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Grid.Column="1"
                                        Classes="icon-button"
                                        Command="{Binding CloseEnterKeyCommand}">
                                    <PathIcon Data="{x:Static icons:Icons.Close}"
                                              Width="20" Height="20" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Body -->
                        <StackPanel Grid.Row="1" Margin="24" Spacing="16">
                            <TextBlock Text="{loc:Loc 'Enter your license key to activate your premium features.'}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'License Key'}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="LicenseKeyTextBox"
                                         Text="{Binding LicenseKey, Mode=TwoWay}"
                                         PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX"
                                         MaxLength="24"
                                         TextChanged="LicenseKeyTextBox_TextChanged"
                                         Classes="form-input license-key" />
                            </StackPanel>
                            
                            <TextBlock Text="{Binding VerificationError}"
                                       FontSize="13"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding VerificationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        
                        <!-- Footer -->
                        <Border Grid.Row="2"
                                Padding="24,16"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Grid.Column="0"
                                        Classes="secondary-button"
                                        Command="{Binding GoBackToUpgradeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{x:Static icons:Icons.ChevronLeft}"
                                                  Width="14" Height="14" />
                                        <TextBlock Text="{loc:Loc Back}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="primary-button"
                                        HorizontalAlignment="Right"
                                        Command="{Binding VerifyKeyCommand}"
                                        IsEnabled="{Binding !IsVerifying}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{x:Static local:Icons.Check}"
                                                  Width="16" Height="16"
                                                  IsVisible="{Binding !IsVerifying}" />
                                        <TextBlock Text="{loc:Loc 'Verify Key'}" IsVisible="{Binding !IsVerifying}" />
                                        <TextBlock Text="{loc:Loc 'Verifying...'}" IsVisible="{Binding IsVerifying}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Success Animation View -->
                    <!-- Email capture. Only shown for a key the server holds no address for,
                         which means a batch sold through a reseller. Premium is already active
                         by the time this appears: this step collects a contact address, it does
                         not stand between the customer and what they paid for. -->
                    <StackPanel IsVisible="{Binding IsEmailCaptureStep}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="20"
                                MaxWidth="380"
                                Margin="48">
                        <PathIcon Data="{x:Static local:Icons.Check}"
                                  Width="40" Height="40"
                                  Foreground="{DynamicResource SuccessBrush}"
                                  HorizontalAlignment="Center" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc 'Premium is active'}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc 'Where should we send your receipt? We use this to reach you about your licence, and to help if you ever move it to another computer.'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBox Text="{Binding CustomerEmail, Mode=TwoWay}"
                                     Classes="form-input"
                                     PlaceholderText="you@example.com"
                                     MaxLength="255" />
                            <TextBlock Text="{Binding EmailError}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <Button Classes="primary-button"
                                Content="{loc:Loc Continue}"
                                Command="{Binding SubmitEmailCommand}"
                                IsEnabled="{Binding !IsSubmittingEmail}"
                                HorizontalAlignment="Center"
                                Padding="32,12" />
                    </StackPanel>

                    <!-- Dismiss for the email step. The backdrop deliberately does nothing here (see RequestCloseEnterKey). -->
                    <Button Classes="icon-button"
                            IsVisible="{Binding IsEmailCaptureStep}"
                            Command="{Binding SkipEmailCaptureCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            ToolTip.Tip="{loc:Loc 'Maybe later'}">
                        <PathIcon Data="{x:Static icons:Icons.Close}"
                                  Width="18" Height="18" />
                    </Button>

                    <StackPanel IsVisible="{Binding IsVerificationSuccess}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="24"
                                Margin="48">
                        <!-- Animated Success Circle with Glow -->
                        <Panel HorizontalAlignment="Center">
                            <!-- Glow effect behind the circle -->
                            <Border x:Name="SuccessGlow"
                                    Width="120" Height="120"
                                    CornerRadius="60"
                                    Opacity="0.4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{StaticResource SuccessColor}" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Border.RenderTransform>
                            </Border>
                            <!-- Main circle -->
                            <Border x:Name="SuccessCircle"
                                    Width="100" Height="100"
                                    CornerRadius="50"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"
                                    BoxShadow="0 4 20 0 #4022C55E">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="{StaticResource SuccessColor}" Offset="0" />
                                        <GradientStop Color="#16A34A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Border.RenderTransform>
                                <PathIcon Data="{x:Static local:Icons.Check}"
                                          Width="48" Height="48"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                        </Panel>

                        <!-- Success Text -->
                        <StackPanel x:Name="SuccessTextPanel" Spacing="8" HorizontalAlignment="Center" Opacity="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="20" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{loc:Loc 'License Activated!'}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SuccessMessage}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="300" />
                        </StackPanel>

                        <!-- Continue Button (appears after 2 seconds with animation) -->
                        <Panel x:Name="ContinueButtonPanel"
                               HorizontalAlignment="Center"
                               Opacity="0"
                               IsHitTestVisible="{Binding ShowContinueButton}">
                            <Panel.RenderTransform>
                                <TranslateTransform Y="20" />
                            </Panel.RenderTransform>
                            <Button Classes="primary-button"
                                    Content="{loc:Loc Continue}"
                                    Command="{Binding ContinueAfterSuccessCommand}"
                                    HorizontalAlignment="Center"
                                    Padding="32,12" />
                        </Panel>
                    </StackPanel>
                </Panel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

    </Panel>

    <UserControl.Styles>
        <!-- Plan Card -->
        <Style Selector="Border.plan-card">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Premium card: accented border, no fill -->
        <Style Selector="Border.plan-card-premium">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- "Recommended" flag riding the Premium card's top edge -->
        <Style Selector="Border.plan-badge">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-11,0,0" />
        </Style>
        <Style Selector="Border.plan-badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Plan name row: "FREE" / "PREMIUM" chip beside the word "Plan" -->
        <Style Selector="Border.plan-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.plan-chip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.plan-chip-premium">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="Border.plan-chip-premium TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.plan-name">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One-line pitch under the plan name. The fixed minimum height keeps the
             price blocks level across both cards when the two pitches wrap to a
             different number of lines. -->
        <Style Selector="TextBlock.plan-pitch">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="MinHeight" Value="57" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <!-- Price block: amount row, struck-out reference price, billing note -->
        <Style Selector="StackPanel.price-block">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="Margin" Value="0,14,0,18" />
        </Style>
        <Style Selector="TextBlock.price-currency">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.price-amount">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="TextBlock.price-period">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="3,0,0,5" />
        </Style>
        <Style Selector="TextBlock.price-premium">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.price-strike">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBlock.price-billed">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Full-width CTA above the feature list -->
        <Style Selector="Button.plan-cta">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The Free card's CTA row. Not a button: the user is already on this plan,
             so it states that rather than offering something to click. -->
        <Style Selector="Border.plan-cta-static">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,11" />
        </Style>
        <Style Selector="Border.plan-cta-static TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- "Everything in Free, plus..." lead-in, and the Free card's silent
             counterpart which carries the same divider so both lists start level. -->
        <Style Selector="Border.plan-plus">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,22,0,0" />
            <Setter Property="Padding" Value="0,18,0,0" />
        </Style>
        <Style Selector="Border.plan-plus-premium">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.plan-plus-text">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Billing cycle toggle (monthly | annual) -->
        <Style Selector="Border.cycle-toggle">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style Selector="Button.cycle-option">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- The border is reserved on both options, transparent until selected, so switching never
             shifts the text by a pixel. -->
        <Style Selector="Button.cycle-option /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.cycle-option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <Style Selector="Button.cycle-option.active">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- A hairline border rather than a BoxShadow: at this small corner radius the shadow's edge
             bled into the corners and tinted them. -->
        <Style Selector="Button.cycle-option.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <!-- "Save $X" pill on the annual toggle button. Tinted only while that
             option is active, so the inactive tab stays visually quiet. The idle
             fill is SurfacePressed rather than SurfaceAlt, which is the same colour
             as the toggle track in the dark theme and left the pill invisible. -->
        <Style Selector="Border.save-pill">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.save-pill TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.cycle-option.active Border.save-pill">
            <Setter Property="Background" Value="{DynamicResource PrimaryIconBgBrush}" />
        </Style>

        <Style Selector="Button.cycle-option.active Border.save-pill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Feature Item -->
        <Style Selector="Border.feature-item">
            <Setter Property="Padding" Value="0,7" />
        </Style>
        <Style Selector="Border.feature-item TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBox.license-key">
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LetterSpacing" Value="2" />
        </Style>

        <!-- Outline Button -->
        <Style Selector="Button.outline-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.outline-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.outline-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.outline-button PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>

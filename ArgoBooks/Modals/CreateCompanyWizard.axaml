<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="600"
             x:Class="ArgoBooks.Modals.CreateCompanyWizard"
             x:DataType="vm:CreateCompanyViewModel">

    <Design.DataContext>
        <vm:CreateCompanyViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Password field with a reveal button, matching Settings > Security. The TextBox
             sits inside a bordered Grid alongside the button, so it draws no border itself. -->
        <Style Selector="TextBox.password-field">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <!-- PasswordChar is bound per field, not set here, so revealing can clear it. -->
        </Style>
        <Style Selector="TextBox.password-field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.eye-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.eye-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.eye-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.eye-toggle PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Strength meter. A ProgressBar rather than a fixed-width bar, so it fills whatever
             width the wizard gives it instead of needing a hardcoded pixel count. -->
        <Style Selector="ProgressBar.strength-meter">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="ProgressBar.strength-meter /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="ProgressBar.strength-weak /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="ProgressBar.strength-fair /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="ProgressBar.strength-strong /template/ Border#PART_Indicator">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="TextBlock.strength-weak">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.strength-fair">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.strength-strong">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                               ClosingCommand="{Binding CloseCommand}">
            <controls:ModalOverlay.ModalContent>
                <!-- Wizard Container -->
                <Border Classes="modal-card"
                Width="620"
                MaxHeight="750">

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <controls:ModalHeader Grid.Row="0" Title="{loc:Loc 'Create New Company'}" CloseCommand="{Binding CloseCommand}">
                    <TextBlock Text="{Binding CurrentStep, StringFormat='Step {0} of 2'}"
                               FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </controls:ModalHeader>

                <!-- Step Indicators -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,-16"
                            Spacing="8">
                    <!-- Step 1 -->
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource PrimaryBrush}"
                            IsVisible="{Binding IsStep1}">
                        <TextBlock Text="1" Foreground="White" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource SurfaceAltBrush}"
                            IsVisible="{Binding !IsStep1}">
                        <TextBlock Text="1" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border Width="40" Height="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" />

                    <!-- Step 2 -->
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource PrimaryBrush}"
                            IsVisible="{Binding IsStep2}">
                        <TextBlock Text="2" Foreground="White" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource SurfaceAltBrush}"
                            IsVisible="{Binding !IsStep2}">
                        <TextBlock Text="2" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,32,24,24">
                        <!-- Step 1: Company Info -->
                        <StackPanel IsVisible="{Binding IsStep1}" Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc 'Company Information'}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Enter your company''s basic information'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>

                            <!-- Company Name and Default Currency (side by side) -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Company Name'}" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                    </StackPanel>
                                    <TextBox Text="{Binding CompanyName, Mode=TwoWay}"
                                             Classes="form-input"
                                             PlaceholderText="{loc:Loc 'Enter company name'}"
                                             MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc 'Default Currency'}" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Currencies}"
                                              SelectedItem="{Binding SelectedCurrency}"
                                              Classes="form-combobox"
                                              PlaceholderText="{loc:Loc 'Select currency'}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <!-- Two column layout for other fields -->
                            <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto,16,Auto">
                                <!-- Business Type -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Business Type'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding BusinessTypes}"
                                              SelectedItem="{Binding BusinessType}"
                                              Classes="form-combobox"
                                              PlaceholderText="{loc:Loc 'Select business type'}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Industry -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc Industry}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding Industries}"
                                              SelectedItem="{Binding Industry}"
                                              Classes="form-combobox"
                                              PlaceholderText="{loc:Loc 'Select industry'}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Phone Number -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc 'Phone Number'}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:PhoneInput SelectedCountry="{Binding SelectedPhoneCountry, Mode=TwoWay}"
                                                         PhoneNumber="{Binding PhoneNumber, Mode=TwoWay}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding PhoneNumberError}" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                               IsVisible="{Binding PhoneNumberError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc Email}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding Email, Mode=TwoWay}"
                                             PlaceholderText="{loc:Loc 'Enter email address'}"
                                             MaxLength="200" />
                                </StackPanel>

                                <!-- Country -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc Country}" />
                                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" Text=" *" />
                                    </StackPanel>
                                    <controls:CountryInput SelectedCountryName="{Binding Country, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Province / State -->
                                <StackPanel Grid.Row="4" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{Binding Country, Converter={x:Static controls:RegionInput.LabelConverter}}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:RegionInput Country="{Binding Country}" Value="{Binding ProvinceState, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- City -->
                                <StackPanel Grid.Row="6" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc City}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding City, Mode=TwoWay}"
                                             PlaceholderText="{loc:Loc 'Enter city'}"
                                             MaxLength="100" />
                                </StackPanel>

                                <!-- Address -->
                                <StackPanel Grid.Row="6" Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc Address}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding Address, Mode=TwoWay}"
                                             PlaceholderText="{loc:Loc 'Enter address'}"
                                             MaxLength="200" />
                                </StackPanel>

                            </Grid>
                        </StackPanel>

                        <!-- Step 2: Security & Logo -->
                        <StackPanel IsVisible="{Binding IsStep2}" Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc 'Security &amp; Branding'}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Protect your data and add your company logo'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>

                            <!-- Logo Upload -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc 'Company Logo'}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Logo Preview -->
                                    <Border Grid.Column="0"
                                            Width="100" Height="100"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            Margin="0,0,16,0">
                                        <Panel>
                                            <PathIcon Data="{x:Static icons:Icons.GridDetailed}"
                                                      Width="40" Height="40"
                                                      Foreground="{DynamicResource TextTertiaryBrush}"
                                                      IsVisible="{Binding !HasLogo}" />
                                            <Image Source="{Binding LogoSource}"
                                                   Stretch="Uniform"
                                                   IsVisible="{Binding HasLogo}" />
                                        </Panel>
                                    </Border>

                                    <!-- Upload Buttons -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                        <Button Classes="secondary-button"
                                                Command="{Binding BrowseLogoCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{x:Static icons:Icons.ImportData}"
                                                          Width="16" Height="16" />
                                                <TextBlock Text="{loc:Loc 'Upload Logo'}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="text-button"
                                                Command="{Binding RemoveLogoCommand}"
                                                IsVisible="{Binding HasLogo}">
                                            <TextBlock Text="{loc:Loc Remove}" Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                        <TextBlock Text="{loc:Loc 'PNG, JPG up to 5MB'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Password Protection -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding EnablePassword}"
                                              Content="{loc:Loc 'Password protect this company file'}" />

                                    <StackPanel IsVisible="{Binding EnablePassword}" Spacing="16">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{loc:Loc Password}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Password, Mode=TwoWay}"
                                                             PasswordChar="{Binding PasswordMaskChar}"
                                                             Classes="password-field"
                                                             PlaceholderText="{loc:Loc 'Enter password'}"
                                                             MaxLength="128" />
                                                    <Button Grid.Column="1"
                                                            Classes="eye-toggle"
                                                            Command="{Binding TogglePasswordVisibilityCommand}">
                                                        <PathIcon Data="{Binding PasswordVisibilityIcon}" Width="16" Height="16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowPasswordStrength}">
                                                <ProgressBar Grid.Column="0"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding PasswordStrengthScore}"
                                                             VerticalAlignment="Center"
                                                             Classes="strength-meter"
                                                             Classes.strength-weak="{Binding IsStrengthWeak}"
                                                             Classes.strength-fair="{Binding IsStrengthFair}"
                                                             Classes.strength-strong="{Binding IsStrengthStrong}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PasswordStrengthText}"
                                                           FontSize="11"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Classes.strength-weak="{Binding IsStrengthWeak}"
                                                           Classes.strength-fair="{Binding IsStrengthFair}"
                                                           Classes.strength-strong="{Binding IsStrengthStrong}" />
                                            </Grid>
                                            <TextBlock Text="{loc:Loc 'At least 8 characters, including a letter and a number.'}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding PasswordRequirementError}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       IsVisible="{Binding ShowPasswordRequirementError}" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{loc:Loc 'Confirm password'}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                                             PasswordChar="{Binding ConfirmPasswordMaskChar}"
                                                             Classes="password-field"
                                                             PlaceholderText="{loc:Loc 'Confirm password'}"
                                                             MaxLength="128" />
                                                    <Button Grid.Column="1"
                                                            Classes="eye-toggle"
                                                            Command="{Binding ToggleConfirmPasswordVisibilityCommand}">
                                                        <PathIcon Data="{Binding ConfirmPasswordVisibilityIcon}" Width="16" Height="16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{loc:Loc 'Passwords do not match'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       IsVisible="{Binding ShowPasswordError}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Classes="modal-footer" Grid.Row="2">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Back Button -->
                        <Button Grid.Column="0"
                                Classes="secondary-button"
                                Command="{Binding PreviousStepCommand}"
                                IsVisible="{Binding CanGoBack}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.ArrowBack}"
                                          Width="16" Height="16" />
                                <TextBlock Text="{loc:Loc Back}" />
                            </StackPanel>
                        </Button>

                        <!-- Cancel (only on first step) -->
                        <Button Grid.Column="0"
                                Classes="secondary-button"
                                Command="{Binding CloseCommand}"
                                IsVisible="{Binding !CanGoBack}"
                                Content="{loc:Loc Cancel}" />

                        <!-- Next / Create Button -->
                        <Button Grid.Column="2"
                                Classes="primary-button"
                                Command="{Binding NextStepCommand}"
                                IsVisible="{Binding CanGoNext}"
                                IsEnabled="{Binding IsStep1Valid}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc Next}" />
                                <PathIcon Data="{x:Static icons:Icons.ArrowForward}"
                                          Width="16" Height="16" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary-button"
                                Command="{Binding CreateCompanyCommand}"
                                IsVisible="{Binding IsLastStep}"
                                IsEnabled="{Binding CanCreate}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Check}"
                                          Width="16" Height="16" />
                                <TextBlock Text="{loc:Loc 'Create Company'}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>
</UserControl>

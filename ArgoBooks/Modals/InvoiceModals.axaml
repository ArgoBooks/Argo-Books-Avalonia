<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:icons="using:ArgoBooks"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="ArgoBooks.Modals.InvoiceModals"
             x:DataType="vm:InvoiceModalsViewModel">

    <Design.DataContext>
        <vm:InvoiceModalsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Borderless "invoice text" inputs on the white paper -->
        <Style Selector="TextBox.paper">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1A1F2B" />
            <Setter Property="CaretBrush" Value="#1A1F2B" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
        <Style Selector="NumericUpDown.paper">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1A1F2B" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBlock.sidebar-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ======================= CREATE / EDIT INVOICE EDITOR (big modal) ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsCreateEditModalOpen}"
                               ClosingCommand="{Binding RequestCloseCreateEditModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Panel>
                <!-- Big editor. Hidden on success / sending so those show as a normal-sized card below. -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Width="1040"
                        MaxWidth="{Binding $parent[controls:ModalOverlay].AvailableWidth}"
                        Margin="0,32"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        ClipToBounds="True"
                        BoxShadow="0 8 32 0 #40000000">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsShowingSuccess" />
                            <Binding Path="!IsSending" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="20,14"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding ModalTitle}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon-button" Command="{Binding CloseCreateEditModalCommand}">
                                    <PathIcon Data="{x:Static icons:Icons.Close}" Width="20" Height="20" />
                                </Button>
                            </Grid>
                        </Border>

                        <controls:InfoBanner Grid.Row="1"
                                             ShowBanner="{Binding ShowCompanyDetailsPrompt}"
                                             IsVisible="{Binding ShowCompanyDetailsPrompt}"
                                             BannerMargin="0"
                                             Margin="20,12,20,0"
                                             Message="{loc:Loc 'Your address, phone and email are blank on this invoice.'}"
                                             ActionText="{loc:Loc 'Add them'}"
                                             ActionCommand="{Binding EditCompanyDetailsCommand}"
                                             IconData="{x:Static icons:Icons.Info}"
                                             BannerBackground="{DynamicResource InfoBrush}" />

                        <!-- Body -->
                        <Grid Grid.Row="2">

                            <!-- EDITOR: paper + sidebar (create / continue) -->
                            <Grid ColumnDefinitions="*,320">
                                <Grid.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!IsViewOnly" />
                                        <Binding Path="!IsShowingSuccess" />
                                        <Binding Path="!IsSending" />
                                    </MultiBinding>
                                </Grid.IsVisible>

                                <!-- PAPER: the real customer-facing invoice HTML, edited in place -->
                                <controls:InvoicePreviewControl x:Name="EditorPreview"
                                                                Grid.Column="0"
                                                                Html="{Binding PreviewHtml}"
                                                                IsEditable="{Binding !IsEditorPreviewing}"
                                                                ProductsJson="{Binding ProductsJson}"
                                                                CustomersJson="{Binding CustomersJson}"
                                                                TotalsConfigJson="{Binding TotalsConfigJson}"
                                                                OpenInBrowserCommand="{Binding OpenPreviewInBrowserCommand}">
                                    <controls:InvoicePreviewControl.IsVisible>
                                        <!-- Also hidden on success / while sending so the native WebView (which renders
                                             above Avalonia content) doesn't cover the success + sending overlays. -->
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsCreateEditModalOpen" />
                                            <Binding Path="!IsViewOnly" />
                                            <Binding Path="!IsNestedModalOpen" />
                                            <Binding Path="!IsShowingSuccess" />
                                            <Binding Path="!IsSending" />
                                        </MultiBinding>
                                    </controls:InvoicePreviewControl.IsVisible>
                                </controls:InvoicePreviewControl>

                                <!-- SIDEBAR -->
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                    <!-- HorizontalScrollBarVisibility=Disabled so content is measured at the fixed
                                         sidebar width and wraps, instead of a long validation message forcing the
                                         whole modal to scroll sideways. -->
                                    <!-- Going back is not one of the actions, so it sits on the floor of the
                                         panel rather than under whatever the fields happen to end at. -->
                                    <Grid RowDefinitions="*,Auto">
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="16" Spacing="16">

                                            <Border IsVisible="{Binding !IsPortalReady}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="Auto,8,*">
                                                        <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Info}" Width="14" Height="14"
                                                                  Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                        <TextBlock Grid.Column="2" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{loc:Loc 'Sending an invoice needs the payment portal set up first. You can still save this one as a draft.'}" />
                                                    </Grid>
                                                    <Button Classes="secondary-button" HorizontalAlignment="Stretch"
                                                            Content="{loc:Loc 'Set up payment portal'}"
                                                            Command="{Binding SetUpPaymentPortalCommand}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Shown when reviewing a draft generated by a recurring schedule
                                                 (the Make-recurring toggle is hidden in edit mode). -->
                                            <Border IsVisible="{Binding EditingRecurringInvoice}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <PathIcon Data="{x:Static icons:Icons.Refresh}" Width="14" Height="14"
                                                              Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Generated from a recurring schedule" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel>
                                                <TextBlock Text="TEMPLATE" Classes="sidebar-label" />
                                                <ComboBox ItemsSource="{Binding TemplateOptions}" SelectedItem="{Binding SelectedTemplate}"
                                                          Classes="form-combobox" HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding !IsFromExternalSource}">
                                                <TextBlock Text="CURRENCY" Classes="sidebar-label" />
                                                <ComboBox ItemsSource="{Binding AvailableCurrencies}" SelectedItem="{Binding SelectedCurrency}"
                                                          Classes="form-combobox" HorizontalAlignment="Stretch" />
                                            </StackPanel>

                                            <!-- Display toggles: what appears on the invoice (per-invoice overrides). -->
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="DISPLAY" Classes="sidebar-label" />
                                                <CheckBox IsChecked="{Binding OptShowCompanyAddress}" Content="Show company address" />
                                                <CheckBox IsChecked="{Binding OptShowCompanyPhone}" Content="Show company phone" />
                                                <CheckBox IsChecked="{Binding OptShowDueDateProminent}" Content="Show prominent due date" />
                                            </StackPanel>

                                            <!-- Tax, shipping, discount and fees are edited directly in the totals
                                                 section on the invoice paper. -->

                                            <!-- Status (edit mode) -->
                                            <StackPanel IsVisible="{Binding IsEditMode}">
                                                <TextBlock Text="STATUS" Classes="sidebar-label" />
                                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding ModalStatus}"
                                                          Classes="form-combobox" HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Behaviour toggles: how the invoice works (fees, recurrence). -->
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="OPTIONS" Classes="sidebar-label" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding OptPassProcessingFee}" Content="Pass processing fee to customer" VerticalAlignment="Center" />
                                                    <Button Classes="icon-button" Padding="4" VerticalAlignment="Center"
                                                            ToolTip.Tip="Learn more" Click="OnProcessingFeeInfoClick">
                                                        <PathIcon Data="{x:Static icons:Icons.Info}" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !IsEditMode}">
                                                    <CheckBox IsChecked="{Binding IsRecurring}" Content="Make recurring" VerticalAlignment="Center" />
                                                    <Button Classes="icon-button" Padding="4" VerticalAlignment="Center"
                                                            ToolTip.Tip="Learn more" Click="OnRecurringInfoClick">
                                                        <PathIcon Data="{x:Static icons:Icons.Info}" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                                <Border IsVisible="{Binding IsRecurring}"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12">
                                                    <StackPanel Spacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Frequency" Classes="sidebar-label" Margin="0" />
                                                            <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding RecurringFrequency}" Classes="form-combobox" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Start date" Classes="sidebar-label" Margin="0" />
                                                            <DatePicker SelectedDate="{Binding RecurringStartDate}" Classes="form-datepicker" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="End date (optional)" Classes="sidebar-label" Margin="0" />
                                                            <DatePicker SelectedDate="{Binding RecurringEndDate}" Classes="form-datepicker" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Validation / send errors -->
                                            <Border Background="{DynamicResource ErrorLightBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasValidationMessage}">
                                                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Background="{DynamicResource ErrorLightBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasSendError}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SendErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Classes="icon-button-small" Width="24" Height="24" Command="{Binding DismissSendErrorCommand}" VerticalAlignment="Center" ToolTip.Tip="{loc:Loc 'Dismiss'}">
                                                        <PathIcon Data="{x:Static icons:Icons.Close}" Width="10" Height="10" Foreground="{DynamicResource ErrorTextBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Actions -->
                                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                                <!-- Edit mode -->
                                                <Button Classes="primary-button" HorizontalAlignment="Stretch" Content="Preview"
                                                        Click="OnPreviewClick" IsVisible="{Binding !IsEditorPreviewing}" IsEnabled="{Binding IsPortalReady}" />
                                                <Button Classes="secondary-button" HorizontalAlignment="Stretch" Content="Save as draft"
                                                        Click="OnSaveAsDraftClick" IsVisible="{Binding !IsEditorPreviewing}" />
                                                <!-- Preview mode. The send button carries a paper-plane icon so it never reads
                                                     as the same button as "Preview" (which sat in the same spot a click earlier). -->
                                                <Button Classes="primary-button" HorizontalAlignment="Stretch"
                                                        Command="{Binding CreateAndSendInvoiceCommand}" IsVisible="{Binding IsEditorPreviewing}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <PathIcon Data="{x:Static icons:Icons.Send}" Width="15" Height="15" />
                                                        <TextBlock Text="Create &amp; send" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button Grid.Row="1" Classes="secondary-button" HorizontalAlignment="Stretch"
                                            Margin="16,0,16,16"
                                            Command="{Binding BackToEditorCommand}" IsVisible="{Binding IsEditorPreviewing}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <PathIcon Data="{x:Static icons:Icons.ArrowBack}" Width="15" Height="15" />
                                            <TextBlock Text="Back to edit" />
                                        </StackPanel>
                                    </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- VIEW-ONLY: rendered HTML preview above its own bottom bar. The preview lives
                                 in its own row so the native WebView (which draws above Avalonia) can't
                                 overflow onto the buttons. -->
                            <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsViewOnly}">
                                <controls:InvoicePreviewControl Grid.Row="0" Html="{Binding PreviewHtml}"
                                                                OpenInBrowserCommand="{Binding OpenPreviewInBrowserCommand}">
                                    <controls:InvoicePreviewControl.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsCreateEditModalOpen" />
                                            <Binding Path="IsViewOnly" />
                                        </MultiBinding>
                                    </controls:InvoicePreviewControl.IsVisible>
                                </controls:InvoicePreviewControl>

                                <!-- View-only bottom bar -->
                                <Border Grid.Row="1" Padding="20,14"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button Grid.Column="0" Classes="secondary-button" Command="{Binding OpenPreviewInBrowserCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{x:Static icons:Icons.OpenExternal}" Width="14" Height="14" />
                                                <TextBlock Text="{loc:Loc 'Open in Browser'}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="primary-button" Content="{loc:Loc Close}" Command="{Binding CloseCreateEditModalCommand}" />
                                    </Grid>
                                </Border>
                            </Grid>

                        </Grid>
                    </Grid>
                </Border>

                <!-- Success / sending: a normal-sized centered card, not the full editor width. -->
                <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="12" ClipToBounds="True"
                        BoxShadow="0 8 32 0 #40000000">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsShowingSuccess" />
                            <Binding Path="IsSending" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Panel MinHeight="300">
                        <!-- Success -->
                        <controls:SuccessAnimation Title="{Binding SuccessTitle}"
                                                   Message="{Binding SuccessMessage}"
                                                   ShowContinueButton="True"
                                                   ContinueButtonText="{loc:Loc Done}"
                                                   ContinueButtonDelayMs="300"
                                                   ContinueCommand="{Binding CloseSuccessAndFinishCommand}"
                                                   IsPlaying="{Binding IsShowingSuccess}"
                                                   IsVisible="{Binding IsShowingSuccess}" />
                        <!-- Sending -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="24"
                                    IsVisible="{Binding IsSending}">
                            <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                            <TextBlock Text="{loc:Loc 'Sending invoice...'}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc 'Publishing to the portal and emailing your customer.'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                        </StackPanel>
                    </Panel>
                </Border>
                </Panel>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- ======================= FILTER MODAL ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsFilterModalOpen}"
                               ClosingCommand="{Binding RequestCloseFilterModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                        Width="500">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{loc:Loc 'Filter Invoices'}"
                                          CloseCommand="{Binding RequestCloseFilterModalCommand}" />

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="20">
                            <!-- Status and Customer Row -->
                            <Grid ColumnDefinitions="*,16,*">
                                <!-- Status Filter -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Loc Status}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                              SelectedItem="{Binding FilterStatus}"
                                              Classes="form-combobox"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Customer Filter -->
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{loc:Loc Customer}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:SearchableDropdown ItemsSource="{Binding CustomerOptions}"
                                                                SelectedItem="{Binding FilterSelectedCustomer}"
                                                                DisplayMemberPath="Name"
                                                                SearchMemberPath="Id"
                                                                Placeholder="{loc:Loc 'All customers'}"
                                                                ShowAddNew="False" />
                                </StackPanel>
                            </Grid>

                            <!-- Issue Date Range -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Issue Date'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'From'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterIssueDateFrom}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'To'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterIssueDateTo}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Due Date Range -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Due Date'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'From'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterDueDateFrom}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'To'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterDueDateTo}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Amount Range -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Amount Range'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Min'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterAmountMin, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="$0.00"
                                                 behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                 MaxLength="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Max'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterAmountMax, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="$0.00"
                                                 behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                 MaxLength="13" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0"
                                    Classes="secondary-button"
                                    Content="{loc:Loc 'Clear filters'}"
                                    Command="{Binding ClearFiltersCommand}" />
                            <Button Grid.Column="2"
                                    Classes="secondary-button"
                                    Content="{loc:Loc Cancel}"
                                    Margin="0,0,12,0"
                                    Command="{Binding RequestCloseFilterModalCommand}" />
                            <Button Grid.Column="3"
                                    Classes="primary-button"
                                    Content="{loc:Loc 'Apply Filters'}"
                                    Command="{Binding ApplyFiltersCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- ======================= HISTORY MODAL ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsHistoryModalOpen}"
                               ClosingCommand="{Binding CloseHistoryModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                        Width="600"
                        MaxHeight="500">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{Binding HistoryInvoiceId}"
                                          Subtitle="{loc:Loc 'Invoice History'}"
                                          CloseCommand="{Binding CloseHistoryModalCommand}" />

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1">
                        <Panel Margin="24">
                            <!-- Timeline -->
                            <ItemsControl ItemsSource="{Binding HistoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:InvoiceHistoryDisplayItem">
                                        <Grid ColumnDefinitions="Auto,16,*" Margin="0,0,0,24">
                                            <!-- Timeline dot and line -->
                                            <StackPanel Grid.Column="0" Width="16">
                                                <Border Width="12" Height="12"
                                                        CornerRadius="6"
                                                        Background="{Binding ActionType, Converter={x:Static local:StatusConverters.HistoryTypeBadgeBackground}}"
                                                        BorderBrush="{Binding ActionType, Converter={x:Static local:StatusConverters.HistoryTypeBadgeForeground}}"
                                                        BorderThickness="2" />
                                                <Border Width="2"
                                                        Height="40"
                                                        Background="{DynamicResource BorderBrush}"
                                                        HorizontalAlignment="Center"
                                                        IsVisible="{Binding !IsLast}" />
                                            </StackPanel>

                                            <!-- Content. Payment rows carry edit/delete: payments are
                                                 only reachable through their invoice, so this is where
                                                 they get managed. -->
                                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="14"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding DateTimeFormatted}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Top"
                                                            IsVisible="{Binding CanEditPayment}">
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'Edit Payment'}"
                                                            AutomationProperties.Name="Edit Payment"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoiceModalsViewModel)DataContext).EditHistoryPaymentCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Edit}" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Classes="icon-button danger"
                                                            ToolTip.Tip="{loc:Loc 'Delete Payment'}"
                                                            AutomationProperties.Name="Delete Payment"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoiceModalsViewModel)DataContext).DeleteHistoryPaymentCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Delete}" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        IsVisible="{Binding HistoryItems.Count, Converter={x:Static local:IntConverters.IsZero}}">
                                <PathIcon Data="{x:Static icons:Icons.History}"
                                          Width="32" Height="32"
                                          Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{loc:Loc 'No history yet'}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="ArgoBooks.Modals.BankStatementImportModal"
             x:DataType="vm:BankStatementImportModalViewModel">

    <UserControl.Styles>
        <!-- Expense / Revenue type toggle buttons (mirrors BankMatchingPage type-toggle-button style) -->
        <Style Selector="Button.type-toggle-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.type-toggle-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.type-toggle-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <!-- Read-only category chip (existing product) -->
        <Style Selector="Border.category-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Clickable category chip (new product) -->
        <Style Selector="Button.category-chip-button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.category-chip-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.category-chip-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <!-- Modal width: full while reviewing, compact while the loading spinner shows -->
        <Style Selector="Border.import-modal">
            <Setter Property="MaxWidth" Value="960" />
        </Style>
        <Style Selector="Border.import-modal.loading">
            <Setter Property="MaxWidth" Value="440" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding CancelCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Classes="modal-card import-modal"
                    Classes.loading="{Binding IsLoading}"
                    MaxHeight="700"
                    HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0" Title="{loc:Loc 'Import bank statement'}" CloseCommand="{Binding CancelCommand}">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </controls:ModalHeader>

                    <Panel Grid.Row="1">
                        <!-- Loading state (while parsing + AI categorization run) -->
                        <controls:LoadingState IsVisible="{Binding IsLoading}"
                                               Message="{Binding LoadingMessage}"
                                               Detail="{loc:Loc 'This may take a few seconds...'}"
                                               ShowProgress="{Binding ShowCategorizeProgress}"
                                               Percent="{Binding CategorizeProgress}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="24,40" />

                        <!-- Row list -->
                        <ScrollViewer IsVisible="{Binding !IsLoading}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid Margin="24,16,24,30" RowDefinitions="Auto,*">

                            <!-- Column header labels — same column layout as data rows.
                                 Trailing 16px column is a gutter so the row scrollbar doesn't overlap the Supplier/Customer box. -->
                            <Grid Grid.Row="0" ColumnDefinitions="28,90,245,110,165,250,16" Margin="0,0,0,6">
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Date}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Product'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0"
                                           Text="{loc:Loc Amount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Margin="8,0,0,0"
                                           Text="{loc:Loc Type}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Supplier / Customer'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ImportLineRow">
                                        <Border Padding="0,4"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <!-- Same column layout as the header row above (trailing 16px = scrollbar gutter).
                                                 Row 0 holds the aligned controls; row 1 holds the category chip under the product. -->
                                            <Grid ColumnDefinitions="28,90,245,110,165,250,16" RowDefinitions="Auto,Auto">

                                                <!-- Include checkbox -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />

                                                <!-- Date — compact read-only formatted text -->
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding DateFormatted}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Already-imported note (row is pre-unchecked) -->
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{loc:Loc 'Already imported'}"
                                                           IsVisible="{Binding AlreadyImported}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />

                                                <!-- Product (carries the category) -->
                                                <controls:SearchableDropdown
                                                    Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Classes="compact"
                                                    Placeholder="{loc:Loc 'Search for a product...'}"
                                                    ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableProducts}"
                                                    SelectedItem="{Binding ResolvedProductObject, Mode=TwoWay}"
                                                    SearchText="{Binding ProductSearchText, Mode=TwoWay}"
                                                    DisplayMemberPath="Name"
                                                    SearchMemberPath="Id"
                                                    ShowAddNew="True"
                                                    AddNewText="{loc:Loc 'Create one'}"
                                                    AddNewCommand="{Binding CreateNewProductCommand}"
                                                    HasError="{Binding HasProductError}" />

                                                <!-- Category chip under the product (new = click to edit, existing = read-only) -->
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,2,0,0">
                                                    <!-- New product: click to edit its name and category -->
                                                    <Button IsVisible="{Binding IsNewProduct}"
                                                            Classes="category-chip-button"
                                                            Command="{Binding CreateNewProductCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{loc:Loc 'New'}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Loc 'click to edit'}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Existing product: read-only category chip -->
                                                    <Border Classes="category-chip">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="!IsNewProduct" />
                                                                <Binding Path="CategoryDisplay" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Text="{Binding CategoryDisplay}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <!-- Validation message here (not inside the picker) so it doesn't push the picker up -->
                                                    <TextBlock Text="{loc:Loc 'Please select or create a product.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding HasProductError}" />
                                                </StackPanel>

                                                <!-- Amount — narrow, no spinner buttons -->
                                                <NumericUpDown Grid.Column="3" Margin="8,0,0,0"
                                                               Value="{Binding Amount, Mode=TwoWay}"
                                                               FormatString="F2"
                                                               ShowButtonSpinner="False"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center" />

                                                <!-- Expense / Revenue toggle -->
                                                <Border Grid.Row="0" Grid.Column="4" Margin="8,0,0,0"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="6" Padding="4"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                    <UniformGrid Columns="2">
                                                        <Button Content="{loc:Loc Expense}"
                                                                Command="{Binding SetExpenseCommand}"
                                                                Classes="type-toggle-button"
                                                                HorizontalAlignment="Stretch"
                                                                Classes.selected="{Binding !CreateAsRevenue}"
                                                                ToolTip.Tip="{loc:Loc 'Create as expense'}" />
                                                        <Button Content="{loc:Loc Revenue}"
                                                                Command="{Binding SetRevenueCommand}"
                                                                Classes="type-toggle-button"
                                                                HorizontalAlignment="Stretch"
                                                                Margin="2,0,0,0"
                                                                Classes.selected="{Binding CreateAsRevenue}"
                                                                ToolTip.Tip="{loc:Loc 'Create as revenue'}" />
                                                    </UniformGrid>
                                                </Border>

                                                <!-- Category is shown read-only on the Product cell; it follows the selected product. -->

                                                <!-- Supplier / Customer column -->
                                                <Grid Grid.Row="0" Grid.Column="5" Margin="8,0,0,0"
                                                      VerticalAlignment="Center">

                                                    <!-- Supplier dropdown (expense) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding !CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Search suppliers...'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableSuppliers}"
                                                        SelectedItem="{Binding ResolvedSupplierObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        SearchMemberPath="Id"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                        EmptyCreateCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}" />

                                                    <!-- Customer dropdown (revenue) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Search customers...'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableCustomers}"
                                                        SelectedItem="{Binding ResolvedCustomerObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        SearchMemberPath="Id"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                        EmptyCreateCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}" />
                                                </Grid>

                                                <!-- Under the supplier/customer picker (row 1): a "New" badge for a to-be-created
                                                     party, or the validation message. These are mutually exclusive. -->
                                                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="8,2,0,0">
                                                    <!-- New counterparty: will be created on import -->
                                                    <Border Classes="category-chip"
                                                            IsVisible="{Binding NewCounterpartyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{loc:Loc 'New'}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                    </Border>
                                                    <!-- Validation -->
                                                    <TextBlock Text="{loc:Loc 'Please select or create a supplier.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasCounterpartyError" />
                                                                <Binding Path="!CreateAsRevenue" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                    <TextBlock Text="{loc:Loc 'Please select or create a customer.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasCounterpartyError" />
                                                                <Binding Path="CreateAsRevenue" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                        </ScrollViewer>
                    </Panel>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc 'Please enter all required fields'}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasValidationMessage}" />
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding IncludedCountText}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!HasValidationMessage" />
                                        <Binding Path="!IsLoading" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                       Text="{Binding AiUnavailableMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding AiUnavailable}" />
                            <Button Grid.Column="2" Margin="0,0,12,0"
                                    Content="{loc:Loc Cancel}"
                                    Classes="secondary-button"
                                    Command="{Binding CancelCommand}" />
                            <Button Grid.Column="3"
                                    Content="{loc:Loc Import}"
                                    Classes="primary-button"
                                    IsVisible="{Binding !IsLoading}"
                                    Command="{Binding ImportCommand}" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>

    <!-- Pending-product editor: set a new product's name + category without creating anything until import -->
    <controls:ModalOverlay IsOpen="{Binding IsProductEditorOpen}"
                           ClosingCommand="{Binding CancelProductEditorCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="24" Spacing="18">
                    <TextBlock Text="{loc:Loc 'Edit product'}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc 'Product'}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding ProductEditorName, Mode=TwoWay}"
                                 Classes="form-input"
                                 PlaceholderText="{loc:Loc 'Product name'}"
                                 MaxLength="100" />
                        <TextBlock Text="{loc:Loc 'Please enter a product name.'}" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   IsVisible="{Binding ProductEditorNameError}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc 'Category'}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <controls:SearchableDropdown
                            ItemsSource="{Binding ProductEditorCategories}"
                            SelectedItem="{Binding ProductEditorCategoryObject, Mode=TwoWay}"
                            SearchText="{Binding ProductEditorCategorySearchText, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            Placeholder="{loc:Loc 'Select or type a new category...'}" />
                        <TextBlock Text="{loc:Loc 'Type a new name to create a category on import.'}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Classes="secondary-button" Content="{loc:Loc Cancel}"
                                Command="{Binding CancelProductEditorCommand}" />
                        <Button Classes="primary-button" Content="{loc:Loc Save}"
                                Command="{Binding SaveProductEditorCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
    </Panel>

</UserControl>

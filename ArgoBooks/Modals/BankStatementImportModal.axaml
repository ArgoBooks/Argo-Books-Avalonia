<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="ArgoBooks.Modals.BankStatementImportModal"
             x:DataType="vm:BankStatementImportModalViewModel">

    <UserControl.Styles>
        <!-- The sign of the amount is what makes a line an expense or revenue, so it is coloured to be read at a glance. The hover and focus forms are repeated because the theme sets its own colour for each. -->
        <Style Selector="TextBox.money-in, TextBox.money-in:pointerover, TextBox.money-in:focus">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBox.money-out, TextBox.money-out:pointerover, TextBox.money-out:focus">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <!-- Marks a product, category, supplier or customer that does not exist yet and is created on import. -->
        <Style Selector="Border.new-badge">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Modal width: full while reviewing, compact while the loading spinner shows -->
        <Style Selector="Border.import-modal">
            <Setter Property="MaxWidth" Value="960" />
        </Style>
        <Style Selector="Border.import-modal.loading">
            <Setter Property="MaxWidth" Value="440" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding CancelCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Classes="modal-card import-modal"
                    Classes.loading="{Binding IsLoading}"
                    MaxHeight="700"
                    HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0" Title="{loc:Loc 'Import bank statement'}" CloseCommand="{Binding CancelCommand}">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </controls:ModalHeader>

                    <Panel Grid.Row="1">
                        <!-- Loading state (while parsing + AI categorization run) -->
                        <controls:LoadingState IsVisible="{Binding IsLoading}"
                                               Message="{Binding LoadingMessage}"
                                               Detail="{loc:Loc 'This may take a few seconds...'}"
                                               ShowProgress="{Binding ShowCategorizeProgress}"
                                               Percent="{Binding CategorizeProgress}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="24,40" />

                        <!-- Row list -->
                        <ScrollViewer IsVisible="{Binding !IsLoading}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid Margin="24,16,24,30" RowDefinitions="Auto,*">

                            <!-- Column header labels — same column layout as data rows.
                                 Trailing 16px column is a gutter so the row scrollbar doesn't overlap the Supplier/Customer box. -->
                            <Grid Grid.Row="0" ColumnDefinitions="28,90,230,185,110,245,16" Margin="0,0,0,6">
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Date}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Product'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Category'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Margin="8,0,0,0"
                                           Text="{loc:Loc Amount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Supplier / Customer'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ImportLineRow">
                                        <!-- The right margin is the header's 16px scrollbar gutter, so the row and its separator line stop short of the scrollbar. -->
                                        <Border Padding="0,4"
                                                Margin="0,0,16,0"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <!-- Same columns as the header row above. Row 0 holds the aligned controls; row 1 holds the notes under them. -->
                                            <Grid ColumnDefinitions="28,90,230,185,110,245" RowDefinitions="Auto,Auto">

                                                <!-- Include checkbox -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />

                                                <!-- Date — compact read-only formatted text -->
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding DateFormatted}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Already-imported note (row is pre-unchecked) -->
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{loc:Loc 'Already imported'}"
                                                           IsVisible="{Binding AlreadyImported}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />

                                                <!-- Product. A name that is not picked from the list is created on import. -->
                                                <controls:SearchableDropdown
                                                    Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Classes="compact"
                                                    Placeholder="{loc:Loc 'Type a new product, or pick one'}"
                                                    ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableProducts}"
                                                    SelectedItem="{Binding ResolvedProductObject, Mode=TwoWay}"
                                                    SearchText="{Binding ProductSearchText, Mode=TwoWay}"
                                                    DisplayMemberPath="Name"
                                                    SearchMemberPath="Id"
                                                    HasError="{Binding HasProductError}" />

                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,2,0,0">
                                                    <Border Classes="new-badge" IsVisible="{Binding IsNewProduct}">
                                                        <TextBlock Text="{loc:Loc 'New'}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                    </Border>
                                                    <!-- Validation message here (not inside the picker) so it doesn't push the picker up -->
                                                    <TextBlock Text="{loc:Loc 'Please select or create a product.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding HasProductError}" />
                                                </StackPanel>

                                                <!-- Category. A picked product brings its own, so it reads as plain text; only a product being created gets a box. -->
                                                <TextBlock Grid.Row="0" Grid.Column="3" Margin="18,0,0,0"
                                                           Text="{Binding CategorySearchText}"
                                                           IsVisible="{Binding !IsCategoryEditable}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <controls:SearchableDropdown
                                                    Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Classes="compact"
                                                    IsVisible="{Binding IsCategoryEditable}"
                                                    Placeholder="{loc:Loc 'Type a new category, or pick one'}"
                                                    ItemsSource="{Binding CategoryOptions}"
                                                    SelectedItem="{Binding ResolvedCategoryObject, Mode=TwoWay}"
                                                    SearchText="{Binding CategorySearchText, Mode=TwoWay}"
                                                    DisplayMemberPath="Name" />

                                                <Border Grid.Row="1" Grid.Column="3" Margin="8,2,0,0"
                                                        Classes="new-badge"
                                                        HorizontalAlignment="Left"
                                                        IsVisible="{Binding IsNewCategory}">
                                                    <TextBlock Text="{loc:Loc 'New'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                </Border>

                                                <!-- Amount. Its sign is what makes the line an expense or revenue, so the box takes a minus. -->
                                                <TextBox Grid.Column="4" Margin="8,0,0,0"
                                                         Text="{Binding Amount, Mode=TwoWay, Converter={x:Static local:NullableDecimalConverter.Instance}}"
                                                         Classes="form-input-compact"
                                                         Classes.money-in="{Binding CreateAsRevenue}"
                                                         Classes.money-out="{Binding !CreateAsRevenue}"
                                                         behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                         behaviors:NumericInputBehavior.AllowNegative="True"
                                                         MaxLength="13"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center" />

                                                <!-- Supplier / Customer column -->
                                                <Grid Grid.Row="0" Grid.Column="5" Margin="8,0,0,0"
                                                      VerticalAlignment="Center">

                                                    <!-- Supplier dropdown (expense) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding !CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Type a new supplier, or pick one'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableSuppliers}"
                                                        SelectedItem="{Binding ResolvedSupplierObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        SearchMemberPath="Id"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}" />

                                                    <!-- Customer dropdown (revenue) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Type a new customer, or pick one'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableCustomers}"
                                                        SelectedItem="{Binding ResolvedCustomerObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        SearchMemberPath="Id"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}" />
                                                </Grid>

                                                <!-- Under the supplier/customer picker (row 1): a "New" badge for a to-be-created
                                                     party, or the validation message. These are mutually exclusive. -->
                                                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="8,2,0,0">
                                                    <!-- New counterparty: will be created on import -->
                                                    <Border Classes="new-badge"
                                                            IsVisible="{Binding NewCounterpartyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{loc:Loc 'New'}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                    </Border>
                                                    <!-- Validation -->
                                                    <TextBlock Text="{loc:Loc 'Please select or create a supplier.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasCounterpartyError" />
                                                                <Binding Path="!CreateAsRevenue" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                    <TextBlock Text="{loc:Loc 'Please select or create a customer.'}"
                                                               FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="HasCounterpartyError" />
                                                                <Binding Path="CreateAsRevenue" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                        </ScrollViewer>
                    </Panel>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc 'Please enter all required fields'}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasValidationMessage}" />
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding IncludedCountText}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!HasValidationMessage" />
                                        <Binding Path="!IsLoading" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                       Text="{Binding AiUnavailableMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding AiUnavailable}" />
                            <Button Grid.Column="2" Margin="0,0,12,0"
                                    Content="{loc:Loc Cancel}"
                                    Classes="secondary-button"
                                    Command="{Binding CancelCommand}" />
                            <Button Grid.Column="3"
                                    Content="{loc:Loc Import}"
                                    Classes="primary-button"
                                    IsVisible="{Binding !IsLoading}"
                                    Command="{Binding ImportCommand}" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>

    </Panel>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
             x:Class="ArgoBooks.Modals.CurrencyAmbiguityDialog"
             x:DataType="vm:CurrencyAmbiguityDialogViewModel">

    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding CancelCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MaxWidth="640"
                    MinWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">

                <!-- Auto rows so the modal sizes to its content; the body scrolls only if there
                     are many symbols (capped via the ScrollViewer MaxHeight). -->
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0"
                            Padding="24,20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource AiAccentColor}" Opacity="0.15" />
                                </Border.Background>
                                <PathIcon Data="{x:Static icons:Icons.Lightning}"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource AiAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Confirm the currency"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Some amounts use a currency symbol that could mean more than one currency. Pick the right one and it will be applied to every matching row." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Body: one row per ambiguous symbol. No ScrollViewer: there are only a few
                         distinct ambiguous symbols, so the body sizes directly to its content and
                         can never clip a row. -->
                    <ItemsControl Grid.Row="1" Padding="24,16" ItemsSource="{Binding Symbols}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SymbolChoiceViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Header}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="200"
                                              Margin="16,0,0,0"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                            Padding="24,16"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Right">
                            <Button Classes="secondary-button"
                                    Content="Cancel"
                                    Command="{Binding CancelCommand}" />
                            <Button Classes="primary-button"
                                    Content="Use these currencies"
                                    Command="{Binding ConfirmCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
</UserControl>

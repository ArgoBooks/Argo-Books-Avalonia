<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:icons="using:ArgoBooks"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="ArgoBooks.Modals.TransactionModals"
             x:DataType="vm:ITransactionModalsViewModel">

    <Design.DataContext>
        <vm:ExpenseModalsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- An expense total is money out and a discount saves it; revenue is the other way round. -->
        <Style Selector="TextBlock.total-amount">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.total-amount.revenue">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.discount-amount">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.discount-amount.discount-applied">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.discount-amount.discount-applied.revenue">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ======================= ADD / EDIT MODAL ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsAddEditModalOpen}"
                               ClosingCommand="{Binding RequestCloseAddEditModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="750"
                    MinHeight="500"
                    MaxHeight="700">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0"
                                          Title="{Binding ModalTitle}"
                                          CloseCommand="{Binding RequestCloseAddEditModalCommand}" />

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding !IsSavingTransaction}">
                        <StackPanel Margin="24" Spacing="20">
                            <!-- Date and Payment Method Row -->
                            <Grid ColumnDefinitions="*,16,*">
                                <!-- Date -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{loc:Loc 'Date'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                    </TextBlock>
                                    <DatePicker SelectedDate="{Binding ModalDate}"
                                                Classes="form-datepicker"
                                                HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Payment Method -->
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{loc:Loc 'Payment Method'}" />
                                    <ComboBox ItemsSource="{Binding PaymentMethodOptions}"
                                              SelectedItem="{Binding SelectedPaymentMethod}"
                                              Classes="form-combobox"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Customer Selection (revenue) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsRevenue}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Customer'}" />
                                <controls:SearchableDropdown ItemsSource="{Binding CounterpartyOptions}"
                                                            SelectedItem="{Binding SelectedCounterparty}"
                                                            DisplayMemberPath="Name"
                                                            SearchMemberPath="Id"
                                                            Placeholder="{loc:Loc 'Search for a customer...'}"
                                                            HasError="{Binding HasCounterpartyError}"
                                                            ErrorMessage="{loc:Loc 'Please select a customer.'}"
                                                            ShowAddNew="True"
                                                            AddNewText="{loc:Loc 'Create new customer'}"
                                                            AddNewCommand="{Binding OpenCreateCounterpartyCommand}"
                                                            EmptyMessage="{loc:Loc 'No customers found'}"
                                                            EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                            EmptyCreateCommand="{Binding OpenCreateCounterpartyCommand}" />
                            </StackPanel>

                            <!-- Line Items Section -->
                            <StackPanel x:Name="LineItemsSection" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Loc 'Line Items'}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="secondary-button"
                                            Command="{Binding AddLineItemCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{x:Static icons:Icons.Add}"
                                                      Width="14" Height="14" />
                                            <TextBlock Text="{loc:Loc 'Add Item'}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Line Items Header -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        IsVisible="{Binding LineItems.Count, Converter={x:Static local:IntConverters.IsPositive}}">
                                    <Grid ColumnDefinitions="*,150,70,90,100,40">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                            <TextBlock Text="{loc:Loc 'Item'}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text=" *" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Category'}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc 'Qty'}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="3" Text="{loc:Loc 'Price'}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="4" Text="{loc:Loc 'Amount'}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0" />
                                    </Grid>
                                </Border>

                                <!-- Line Items List -->
                                <ItemsControl ItemsSource="{Binding LineItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TransactionLineItemBase">
                                            <Border Padding="12,8"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,150,70,90,100,40">
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                                                    <controls:SearchableDropdown Classes="compact"
                                                             ItemsSource="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).ProductOptions}"
                                                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                                             SearchText="{Binding ItemText, Mode=TwoWay}"
                                                             DisplayMemberPath="Name"
                                                             SearchMemberPath="Id"
                                                             Placeholder="{loc:Loc 'Type a new product, or pick one'}"
                                                             ShowAddNew="True"
                                                             AddNewText="{loc:Loc 'Create new product'}"
                                                             AddNewCommand="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).OpenCreateProductCommand}"
                                                             AddNewCommandParameter="{Binding}"
                                                             HasError="{Binding HasProductError}"
                                                             ErrorMessage="{loc:Loc 'Type a new product, or pick one'}" />
                                                        <ComboBox ItemsSource="{Binding LocationOptions}"
                                                                  SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                                                                  IsVisible="{Binding ShowLocationPicker}"
                                                                  Classes="form-combobox"
                                                                  HorizontalAlignment="Stretch"
                                                                  ToolTip.Tip="{loc:Loc 'Location to take stock from or add it to'}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="vm:LocationOption">
                                                                    <TextBlock Text="{Binding DisplayText}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <!-- Takes the category for a typed item. A picked product shows its category as text instead,
                                                         since moving a product between categories belongs on the Products page.
                                                         Neither box sets an empty-state link: it replaces the text box, and a
                                                         new company has no products or categories, so nothing could be typed.
                                                         Creating one stays available at the bottom of each list. -->
                                                    <Panel Grid.Column="1" Margin="0,0,8,0">
                                                        <controls:SearchableDropdown Classes="compact"
                                                                 ItemsSource="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).CategoryOptions}"
                                                                 IsVisible="{Binding !IsExistingProductLine}"
                                                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                                 SearchText="{Binding CategoryText, Mode=TwoWay}"
                                                                 DisplayMemberPath="Name"
                                                                 Placeholder="{loc:Loc 'Category'}"
                                                                 ShowAddNew="True"
                                                                 AddNewText="{loc:Loc 'Create new category'}"
                                                                 AddNewCommand="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).OpenCreateCategoryCommand}"
                                                                 AddNewCommandParameter="{Binding}"
                                                                 HasError="{Binding HasCategoryError}"
                                                                 ErrorMessage="{loc:Loc 'Pick a category'}" />
                                                        <Border IsVisible="{Binding IsExistingProductLine}"
                                                                MinHeight="{StaticResource FormControlHeightCompact}"
                                                                VerticalAlignment="Top"
                                                                Padding="8,0">
                                                            <TextBlock Text="{Binding PickedCategoryName}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding PickedCategoryName}" />
                                                        </Border>
                                                    </Panel>
                                                    <NumericUpDown Grid.Column="2"
                                                                   Value="{Binding Quantity, Mode=TwoWay, TargetNullValue=1}"
                                                                   Minimum="0.001"
                                                                   Maximum="999999"
                                                                   FormatString="0.###"
                                                                   Classes="line-item-input"
                                                                   ShowButtonSpinner="False"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,8,0" />
                                                    <NumericUpDown Grid.Column="3"
                                                                   Value="{Binding UnitPrice, Mode=TwoWay, TargetNullValue=0}"
                                                                   Minimum="0"
                                                                   Maximum="999999999"
                                                                   FormatString="N2"
                                                                   Classes="line-item-input"
                                                                   ShowButtonSpinner="False"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Top"
                                                                   Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding AmountFormatted}"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,0,12,0" />
                                                    <Button Grid.Column="5"
                                                            Classes="icon-button danger"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            IsVisible="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).LineItems.Count, Converter={x:Static local:IntConverters.IsGreaterThanOne}}"
                                                            Command="{Binding $parent[ItemsControl].((vm:ITransactionModalsViewModel)DataContext).RemoveLineItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{loc:Loc 'Remove item'}">
                                                        <PathIcon Data="{x:Static icons:Icons.Delete}"
                                                                  Width="14" Height="14" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State for Line Items -->
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="8"
                                        Padding="24,16"
                                        IsVisible="{Binding LineItems.Count, Converter={x:Static local:IntConverters.IsZero}}">
                                    <TextBlock Text="{loc:Loc 'No line items added. Click \'Add Item\' to add products or services.'}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- Tax, Shipping, Discount, Fee Row -->
                            <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                                <!-- Tax -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{loc:Loc 'Tax'}" /><Run Text="{Binding TaxCurrencyLabel}" /></TextBlock>
                                    <TextBox Text="{Binding ModalTaxAmount, Mode=TwoWay, Converter={x:Static local:NullableDecimalConverter.Instance}}"
                                             Classes="form-input"
                                             HorizontalAlignment="Stretch"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                             MaxLength="13" />
                                </StackPanel>

                                <!-- Shipping -->
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{loc:Loc 'Shipping'}" />
                                    <TextBox Text="{Binding ModalShipping, Mode=TwoWay, Converter={x:Static local:NullableDecimalConverter.Instance}}"
                                             Classes="form-input"
                                             HorizontalAlignment="Stretch"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                             MaxLength="13" />
                                </StackPanel>

                                <!-- Discount -->
                                <StackPanel Grid.Column="4" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{loc:Loc 'Discount'}" />
                                    <TextBox Text="{Binding ModalDiscount, Mode=TwoWay, Converter={x:Static local:NullableDecimalConverter.Instance}}"
                                             Classes="form-input"
                                             HorizontalAlignment="Stretch"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                             MaxLength="13" />
                                </StackPanel>

                                <!-- Fee (added to the total) -->
                                <StackPanel Grid.Column="6" Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{loc:Loc 'Fee'}" />
                                    <TextBox Text="{Binding ModalFee, Mode=TwoWay, Converter={x:Static local:NullableDecimalConverter.Instance}}"
                                             Classes="form-input"
                                             HorizontalAlignment="Stretch"
                                             behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                             MaxLength="13" />
                                </StackPanel>
                            </Grid>

                            <!-- Attach Receipt -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Receipt'}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10">
                                        <TextBlock Text="{Binding ReceiptFileName, FallbackValue='No receipt attached'}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Classes="secondary-button"
                                            Command="{Binding AttachReceiptCommand}"
                                            Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{x:Static icons:Icons.DocumentBlank}"
                                                      Width="14" Height="14" />
                                            <TextBlock Text="{loc:Loc 'Attach'}" IsVisible="{Binding !HasReceipt}" />
                                            <TextBlock Text="{loc:Loc 'Change'}" IsVisible="{Binding HasReceipt}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Paid Checkbox (revenue) -->
                            <CheckBox IsChecked="{Binding ModalPaid}"
                                      IsVisible="{Binding IsRevenue}"
                                      Content="{loc:Loc 'Mark as Paid'}"
                                      FontSize="13"
                                      Margin="0,4,0,0" />

                            <!-- Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Notes'}" />
                                <TextBox Text="{Binding ModalNotes, Mode=TwoWay}"
                                         Classes="form-input"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         PlaceholderText="{loc:Loc 'Additional notes...'}"
                                         MaxLength="500" />
                            </StackPanel>

                            <!-- Totals Summary -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Subtotal'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SubtotalFormatted}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Tax'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TaxAmountFormatted}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Shipping'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShippingAmountFormatted}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Discount'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmountFormatted}" FontSize="13"
                                                   Classes="discount-amount"
                                                   Classes.discount-applied="{Binding HasDiscount}"
                                                   Classes.revenue="{Binding IsRevenue}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Fee'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FeeAmountFormatted}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Loc 'Total'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalFormatted}" FontSize="15" FontWeight="Bold"
                                                   Classes="total-amount"
                                                   Classes.revenue="{Binding IsRevenue}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Total Mismatch Warning -->
                            <Border IsVisible="{Binding HasTotalMismatchWarning}"
                                    Background="#33FFA500"
                                    BorderBrush="#FFA500"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <TextBlock Text="{Binding TotalMismatchWarningMessage}"
                                           FontSize="12"
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Saving Overlay (replaces content + footer while saving) -->
                    <StackPanel Grid.Row="1" Grid.RowSpan="2"
                                IsVisible="{Binding IsSavingTransaction}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <controls:LoadingSpinner IsSpinning="{Binding IsSavingTransaction}"
                                                 SizePreset="Large"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc 'Saving transaction...'}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2"
                            IsVisible="{Binding !IsSavingTransaction}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc 'Please enter all required fields'}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasValidationMessage}" />
                            <Button Grid.Column="2"
                                    Classes="secondary-button"
                                    Content="{loc:Loc 'Cancel'}"
                                    Command="{Binding CloseAddEditModalCommand}"
                                    Margin="0,0,12,0" />
                            <Button Grid.Column="3"
                                    Classes="primary-button"
                                    Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveTransactionCommand}" />
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- ======================= SAVE ERROR MODAL ======================= -->
        <controls:ErrorRetryModal IsOpen="{Binding HasSaveError}"
                                  Title="{loc:Loc 'Unable to Save'}"
                                  Message="{Binding SaveErrorMessage}"
                                  IsBusy="{Binding IsSavingTransaction}"
                                  DismissCommand="{Binding DismissSaveErrorCommand}"
                                  RetryCommand="{Binding RetrySaveCommand}"
                                  AllowLightDismiss="True" />

        <!-- ======================= FILTER MODAL ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsFilterModalOpen}"
                               ClosingCommand="{Binding RequestCloseFilterModalCommand}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="500"
                    MaxHeight="600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <controls:ModalHeader Grid.Row="0" CloseCommand="{Binding RequestCloseFilterModalCommand}">
                        <Panel>
                            <TextBlock Classes="modal-title" Text="{loc:Loc 'Filter Expenses'}" IsVisible="{Binding !IsRevenue}" />
                            <TextBlock Classes="modal-title" Text="{loc:Loc 'Filter Revenue'}" IsVisible="{Binding IsRevenue}" />
                        </Panel>
                    </controls:ModalHeader>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="20">
                            <!-- Status -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Status'}" />
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                          SelectedItem="{Binding FilterStatus}"
                                          Classes="form-combobox"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Customer (revenue) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsRevenue}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Customer'}" />
                                <controls:SearchableDropdown ItemsSource="{Binding CounterpartyOptions}"
                                                            SelectedItem="{Binding FilterSelectedCounterparty}"
                                                            DisplayMemberPath="Name"
                                                            SearchMemberPath="Id"
                                                            Placeholder="{loc:Loc 'Select customer...'}"
                                                            ShowAddNew="False" />
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Category'}" />
                                <controls:SearchableDropdown ItemsSource="{Binding CategoryOptions}"
                                                            SelectedItem="{Binding FilterSelectedCategory}"
                                                            DisplayMemberPath="Name"
                                                            Placeholder="{loc:Loc 'Select category...'}"
                                                            ShowAddNew="False" />
                            </StackPanel>

                            <!-- Date Range - Stacked -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Date Range'}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'From'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterDateFrom}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'To'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <DatePicker SelectedDate="{Binding FilterDateTo}"
                                                    Classes="form-datepicker"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Amount Range -->
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Amount Range'}" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Min'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterAmountMin, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="$0.00"
                                                 HorizontalAlignment="Stretch"
                                                 behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                 MaxLength="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{loc:Loc 'Max'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Text="{Binding FilterAmountMax, Mode=TwoWay}"
                                                 Classes="form-input"
                                                 PlaceholderText="$0.00"
                                                 HorizontalAlignment="Stretch"
                                                 behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                                 MaxLength="13" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Receipt Status (expenses) -->
                            <StackPanel Spacing="6" IsVisible="{Binding !IsRevenue}">
                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{loc:Loc 'Receipt'}" />
                                <ComboBox ItemsSource="{Binding ReceiptFilterOptions}"
                                          SelectedItem="{Binding FilterReceiptStatus}"
                                          Classes="form-combobox"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Classes="modal-footer" Grid.Row="2">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0"
                                    Classes="secondary-button"
                                    Content="{loc:Loc 'Clear filters'}"
                                    Command="{Binding ClearFiltersCommand}" />
                            <Button Grid.Column="2"
                                    Classes="secondary-button"
                                    Content="{loc:Loc 'Cancel'}"
                                    Command="{Binding RequestCloseFilterModalCommand}"
                                    Margin="0,0,12,0" />
                            <Button Grid.Column="3"
                                    Classes="primary-button"
                                    Content="{loc:Loc 'Apply Filters'}"
                                    Command="{Binding ApplyFiltersCommand}" />
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>

        <!-- ======================= ITEM STATUS MODAL ======================= -->
        <controls:ModalOverlay IsOpen="{Binding IsItemStatusModalOpen}">
            <controls:ModalOverlay.ModalContent>
                <Border Classes="modal-card"
                    Width="450">
                <StackPanel>
                    <!-- Header -->
                    <controls:ModalHeader Title="{Binding ItemStatusModalTitle}" CloseCommand="{Binding CloseItemStatusModalCommand}" />

                    <!-- Content -->
                    <StackPanel Margin="24" Spacing="20">
                        <!-- Item Info -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Loc 'Item'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding ItemStatusItemDescription}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Reason Selection -->
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{loc:Loc 'Reason'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding CurrentReasonOptions}"
                                      SelectedItem="{Binding SelectedItemStatusReason}"
                                      Classes="form-combobox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="{loc:Loc 'Select a reason...'}"
                                      BorderBrush="{Binding HasItemStatusReasonError, Converter={x:Static local:BoolConverters.ToErrorBorderBrush}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TranslateConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                            <TextBlock TextWrapping="Wrap" Text="{Binding ItemStatusReasonErrorMessage}"
                                       IsVisible="{Binding HasItemStatusReasonError}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}" />
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Loc 'Notes (optional)'}" />
                            <TextBox Text="{Binding ItemStatusNotes, Mode=TwoWay}"
                                     Classes="form-input"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     PlaceholderText="{loc:Loc 'Additional notes about this status change...'}"
                                     MaxLength="500" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer -->
                    <Border Classes="modal-footer">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc 'Cancel'}" Command="{Binding CloseItemStatusModalCommand}" />
                            <Button Classes="primary-button" Content="{Binding ItemStatusSaveButtonText}" Command="{Binding ConfirmItemStatusCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </controls:ModalOverlay.ModalContent>
        </controls:ModalOverlay>
    </Panel>

</UserControl>

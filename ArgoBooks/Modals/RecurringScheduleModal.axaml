<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:behaviors="using:ArgoBooks.Behaviors"
             xmlns:local="using:ArgoBooks"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ArgoBooks.Modals.RecurringScheduleModal"
             x:DataType="vm:RecurringScheduleEditorViewModel">

    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding RequestCloseCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Classes="modal-card"
                    Width="500" MaxHeight="640">
                <Grid RowDefinitions="Auto,*,Auto">
                    <controls:ModalHeader Grid.Row="0" Title="{Binding Title}" CloseCommand="{Binding RequestCloseCommand}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24" Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    <Run Text="{loc:Loc 'Product / Service'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <controls:SearchableDropdown ItemsSource="{Binding ProductOptions}"
                                                             SelectedItem="{Binding SelectedProduct}"
                                                             DisplayMemberPath="Name"
                                                             SearchMemberPath="Id"
                                                             Placeholder="{loc:Loc 'Search for a product...'}"
                                                             HasError="{Binding HasProductError}"
                                                             ShowAddNew="True"
                                                             AddNewText="{Binding ProductAddNewText}"
                                                             AddNewCommand="{Binding CreateProductCommand}"
                                                             EmptyMessage="{loc:Loc 'No products found'}"
                                                             EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                             EmptyCreateCommand="{Binding CreateProductCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    <Run Text="{Binding CounterpartyLabel}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <controls:SearchableDropdown ItemsSource="{Binding CounterpartyOptions}"
                                                             SelectedItem="{Binding SelectedCounterparty}"
                                                             DisplayMemberPath="Name"
                                                             SearchMemberPath="Id"
                                                             Placeholder="{Binding CounterpartyPlaceholder}"
                                                             HasError="{Binding HasCounterpartyError}"
                                                             ShowAddNew="True"
                                                             AddNewText="{Binding CounterpartyAddNewText}"
                                                             AddNewCommand="{Binding CreateCounterpartyCommand}"
                                                             EmptyMessage="{loc:Loc 'None found'}"
                                                             EmptyCreateLinkText="{loc:Loc 'Create one'}"
                                                             EmptyCreateCommand="{Binding CreateCounterpartyCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    <Run Text="{loc:Loc 'Amount'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <TextBox Text="{Binding Amount, Mode=TwoWay}"
                                         Classes="form-input"
                                         PlaceholderText="0.00"
                                         behaviors:NumericInputBehavior.IsDecimalOnly="True"
                                         MaxLength="13" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    <Run Text="{loc:Loc 'Frequency'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <ComboBox SelectedIndex="{Binding FrequencyIndex}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{loc:Loc 'Weekly'}" />
                                    <ComboBoxItem Content="{loc:Loc 'Every two weeks'}" />
                                    <ComboBoxItem Content="{loc:Loc 'Monthly'}" />
                                    <ComboBoxItem Content="{loc:Loc 'Quarterly'}" />
                                    <ComboBoxItem Content="{loc:Loc 'Annually'}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    <Run Text="{loc:Loc 'Starts'}" /><Run Text=" *" Foreground="{DynamicResource ErrorBrush}" />
                                </TextBlock>
                                <DatePicker SelectedDate="{Binding StartDate}"
                                            Classes="form-datepicker"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc 'Ends (optional)'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <DatePicker SelectedDate="{Binding EndDate}"
                                            Classes="form-datepicker"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding HasError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Classes="modal-footer" Grid.Row="2">
                        <StackPanel Classes="modal-actions">
                            <Button Classes="secondary-button" Content="{loc:Loc 'Cancel'}" Command="{Binding RequestCloseCommand}" />
                            <Button Classes="primary-button" Content="{loc:Loc 'Save'}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
</UserControl>

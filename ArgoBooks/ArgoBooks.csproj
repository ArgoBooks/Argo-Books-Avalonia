<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- Define WINDOWS constant when targeting Windows -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ArgoBooks.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Sample company data embedded resource -->
        <EmbeddedResource Include="Resources\SampleCompanyData.xlsx" />
        <EmbeddedResource Include="Resources\pdfjs\pdf.min.js" />
        <EmbeddedResource Include="Resources\pdfjs\pdf.worker.min.js" />
    </ItemGroup>

    <ItemGroup>
        <!-- Avalonia -->
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />

        <!-- Cross-platform WebView (invoice preview, PDF rendering) -->
        <PackageReference Include="Avalonia.Controls.WebView" />

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" />

        <!-- Charts -->
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />

        <!-- Color Picker -->
        <PackageReference Include="Avalonia.Controls.ColorPicker" />

        <!-- QR Code generation -->
        <PackageReference Include="QRCoder" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ArgoBooks.Core\ArgoBooks.Core.csproj" />
    </ItemGroup>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:ArgoBooks.Behaviors">

    <!--
        Argo Books Base Styles
        Common dimensions, spacing, and typography values.
    -->

    <Styles.Resources>
        <!-- Border Radius -->
        <CornerRadius x:Key="RadiusMd">8</CornerRadius>
        <CornerRadius x:Key="RadiusLg">12</CornerRadius>
        <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

        <!-- Font Sizes -->
        <x:Double x:Key="FontSizeXs">10</x:Double>
        <x:Double x:Key="FontSizeSm">12</x:Double>
        <x:Double x:Key="FontSizeMd">14</x:Double>
        <x:Double x:Key="FontSizeXl">20</x:Double>

        <!-- Icon Sizes -->
        <x:Double x:Key="IconSizeMd">20</x:Double>

        <!-- Form Control Heights -->
        <x:Double x:Key="FormControlHeight">40</x:Double>
        <x:Double x:Key="FormControlHeightCompact">36</x:Double>
        <x:Double x:Key="FormControlHeightSmall">32</x:Double>

        <!-- Form Control Corner Radius (unified across all form controls) -->
        <CornerRadius x:Key="FormControlCornerRadius">6</CornerRadius>

        <!-- Animation Colors (must be defined locally for StaticResource in animations) -->
        <Color x:Key="HighlightAnimationColor">#3060A5FA</Color>
    </Styles.Resources>

    <!-- ToolTip: force theme-aware colors so tooltip text/surface track the active theme.
         Foreground cascades to the tooltip's text, so the inner TextBlock needs no separate
         setter. (Sidebar tooltips also need SidebarItem's text styles scoped to .label so
         they don't leak into the tooltip popup.) -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Scrollbar Styling -->
    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Global Hand Cursor for Clickable Controls -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Global TextBox Styling - Fix hover state -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- Global ComboBox Styling - Fix hover state -->
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- Global NumericUpDown Styling - Compact spin buttons -->
    <Style Selector="NumericUpDown">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeightSmall}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="(behaviors:NumericInputBehavior.IsDecimalOnly)" Value="True" />
    </Style>

    <!-- Global CheckBox Styling - Use dynamic accent color with animations -->
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="CheckBox /template/ Path#CheckGlyph">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <!-- Global RadioButton Styling - Use dynamic accent color -->
    <Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton:checked:pointerover /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <Style Selector="RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Fill" Value="{DynamicResource PrimaryHoverBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <!-- Global Slider Styling - Use dynamic accent color -->
    <!-- The Foreground controls the filled track portion -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <!-- Target the thumb in horizontal sliders -->
    <Style Selector="Slider:horizontal /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Slider:horizontal:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <!-- Target the thumb in vertical sliders -->
    <Style Selector="Slider:vertical /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Slider:vertical:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>

    <!-- Transaction Row Highlight Style with fade animation -->
    <Style Selector="Border.highlighted-row">
        <Setter Property="Background" Value="{DynamicResource SelectionHoverBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:3" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{StaticResource HighlightAnimationColor}" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="Transparent" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Form TextBox Input -->
    <Style Selector="TextBox.form-input">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}" />
    </Style>
    <Style Selector="TextBox.form-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- Form ComboBox -->
    <Style Selector="ComboBox.form-combobox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}" />
    </Style>

    <!-- form-combobox applied to a Button (e.g. the category icon "Choose..." picker). The selector
         above only matches ComboBox, so such a Button fell back to the default (gray) button. Give it
         the same surface/border form-control look, including hover, so it fits the light theme. -->
    <Style Selector="Button.form-combobox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}" />
    </Style>
    <Style Selector="Button.form-combobox /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.form-combobox:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>
    <Style Selector="Button.form-combobox:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
    </Style>

    <!-- Form DatePicker -->
    <Style Selector="DatePicker.form-datepicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="DatePicker.form-datepicker /template/ Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="DatePicker.form-datepicker /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="DatePicker.form-datepicker /template/ Button TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Compact Form TextBox Input (for line items) -->
    <Style Selector="TextBox.form-input-compact">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeightCompact}" />
    </Style>
    <Style Selector="TextBox.form-input-compact /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.form-input-compact:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- Standard Form NumericUpDown (matches form-input class naming) -->
    <Style Selector="NumericUpDown.form-input">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}" />
    </Style>

    <!-- Compact Form NumericUpDown (for line items) -->
    <Style Selector="NumericUpDown.form-input-compact">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FormControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource FormControlHeightCompact}" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Argo Books Card Styles
        Styles for cards, panels, and container components.
    -->

    <!-- Stat Card (for dashboard stats) -->
    <Style Selector="Border.stat-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinWidth" Value="200" />
    </Style>

    <!-- Settings panels. The settings modal had one grey rectangle doing four unrelated jobs: an item in a list, the state of a connection, an empty list, and a row of toggles. -->

    <!-- ONE OBJECT you own and can act on: a key, a paired device, a rule.
         Filled and borderless. This is the only role the plain grey card keeps. -->
    <Style Selector="Border.item-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- THE STATE OF ONE THING, not an item in a list: a connected integration, a password that is or is not set. -->
    <Style Selector="Border.status-panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.status-panel.on">
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- NOTHING HERE YET. Outlined rather than filled, because a filled box reads as an item and an empty list that looks like its own first entry is exactly the confusion worth removing. -->
    <Style Selector="Border.empty-state">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="16,18" />
    </Style>

    <Style Selector="Border.empty-state TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- A LIST OF SETTINGS. Hairline-separated rows sitting straight on the modal. -->
    <Style Selector="Border.settings-group">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Border.settings-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,16,16,16" />
    </Style>

    <!-- The last row in a group has nothing under it to be separated from. -->
    <Style Selector="Border.settings-row.last">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- No On or Off caption: the switch draws its own inside an Auto column, and a wider "Off" would slide the knob as it toggled. -->
    <Style Selector="Border.settings-row ToggleSwitch, ToggleSwitch.settings-switch">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
    </Style>

</Styles>

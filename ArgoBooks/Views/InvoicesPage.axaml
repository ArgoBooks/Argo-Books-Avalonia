<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:local="using:ArgoBooks.Converters"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:table="using:ArgoBooks.Controls.ArgoTable"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ArgoBooks.Views.InvoicesPage"
             x:DataType="vm:InvoicesPageViewModel">

    <Design.DataContext>
        <vm:InvoicesPageViewModel />
    </Design.DataContext>

    <Panel>
    <Grid RowDefinitions="Auto,*">
        <!-- Tab Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        Margin="0"
                        Classes="page-tabs">
                <TabItem Header="{loc:Loc 'All Invoices'}" />
                <TabItem Header="{loc:Loc Drafts}" />
                <TabItem Header="Sent" />
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="Recurring" VerticalAlignment="Center" />
                            <!-- Count of recurring drafts waiting to be sent -->
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center"
                                    IsVisible="{Binding HasPendingRecurring}">
                                <TextBlock Text="{Binding PendingRecurringCount}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="24">
            <!-- Statistics Cards Row -->
            <controls:StatCardsRow Grid.Row="0" Margin="0,0,0,24">
                <controls:StatCard Label="{loc:Loc 'Total Outstanding'}"
                                   Value="{Binding TotalOutstanding}"
                                   Icon="{x:Static icons:Icons.Invoices}"
                                   IconColor="Primary" />
                <controls:StatCard Label="{loc:Loc 'Paid This Month'}"
                                   Value="{Binding PaidThisMonth}"
                                   Icon="{x:Static icons:Icons.CircleCheck}"
                                   IconColor="Success" />
                <controls:StatCard Label="{loc:Loc Overdue}"
                                   Value="{Binding OverdueAmount}"
                                   Icon="{x:Static icons:Icons.Info}"
                                   IconColor="Danger" />
                <controls:StatCard Label="{loc:Loc 'Due This Week'}"
                                   Value="{Binding DueThisWeekCount}"
                                   Icon="{x:Static icons:Icons.Clock}"
                                   IconColor="Info" />
            </controls:StatCardsRow>

            <!-- Payment Portal -->
            <StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,24">
                <!-- Portal Status Card -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16,12"
                        IsVisible="{Binding IsPortalConfigured}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Portal Icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource PrimaryIconBgBrush}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <PathIcon Data="{x:Static icons:Icons.Globe}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource PrimaryBrush}" />
                        </Border>

                        <!-- Portal Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Loc 'Payment Portal'}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <!-- Connected badge -->
                                <Border Background="{DynamicResource SuccessIconBgBrush}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsPortalConnected}">
                                    <TextBlock Text="{loc:Loc 'Connected'}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <!-- Disconnected badge -->
                                <Border Background="{DynamicResource WarningIconBgBrush}"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsPortalConnected}">
                                    <TextBlock Text="{loc:Loc 'Disconnected'}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{x:Static icons:Icons.Clock}"
                                              Width="14" Height="14"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding LastSyncTime, StringFormat='Last synced: {0}'}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <!-- Online received this month -->
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding IsPortalConnected}">
                                    <PathIcon Data="{x:Static icons:Icons.Payments}"
                                              Width="14" Height="14"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding OnlineReceivedThisMonth, StringFormat='Online this month: {0}'}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Portal Actions -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary-button"
                                    Command="{Binding OpenPortalSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static icons:Icons.Settings}"
                                              Width="16" Height="16" />
                                    <TextBlock Text="{loc:Loc Configure}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary-button"
                                    Command="{Binding SyncPortalCommand}"
                                    IsEnabled="{Binding IsPortalConnected}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes.sync-spinning="{Binding IsSyncing}"
                                              Data="{x:Static icons:Icons.Refresh}"
                                              Width="16" Height="16"
                                              RenderTransformOrigin="50%,50%">
                                        <PathIcon.RenderTransform>
                                            <RotateTransform />
                                        </PathIcon.RenderTransform>
                                    </PathIcon>
                                    <TextBlock Text="{loc:Loc 'Sync now'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Not Configured Card (shown when portal API key is missing) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16,12"
                        IsVisible="{Binding !IsPortalConfigured}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <PathIcon Data="{x:Static icons:Icons.Globe}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{loc:Loc 'Payment Portal'}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc 'Enable the payment portal to let customers pay invoices online via Stripe or Square.'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="primary-button"
                                Command="{Binding OpenPortalSettingsCommand}"
                                VerticalAlignment="Center"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Settings}"
                                          Width="16" Height="16"
                                          Foreground="White" />
                                <TextBlock Text="{loc:Loc Configure}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- Main Content Card using ArgoTable -->
            <table:ArgoTable Grid.Row="2"
                                IsVisible="{Binding !IsRecurringTab}"
                                Title="{loc:Loc Invoices}"
                                ItemsSource="{Binding Invoices}"
                                SearchQuery="{Binding SearchQuery, Mode=TwoWay}"
                                SearchPlaceholder="{loc:Loc 'Search invoices...'}"
                                FilterCommand="{Binding OpenFilterModalCommand}"
                                FilterCount="{Binding ActiveFilterCount}"
                                ClearFiltersCommand="{Binding ClearTableFiltersCommand}"
                                AddCommand="{Binding OpenCreateModalCommand}"
                                AddButtonText="{loc:Loc 'Create Invoice'}"
                                AddButtonTooltip="{loc:Loc 'Create Invoice'}"
                                ColumnWidthsManager="{Binding ColumnWidths}"
                                CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                TotalPages="{Binding TotalPages}"
                                PageSize="{Binding PageSize, Mode=TwoWay}"
                                PaginationText="{Binding PaginationText}"
                                GoToPageCommand="{Binding GoToPageCommand}"
                                GoToPreviousPageCommand="{Binding GoToPreviousPageCommand}"
                                GoToNextPageCommand="{Binding GoToNextPageCommand}"
                                ToggleColumnMenuCommand="{Binding ToggleColumnMenuCommand}"
                                EmptyIcon="{x:Static icons:Icons.Invoices}"
                                EmptyTitle="{Binding EmptyStateTitle}"
                                EmptyMessage="{Binding EmptyStateMessage}"
                                ShowHeaderBorder="{Binding IsPortalConfigured}">

                <!-- Info Banners (portal warning + invoice limit) -->
                <table:ArgoTable.InfoBannerContent>
                    <StackPanel>
                        <!-- Recurring invoices generated on open -->
                        <Border IsVisible="{Binding HasGeneratedBanner}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,8,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <PathIcon Grid.Column="0"
                                          Data="{x:Static icons:Icons.Clock}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource PrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GeneratedBannerText}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Grid.Column="2"
                                        Classes="secondary-button"
                                        Padding="10,4"
                                        Content="Review"
                                        Command="{Binding ReviewGeneratedCommand}"
                                        Margin="8,0,6,0" />
                                <Button Grid.Column="3"
                                        Classes="secondary-button"
                                        Padding="10,4"
                                        Content="Dismiss"
                                        Command="{Binding DismissGeneratedBannerCommand}" />
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Center"
                                Background="{DynamicResource WarningLightBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                Margin="0,8,0,8"
                                IsVisible="{Binding ShowRemainingInvoices}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{x:Static icons:Icons.WarningCircle}"
                                          Foreground="{DynamicResource WarningBrush}"
                                          Width="14" Height="14"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RemainingInvoicesText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !ShowInvoiceUpgradeButton}" />
                                <TextBlock Text="{loc:Loc 'Invoice limit reached. Upgrade for unlimited invoices'}"
                                           FontSize="13"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding ShowInvoiceUpgradeButton}" />
                                <Button Command="{Binding UpgradeCommand}"
                                        Classes="primary-button"
                                        Padding="12,4"
                                        IsVisible="{Binding ShowInvoiceUpgradeButton}">
                                    <TextBlock Text="{loc:Loc 'Upgrade Now'}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button Command="{Binding UpgradeCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        IsVisible="{Binding !ShowInvoiceUpgradeButton}">
                                    <TextBlock Text="{loc:Loc Upgrade}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </table:ArgoTable.InfoBannerContent>

                <!-- Extra Buttons Content (Template Designer) -->
                <table:ArgoTable.ExtraButtonsContent>
                    <Button Classes="secondary-button"
                            Classes.compact="{Binding $parent[table:ArgoTable].IsCompactMode}"
                            Classes.medium="{Binding $parent[table:ArgoTable].IsMediumMode}"
                            Command="{Binding OpenTemplateDesignerCommand}"
                            ToolTip.Tip="{loc:Loc 'Invoice Templates'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:Icons.DocumentList}"
                                      Width="16" Height="16" />
                            <TextBlock Text="{loc:Loc Templates}"
                                       IsVisible="{Binding $parent[table:ArgoTable].ShowButtonText}" />
                        </StackPanel>
                    </Button>
                </table:ArgoTable.ExtraButtonsContent>

                <!-- Table Header Content - Using ArgoTableHeader for reduced boilerplate -->
                <table:ArgoTable.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <table:ArgoTableHeader Header="{loc:Loc 'Invoice'}" ColumnName="Id" SortProperty="Id"
                                                   ColumnWidth="{Binding ColumnWidths.IdColumnWidth}"
                                                   IsColumnVisible="{Binding ShowIdColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Customer}" ColumnName="Customer" SortProperty="Customer"
                                                   ColumnWidth="{Binding ColumnWidths.CustomerColumnWidth}"
                                                   IsColumnVisible="{Binding ShowCustomerColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc 'Issue Date'}" ColumnName="IssueDate" SortProperty="IssueDate"
                                                   ColumnWidth="{Binding ColumnWidths.IssueDateColumnWidth}"
                                                   IsColumnVisible="{Binding ShowIssueDateColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc 'Due Date'}" ColumnName="DueDate" SortProperty="DueDate"
                                                   ColumnWidth="{Binding ColumnWidths.DueDateColumnWidth}"
                                                   IsColumnVisible="{Binding ShowDueDateColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Amount}" ColumnName="Amount" SortProperty="Amount"
                                                   ColumnWidth="{Binding ColumnWidths.AmountColumnWidth}"
                                                   IsColumnVisible="{Binding ShowAmountColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Status}" ColumnName="Status" SortProperty="Status"
                                                   ColumnWidth="{Binding ColumnWidths.StatusColumnWidth}"
                                                   IsColumnVisible="{Binding ShowStatusColumn}"
                                                   SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                                   SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Actions}" ColumnName="Actions"
                                                   ColumnWidth="{Binding ColumnWidths.ActionsColumnWidth}"
                                                   IsSortable="False" IsResizable="False" ShowSeparator="False" />
                    </StackPanel>
                </table:ArgoTable.HeaderContent>

                <!-- Table Rows Content - Using ArgoTableCell for reduced boilerplate -->
                <table:ArgoTable.RowsContent>
                    <ItemsControl Classes="table-rows" ItemsSource="{Binding Invoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:InvoiceDisplayItem">
                                <Border Padding="24,0,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Classes.highlighted-row="{Binding IsHighlighted}"
                                        MinHeight="56">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Invoice # -->
                                        <table:ArgoTableCell Text="{Binding Id}"
                                                                 ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.IdColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowIdColumn}"
                                                                 FontWeight="Medium" />

                                        <!-- Customer with Avatar - Custom content required -->
                                        <table:ArgoTableCell ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.CustomerColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowCustomerColumn}">
                                            <table:ArgoTableCell.CellContent>
                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"
                                                            ClipToBounds="True">
                                                        <Panel>
                                                            <TextBlock Text="{Binding CustomerInitials}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding !HasCustomerAvatar}" />
                                                            <Image Source="{Binding CustomerAvatarBitmap}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasCustomerAvatar}" />
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </table:ArgoTableCell.CellContent>
                                        </table:ArgoTableCell>

                                        <!-- Issue Date -->
                                        <table:ArgoTableCell Text="{Binding IssueDateFormatted}"
                                                                 ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.IssueDateColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowIssueDateColumn}" />

                                        <!-- Due Date -->
                                        <table:ArgoTableCell Text="{Binding DueDateFormatted}"
                                                                 ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.DueDateColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowDueDateColumn}" />

                                        <!-- Amount -->
                                        <table:ArgoTableCell Text="{Binding TotalFormatted}"
                                                                 ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.AmountColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowAmountColumn}"
                                                                 FontWeight="Medium" />

                                        <!-- Status Badge - Custom content required -->
                                        <table:ArgoTableCell ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.StatusColumnWidth}"
                                                                 IsColumnVisible="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ShowStatusColumn}">
                                            <table:ArgoTableCell.CellContent>
                                                <Border VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Padding="8,4"
                                                        CornerRadius="4"
                                                        Background="{Binding StatusDisplay, Converter={x:Static local:StatusConverters.InvoiceStatusBackground}}">
                                                    <TextBlock Text="{Binding StatusDisplay, Converter={StaticResource TranslateConverter}}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{Binding StatusDisplay, Converter={x:Static local:StatusConverters.InvoiceStatusForeground}}" />
                                                </Border>
                                            </table:ArgoTableCell.CellContent>
                                        </table:ArgoTableCell>

                                        <!-- Actions - Custom content required -->
                                        <table:ArgoTableCell ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ColumnWidths.ActionsColumnWidth}"
                                                                 ShowSeparator="False">
                                            <table:ArgoTableCell.CellContent>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Spacing="4">
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'View Invoice'}"
                                                            AutomationProperties.Name="View Invoice"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ViewInvoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Eye}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc Continue}"
                                                            AutomationProperties.Name="Continue"
                                                            IsVisible="{Binding IsDraft}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ContinueDraftInvoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Play}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'Record Payment'}"
                                                            AutomationProperties.Name="Record Payment"
                                                            IsVisible="{Binding CanSend}"
                                                            IsEnabled="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).CanResendInvoice}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecordPaymentCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Payments}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'Resend Invoice'}"
                                                            AutomationProperties.Name="Resend Invoice"
                                                            IsVisible="{Binding CanSend}"
                                                            IsEnabled="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).CanResendInvoice}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ResendInvoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Send}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'View History'}"
                                                            AutomationProperties.Name="View History"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).OpenHistoryModalCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.History}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'Refund'}"
                                                            AutomationProperties.Name="Refund"
                                                            IsVisible="{Binding CanRefund}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).OpenRefundModalCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Returns}"
                                                                  Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </table:ArgoTableCell.CellContent>
                                        </table:ArgoTableCell>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </table:ArgoTable.RowsContent>
            </table:ArgoTable>

            <!-- Recurring tab: "Waiting to send" list above the schedules table -->
            <Grid Grid.Row="2" IsVisible="{Binding IsRecurringTab}" RowDefinitions="Auto,*" RowSpacing="16">

                <!-- Recurring drafts waiting to be sent (only shown when there are any). ClipToBounds so a
                     row's square hover highlight can't overflow the card's rounded bottom corners. -->
                <Border Grid.Row="0" IsVisible="{Binding HasPendingRecurring}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="20,16,20,8">
                            <TextBlock Grid.Column="0" Text="Waiting to send"
                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding PendingRecurringCount, StringFormat='{}{0} to send'}" />
                        </Grid>
                        <!-- Column headers -->
                        <Grid ColumnDefinitions="1.4*,2*,1.2*,Auto" Margin="20,0,20,6">
                            <TextBlock Grid.Column="0" Text="INVOICE #" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="CUSTOMER" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="3" Text="STATUS" Width="150" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                        <!-- table-rows gives the app's standard virtualized rows (VirtualizingStackPanel +
                             its own scroll); MaxHeight caps the card so a long list scrolls, not grows. -->
                        <ItemsControl Classes="table-rows" MaxHeight="320" ItemsSource="{Binding PendingRecurringInvoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:InvoiceDisplayItem">
                                        <!-- Whole row is clickable: opens the draft in the editor/preview so it can be sent. -->
                                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                CornerRadius="0" Padding="20,12"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                ToolTip.Tip="Open to review and send"
                                                Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ContinueDraftInvoiceCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="1.4*,2*,1.2*,Auto" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CustomerName}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalFormatted}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border Grid.Column="3" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <PathIcon Data="{x:Static icons:Icons.Send}" Width="12" Height="12" Foreground="{DynamicResource WarningTextBrush}" />
                                                            <TextBlock Text="Needs to be sent" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WarningTextBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recurring schedules -->
                <table:ArgoTable Grid.Row="1"
                                 Title="Recurring invoices"
                             ItemsSource="{Binding Schedules}"
                             ShowSearch="False"
                             ShowFilterButton="False"
                             CurrentPage="{Binding ScheduleCurrentPage, Mode=TwoWay}"
                             TotalPages="{Binding ScheduleTotalPages}"
                             PageSize="{Binding SchedulePageSize, Mode=TwoWay}"
                             PaginationText="{Binding SchedulePaginationText}"
                             GoToPageCommand="{Binding ScheduleGoToPageCommand}"
                             GoToPreviousPageCommand="{Binding ScheduleGoToPreviousPageCommand}"
                             GoToNextPageCommand="{Binding ScheduleGoToNextPageCommand}"
                             AddCommand="{Binding NewRecurringInvoiceCommand}"
                             AddButtonText="New recurring invoice"
                             AddButtonTooltip="New recurring invoice"
                             EmptyIcon="{x:Static icons:Icons.Refresh}"
                             EmptyTitle="No recurring invoices yet"
                             EmptyMessage="Create an invoice and turn on Repeat this invoice."
                             ColumnWidthsManager="{Binding RecurringColumnWidths}">

                <!-- Column headers - widths driven by RecurringColumnWidths so they redistribute on resize -->
                <table:ArgoTable.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <table:ArgoTableHeader Header="Customer" ColumnName="Customer" IsSortable="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.CustomerColumnWidth}"
                                               ColumnWidths="{Binding RecurringColumnWidths}" />
                        <table:ArgoTableHeader Header="Amount" ColumnName="Amount" IsSortable="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.AmountColumnWidth}"
                                               ColumnWidths="{Binding RecurringColumnWidths}" />
                        <table:ArgoTableHeader Header="Frequency" ColumnName="Frequency" IsSortable="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.FrequencyColumnWidth}"
                                               ColumnWidths="{Binding RecurringColumnWidths}" />
                        <table:ArgoTableHeader Header="Next Invoice" ColumnName="NextInvoice" IsSortable="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.NextInvoiceColumnWidth}"
                                               ColumnWidths="{Binding RecurringColumnWidths}" />
                        <table:ArgoTableHeader Header="Status" ColumnName="Status" IsSortable="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.StatusColumnWidth}"
                                               ColumnWidths="{Binding RecurringColumnWidths}" />
                        <table:ArgoTableHeader Header="Actions" ColumnName="Actions" IsSortable="False"
                                               IsResizable="False" ShowSeparator="False"
                                               ColumnWidth="{Binding RecurringColumnWidths.ActionsColumnWidth}" />
                    </StackPanel>
                </table:ArgoTable.HeaderContent>

                <!-- Rows -->
                <table:ArgoTable.RowsContent>
                    <ItemsControl Classes="table-rows" ItemsSource="{Binding Schedules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RecurringScheduleDisplayItem">
                                <Border Padding="24,0,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        MinHeight="56">
                                    <StackPanel Orientation="Horizontal">
                                        <table:ArgoTableCell Text="{Binding CustomerName}" FontWeight="Medium"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.CustomerColumnWidth}" />
                                        <table:ArgoTableCell Text="{Binding AmountFormatted}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.AmountColumnWidth}" />
                                        <table:ArgoTableCell Text="{Binding FrequencyDisplay}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.FrequencyColumnWidth}" />
                                        <table:ArgoTableCell Text="{Binding NextInvoiceFormatted}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.NextInvoiceColumnWidth}" />
                                        <table:ArgoTableCell Text="{Binding StatusDisplay}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.StatusColumnWidth}" />
                                        <table:ArgoTableCell ShowSeparator="False"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).RecurringColumnWidths.ActionsColumnWidth}">
                                            <table:ArgoTableCell.CellContent>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Spacing="4">
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc 'View Invoice'}"
                                                            AutomationProperties.Name="View Invoice"
                                                            IsVisible="{Binding HasInvoice}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).ViewScheduleInvoiceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Eye}" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="Pause"
                                                            IsVisible="{Binding !IsPaused}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).PauseResumeScheduleCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Pause}" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="Resume"
                                                            IsVisible="{Binding IsPaused}"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).PauseResumeScheduleCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Play}" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button"
                                                            ToolTip.Tip="{loc:Loc Delete}"
                                                            AutomationProperties.Name="Delete"
                                                            Command="{Binding $parent[ItemsControl].((vm:InvoicesPageViewModel)DataContext).DeleteScheduleCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Delete}" Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </table:ArgoTableCell.CellContent>
                                        </table:ArgoTableCell>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </table:ArgoTable.RowsContent>
            </table:ArgoTable>
            </Grid>
        </Grid>
    </Grid>

    <!-- Column Visibility Menu -->
    <controls:ColumnVisibilityMenu IsOpen="{Binding IsColumnMenuOpen}"
                                    MenuX="{Binding ColumnWidths.ColumnMenuX}"
                                    MenuY="{Binding ColumnWidths.ColumnMenuY}"
                                    CloseCommand="{Binding CloseColumnMenuCommand}"
                                    ResetCommand="{Binding ResetColumnVisibilityCommand}">
        <controls:ColumnVisibilityMenu.ColumnsContent>
            <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding ShowIdColumn}" Content="{loc:Loc 'Invoice'}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowCustomerColumn}" Content="{loc:Loc Customer}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowIssueDateColumn}" Content="{loc:Loc 'Issue Date'}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowDueDateColumn}" Content="{loc:Loc 'Due Date'}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowAmountColumn}" Content="{loc:Loc Amount}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowStatusColumn}" Content="{loc:Loc Status}" Classes="column-toggle" />
            </StackPanel>
        </controls:ColumnVisibilityMenu.ColumnsContent>
    </controls:ColumnVisibilityMenu>
    </Panel>

</UserControl>

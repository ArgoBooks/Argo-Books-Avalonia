<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:icons="using:ArgoBooks"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:table="using:ArgoBooks.Controls.ArgoTable"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ArgoBooks.Views.PayRunsPage"
             x:DataType="vm:PayRunsPageViewModel">

    <Design.DataContext>
        <vm:PayRunsPageViewModel />
    </Design.DataContext>

    <Panel>
    <!-- Frozen and blurred behind the upgrade teaser, so the shape of a filled-in payroll shows
         through but nothing on the page can be read, clicked, sorted or searched.
         The blur itself is applied in code-behind, since Effect is not settable from a binding. -->
    <Grid x:Name="ContentRoot" RowDefinitions="*" IsHitTestVisible="{Binding !ShowTeaser}">
        <Grid Grid.Row="0" RowDefinitions="Auto,*" Margin="24">

            <controls:StatCardsRow Grid.Row="0" Margin="0,0,0,24">
                <controls:StatCard Label="{loc:Loc 'Pay runs this year'}"
                                   Value="{Binding ApprovedCount}"
                                   Icon="{x:Static icons:Icons.Payments}"
                                   IconColor="Primary" />
                <controls:StatCard Label="{loc:Loc 'Gross paid this year'}"
                                   Value="{Binding YearToDateGross}"
                                   Icon="{x:Static icons:Icons.Dollar}"
                                   IconColor="Success" />
                <!-- What was owed for the year so far, employee and employer sides together, to
                     CRA and Revenu Quebec combined. The Payroll Remittance report breaks it down
                     by period and by agency. -->
                <controls:StatCard Label="{loc:Loc 'Remittance this year'}"
                                   Value="{Binding YearToDateRemittance}"
                                   Icon="{x:Static icons:Icons.BarChart}"
                                   IconColor="Warning" />
                <!-- The one figure here that is an instruction rather than a total: the amount to
                     send and the day to send it by. The card cannot know whether it has been
                     paid, so it shows the deadline rather than pretending to be a to-do. -->
                <controls:StatCard Label="{Binding RemittanceDueLabel}"
                                   Value="{Binding RemittanceDue}"
                                   SecondaryText="{Binding RemittanceDueQuebec}"
                                   Icon="{x:Static icons:Icons.Calendar}"
                                   IconColor="Danger"
                                   ToolTip.Tip="{Binding RemittanceScheduleHint}" />
            </controls:StatCardsRow>

            <table:ArgoTable Grid.Row="1"
                             Title="{loc:Loc 'Pay runs'}"
                             ItemsSource="{Binding PayRuns}"
                             SearchQuery="{Binding SearchQuery, Mode=TwoWay}"
                             SearchPlaceholder="{loc:Loc 'Search pay runs...'}"
                             SearchBoxWidth="{Binding ResponsiveHeader.SearchBoxWidth}"
                             SearchBoxMinHeight="{Binding ResponsiveHeader.SearchBoxMinHeight}"
                             SearchIconMargin="{Binding ResponsiveHeader.SearchIconMargin}"
                             HeaderPadding="{Binding ResponsiveHeader.HeaderPadding}"
                             HeaderSpacing="{Binding ResponsiveHeader.HeaderSpacing}"
                             IsCompactMode="{Binding ResponsiveHeader.IsCompactMode}"
                             IsMediumMode="{Binding ResponsiveHeader.IsMediumMode}"
                             ShowButtonText="{Binding ResponsiveHeader.ShowButtonText}"
                             ShowFilterButton="False"
                             ShowAddButton="{Binding HasPremium}"
                             AddCommand="{Binding RunPayrollCommand}"
                             AddButtonText="{loc:Loc 'Run payroll'}"
                             AddButtonTooltip="{loc:Loc 'Run payroll'}"
                             ColumnWidthsManager="{Binding ColumnWidths}"
                             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                             TotalPages="{Binding TotalPages}"
                             PageSize="{Binding PageSize, Mode=TwoWay}"
                             PaginationText="{Binding PaginationText}"
                             GoToPageCommand="{Binding GoToPageCommand}"
                             GoToPreviousPageCommand="{Binding GoToPreviousPageCommand}"
                             GoToNextPageCommand="{Binding GoToNextPageCommand}"
                             ToggleColumnMenuCommand="{Binding ToggleColumnMenuCommand}"
                             EmptyIcon="{x:Static icons:Icons.Payments}"
                             EmptyTitle="{loc:Loc 'No pay runs yet'}"
                             EmptyMessage="{loc:Loc 'Run payroll to work out deductions, produce pay stubs and record the wages.'}"
                             BorderSizeChanged="OnHeaderSizeChanged"
                             TableGridSizeChanged="OnTableSizeChanged">

                <table:ArgoTable.ExtraButtonsContent>
                    <Button Classes="secondary-button"
                            Content="{loc:Loc 'Year end'}"
                            ToolTip.Tip="{loc:Loc 'T4 slips and the file CRA needs'}"
                            Command="{Binding OpenYearEndCommand}" />
                </table:ArgoTable.ExtraButtonsContent>

                <!-- Only for a lapsed subscriber, who keeps a usable page because their real runs
                     and their T4s are still here. A free user who has never run payroll gets the
                     teaser overlay instead. -->
                <table:ArgoTable.InfoBannerContent>
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            Padding="24,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding ShowPayrollUpgradePrompt}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc 'Payroll is a premium feature'}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc 'Work out CPP, EI and tax, produce pay stubs, and record the wages in your books.'}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary-button" VerticalAlignment="Center"
                                    Content="{loc:Loc Upgrade}"
                                    Command="{Binding UpgradeCommand}" />
                        </Grid>
                    </Border>
                </table:ArgoTable.InfoBannerContent>

                <table:ArgoTable.HeaderContent>
                    <StackPanel Orientation="Horizontal">
                        <table:ArgoTableHeader Header="{loc:Loc 'Pay date'}" ColumnName="PayDate" SortProperty="PayDate"
                                               ColumnWidth="{Binding ColumnWidths.PayDateColumnWidth}"
                                               IsColumnVisible="{Binding ShowPayDateColumn}"
                                               SortColumn="{Binding SortColumn}" SortDirection="{Binding SortDirection}"
                                               SortCommand="{Binding SortByCommand}" ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Period}" ColumnName="Period" IsSortable="False"
                                               ColumnWidth="{Binding ColumnWidths.PeriodColumnWidth}"
                                               IsColumnVisible="{Binding ShowPeriodColumn}"
                                               ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Employees}" ColumnName="Employees" IsSortable="False"
                                               ColumnWidth="{Binding ColumnWidths.EmployeesColumnWidth}"
                                               IsColumnVisible="{Binding ShowEmployeesColumn}"
                                               ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Gross}" ColumnName="Gross" IsSortable="False"
                                               ColumnWidth="{Binding ColumnWidths.GrossColumnWidth}"
                                               IsColumnVisible="{Binding ShowGrossColumn}"
                                               ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Net}" ColumnName="Net" IsSortable="False"
                                               ColumnWidth="{Binding ColumnWidths.NetColumnWidth}"
                                               IsColumnVisible="{Binding ShowNetColumn}"
                                               ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Status}" ColumnName="Status" IsSortable="False"
                                               ColumnWidth="{Binding ColumnWidths.StatusColumnWidth}"
                                               IsColumnVisible="{Binding ShowStatusColumn}"
                                               ColumnWidths="{Binding ColumnWidths}" />

                        <table:ArgoTableHeader Header="{loc:Loc Actions}" ColumnName="Actions"
                                               ColumnWidth="{Binding ColumnWidths.ActionsColumnWidth}"
                                               IsSortable="False" IsResizable="False" ShowSeparator="False" />
                    </StackPanel>
                </table:ArgoTable.HeaderContent>

                <table:ArgoTable.RowsContent>
                    <ItemsControl Classes="table-rows" ItemsSource="{Binding PayRuns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PayRunDisplayItem">
                                <Border Padding="24,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        MinHeight="52">
                                    <StackPanel Orientation="Horizontal">
                                        <table:ArgoTableCell Text="{Binding PayDate}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.PayDateColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowPayDateColumn}" />

                                        <table:ArgoTableCell Text="{Binding Period}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.PeriodColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowPeriodColumn}" />

                                        <table:ArgoTableCell Text="{Binding Employees}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.EmployeesColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowEmployeesColumn}" />

                                        <table:ArgoTableCell Text="{Binding Gross}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.GrossColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowGrossColumn}" />

                                        <table:ArgoTableCell Text="{Binding Net}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.NetColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowNetColumn}" />

                                        <table:ArgoTableCell Text="{Binding Status, Converter={StaticResource TranslateConverter}}"
                                                             ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.StatusColumnWidth}"
                                                             IsColumnVisible="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ShowStatusColumn}" />

                                        <table:ArgoTableCell ColumnWidth="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ColumnWidths.ActionsColumnWidth}"
                                                             ShowSeparator="False">
                                            <table:ArgoTableCell.CellContent>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                                                    <!-- View shows one document covering everyone, for
                                                         checking. Download writes one file per person,
                                                         to hand to that person. Different outputs, so
                                                         both buttons earn their place. -->
                                                    <Button Classes="icon-button" ToolTip.Tip="{loc:Loc 'View pay stubs'}"
                                                            IsEnabled="{Binding IsApproved}"
                                                            Command="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).ViewStubsCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Reports}" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="icon-button" ToolTip.Tip="{loc:Loc 'Download pay stubs, one file per employee'}"
                                                            IsEnabled="{Binding IsApproved}"
                                                            Command="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).DownloadStubsCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Download}" Width="16" Height="16" />
                                                    </Button>
                                                    <!-- Void writes a reversing run rather than deleting: a stub may
                                                         already be in someone's hands. -->
                                                    <Button Classes="icon-button" ToolTip.Tip="{loc:Loc 'Void'}"
                                                            IsEnabled="{Binding IsApproved}"
                                                            Command="{Binding $parent[ItemsControl].((vm:PayRunsPageViewModel)DataContext).VoidRunCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{x:Static icons:Icons.Close}" Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </table:ArgoTableCell.CellContent>
                                        </table:ArgoTableCell>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </table:ArgoTable.RowsContent>
            </table:ArgoTable>
        </Grid>
    </Grid>

    <controls:ColumnVisibilityMenu IsOpen="{Binding IsColumnMenuOpen}"
                                   MenuX="{Binding ColumnWidths.ColumnMenuX}"
                                   MenuY="{Binding ColumnWidths.ColumnMenuY}"
                                   CloseCommand="{Binding CloseColumnMenuCommand}"
                                   ResetCommand="{Binding ResetColumnVisibilityCommand}">
        <controls:ColumnVisibilityMenu.ColumnsContent>
            <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding ShowPayDateColumn}" Content="{loc:Loc 'Pay date'}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowPeriodColumn}" Content="{loc:Loc Period}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowEmployeesColumn}" Content="{loc:Loc Employees}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowGrossColumn}" Content="{loc:Loc Gross}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowNetColumn}" Content="{loc:Loc Net}" Classes="column-toggle" />
                <CheckBox IsChecked="{Binding ShowStatusColumn}" Content="{loc:Loc Status}" Classes="column-toggle" />
            </StackPanel>
        </controls:ColumnVisibilityMenu.ColumnsContent>
    </controls:ColumnVisibilityMenu>

    <!-- Premium teaser overlay, matching the Insights page: the content behind is blurred and
         darkened by a scrim, with one card over it saying what the money buys. -->
    <Panel IsVisible="{Binding ShowTeaser}">
        <Border Background="#20000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="16"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="420"
                MaxWidth="500"
                BoxShadow="0 8 32 0 #40000000">
            <StackPanel Spacing="20" HorizontalAlignment="Center">
                <Border Width="64" Height="64"
                        CornerRadius="32"
                        Background="{DynamicResource PrimaryLightBrush}"
                        HorizontalAlignment="Center">
                    <PathIcon Data="{x:Static icons:Icons.Payments}"
                              Width="28" Height="28"
                              Foreground="{DynamicResource PrimaryBrush}" />
                </Border>

                <TextBlock Text="{loc:Loc 'Unlock Canadian Payroll'}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{x:Static icons:Icons.Check}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{loc:Loc 'CPP, EI and income tax worked out for you'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{x:Static icons:Icons.Check}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{loc:Loc 'Pay stubs ready to hand out'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{x:Static icons:Icons.Check}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{loc:Loc 'Wages recorded in your books automatically'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{x:Static icons:Icons.Check}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{loc:Loc 'T4 slips and the year end file for CRA'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Says plainly that the figures behind the card are not the owner's, since a
                     page of wages is the last place to leave that ambiguous. -->
                <TextBlock Text="{loc:Loc 'The figures behind this card are samples.'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <Button Classes="primary-button"
                        HorizontalAlignment="Center"
                        Padding="32,12"
                        Command="{Binding UpgradeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static icons:Icons.Star}"
                                  Width="16" Height="16" />
                        <TextBlock Text="{loc:Loc 'Upgrade to Premium'}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Panel>
    </Panel>

</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ArgoBooks.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="240"
        x:Class="ArgoBooks.Views.SplashWindow"
        Title="Argo Books"
        Icon="/Assets/argo-logo.png"
        Width="420"
        Height="240"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent">

    <!-- Depends on OnFrameworkInitializationCompleted applying the saved theme before this
         window is constructed. Move that later and this renders in the wrong palette. -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <Image Source="/Assets/argo-logo.png"
                   Width="64"
                   Height="64"
                   HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc 'Argo Books'}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <!-- Static text rather than an animated progress bar. The UI thread is fully
                 occupied building the service graph for the few seconds this is on screen, so
                 nothing here can animate. A frozen spinner reads as a hang; plain text does not. -->
            <TextBlock Text="{loc:Loc 'Starting...'}"
                       FontSize="13"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>

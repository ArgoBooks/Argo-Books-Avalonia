<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="400"
             x:Class="ArgoBooks.Panels.CompanySwitcherPanel"
             x:DataType="vm:CompanySwitcherPanelViewModel">

    <Design.DataContext>
        <vm:CompanySwitcherPanelViewModel />
    </Design.DataContext>

    <Panel IsVisible="{Binding IsOpen}">
        <!-- Transparent backdrop for click-away -->
        <Border Background="Transparent"
                PointerPressed="Backdrop_PointerPressed" />

        <!-- Company Switcher Panel with slide-in animation -->
        <Border x:Name="SwitcherBorder"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Width="340"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="15,70,0,0"
                BoxShadow="0 8 32 0 #40000000"
                Focusable="True"
                KeyDown="Panel_KeyDown"
                Opacity="0"
                RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <TranslateTransform Y="-8" />
            </Border.RenderTransform>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>

            <StackPanel>
                <!-- Header -->
                <Border Padding="16,16,16,12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{loc:Loc 'Switch company'}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <!-- The open company is a heading, not a row: there is nowhere to switch to here. -->
                <StackPanel Margin="8,12,8,0" Spacing="6">
                    <TextBlock Text="{loc:Loc 'CURRENTLY OPEN'}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <Border Classes="current-company-card"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <controls:CompanyAvatar Grid.Column="0"
                                                    Margin="0,0,12,0"
                                                    Width="40" Height="40"
                                                    CornerRadius="8"
                                                    FontSize="16"
                                                    Logo="{Binding CurrentCompanyLogo}"
                                                    Initial="{Binding CurrentCompanyInitial}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding CurrentCompanyName}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- The file, so two companies with similar names can be told apart -->
                                <TextBlock Text="{Binding CurrentCompanyPathDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding CurrentCompanyPath}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="edit-button-inline"
                                    Command="{Binding EditCompanyCommand}"
                                    ToolTip.Tip="{loc:Loc 'Edit Company'}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                                <PathIcon Data="{x:Static local:Icons.Edit}"
                                          Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Everything below is somewhere you can actually go -->
                <StackPanel Margin="8,16,8,0" Spacing="6">
                    <TextBlock Text="{loc:Loc 'SWITCH TO'}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <ItemsControl ItemsSource="{Binding FilteredRecentCompanies}"
                                  IsVisible="{Binding HasFilteredRecentCompanies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CompanyItem">
                                <Button Classes="company-item"
                                        Command="{Binding $parent[ItemsControl].((vm:CompanySwitcherPanelViewModel)DataContext).SwitchCompanyCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding FilePath}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <controls:CompanyAvatar Grid.Column="0"
                                                                Margin="0,0,12,0"
                                                                Width="36" Height="36"
                                                                CornerRadius="8"
                                                                FontSize="14"
                                                                Logo="{Binding Logo}"
                                                                Initial="{Binding Initial}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastOpenedDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>

                                        <PathIcon Grid.Column="2"
                                                  Data="{x:Static local:Icons.ChevronRight}"
                                                  Width="12" Height="12"
                                                  Margin="8,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Loc 'This is your only company. Open another file to switch between them.'}"
                               IsVisible="{Binding !HasFilteredRecentCompanies}"
                               Margin="8,4,8,8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- Divider -->
                <Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="16,12" />

                <!-- Creating a company lives in the File menu; this is only for one not in the list -->
                <StackPanel Margin="8,0,8,8">
                    <Button Classes="action-item"
                            Command="{Binding OpenCompanyCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Grid.Column="0"
                                      Data="{x:Static local:Icons.Folder}"
                                      Width="16" Height="16"
                                      Margin="10,0,12,0"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{loc:Loc 'Open another company file...'}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>

    <UserControl.Styles>
        <!-- Company Item Style -->
        <Style Selector="Button.company-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.company-item /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.company-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.company-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>

        <!-- Current Company Item (disabled but styled) -->
        <Style Selector="Button.company-item.current">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.company-item.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.company-item.current:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <!-- Action Item Style -->
        <Style Selector="Button.action-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.action-item /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.action-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.action-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>

        <!-- Current Company Card Style -->
        <Style Selector="Border.current-company-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Inline Edit Button Style (inside company card) -->
        <Style Selector="Button.edit-button-inline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.edit-button-inline /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.edit-button-inline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}" />
        </Style>
        <Style Selector="Button.edit-button-inline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>
        <Style Selector="Button.edit-button-inline PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
